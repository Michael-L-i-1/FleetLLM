new file mode 100644
index 0000000..3cf8afc
--- /dev/null
+++ b/packages/fleetpi/src/fleet/fleet-extension.ts
@@ -0,0 +1,65 @@
+// Enhanced-mode Pi extension: engine-aware admission around real provider requests and ledger re-injection.
+
+import type { ExtensionAPI, InlineExtension } from "@earendil-works/pi-coding-agent";
+import { LEDGER_MESSAGE_TYPE, type ProgressLedger } from "../ledger/progress-ledger.ts";
+import type { AdmissionPriority, AdmissionQueue, Permit } from "./admission-queue.ts";
+
+/** Host callbacks the extension needs for one agent. */
+export interface FleetExtensionOptions {
+	agentId: string;
+	queue: AdmissionQueue;
+	/** Benchmark runs supply the durable ledger; interactive sessions have none. */
+	ledger?: () => ProgressLedger;
+	/** Priority of the next request: repair/fresh for the first request of a task, continue after. */
+	priority: () => AdmissionPriority;
+	/** Called once a request has been granted, so the host can reset the priority to "continue". */
+	onGranted?: (permit: Permit) => void;
+	onLedgerInjected?: () => void;
+}
+
+/** The enhanced FleetPi extension. Baseline modes do not load it. */
+export function fleetExtension(options: FleetExtensionOptions): InlineExtension {
+	return {
+		name: "fleetpi-fleet",
+		factory: (pi: ExtensionAPI) => {
+			let permit: Permit | undefined;
+			const release = () => {
+				permit?.release();
+				permit = undefined;
+			};
+
+			// The context hook is awaited immediately before every model request of a turn, so the
+			// slot is held only while the engine works for us and is free during tool waits.
+			pi.on("context", async (_event, ctx) => {
+				if (permit) return undefined;
+				const granted = await options.queue.acquire(options.agentId, options.priority(), ctx.signal);
+				if (granted) {
+					permit = granted;
+					options.onGranted?.(granted);
+				}
+				return undefined;
+			});
+
+			pi.on("message_end", (event) => {
+				if (event.message.role === "assistant") release();
+			});
+
+			// Safety net: aborted or failed runs may end without an assistant message_end.
+			pi.on("agent_end", () => release());
+			pi.on("session_shutdown", () => release());
+
+			// After each compaction, give the model the authoritative ledger again (the host counts
+			// compactions for every mode). A steer is delivered before the next request of a running
+			// turn; when idle it is stored in the session and joins the next prompt's context.
+			pi.on("session_compact", () => {
+				const ledger = options.ledger?.();
+				if (!ledger) return;
+				pi.sendMessage(
+					{ customType: LEDGER_MESSAGE_TYPE, content: ledger.render(), display: false, details: ledger.state },
+					{ deliverAs: "steer" },
+				);
+				options.onLedgerInjected?.();
+			});
+		},
+	};
+}
diff --git a/packages/fleetpi/src/fleet/fleet-telemetry.ts b/packages/fleetpi/src/fleet/fleet-telemetry.ts
