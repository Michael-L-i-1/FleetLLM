index 0000000..06042cb
--- /dev/null
+++ b/packages/fleetpi/src/run/session-observer.ts
@@ -0,0 +1,304 @@
+// Turns one agent's Pi session events into per-call accounting, agent states and durable events.
+
+import { appendFileSync } from "node:fs";
+import type { AssistantMessage, AssistantMessageEvent, Usage } from "@earendil-works/pi-ai";
+import type { AgentSession, AgentSessionEvent } from "@earendil-works/pi-coding-agent";
+import { type AgentState, emptyTotals, type Totals } from "../types.ts";
+import type { EventLog } from "./event-log.ts";
+
+/** One provider call as recorded in calls.jsonl. */
+export interface CallRecord {
+	agent: string;
+	round: number | null;
+	phase: string;
+	kind: "turn" | "retry" | "compaction";
+	startUnixMs: number;
+	firstTokenUnixMs: number | null;
+	endUnixMs: number;
+	input: number;
+	cacheRead: number;
+	cacheWrite: number;
+	prompt: number;
+	output: number;
+	total: number;
+	reasoning: number;
+	thinkingChars: number;
+	textChars: number;
+	toolCalls: number;
+	stopReason: string;
+	error: string | null;
+}
+
+/** True for a text, thinking or tool-call argument delta that carries at least one character. */
+export function isNonEmptyDelta(event: AssistantMessageEvent): boolean {
+	switch (event.type) {
+		case "text_delta":
+		case "thinking_delta":
+		case "toolcall_delta":
+			return event.delta.length > 0;
+		default:
+			return false;
+	}
+}
+
+/** Live per-agent view for the dashboard. */
+export interface AgentView {
+	agentId: string;
+	state: AgentState;
+	stateSinceUnix: number;
+	turnsThisRound: number;
+	lastTokPerSec: number | null;
+	totals: Totals;
+}
+
+/** Observer options. */
+export interface SessionObserverOptions {
+	agentId: string;
+	log: EventLog;
+	callsPath: string;
+	maxTurnsPerRound: number;
+	onTurnLimit: () => void;
+	onCompaction?: () => void;
+	onTurn?: (turns: number) => void;
+}
+
+/** Subscribes to one AgentSession and accounts every call, tool and compaction. */
+export class SessionObserver {
+	readonly view: AgentView;
+	private readonly options: SessionObserverOptions;
+	private unsubscribe: (() => void) | undefined;
+	private callStart: number | null = null;
+	private firstToken: number | null = null;
+	private retryPending = false;
+	private compactionStart: number | null = null;
+	private readonly toolStarts = new Map<string, number>();
+
+	constructor(options: SessionObserverOptions) {
+		this.options = options;
+		this.view = {
+			agentId: options.agentId,
+			state: "idle",
+			stateSinceUnix: Date.now() / 1000,
+			turnsThisRound: 0,
+			lastTokPerSec: null,
+			totals: emptyTotals(),
+		};
+	}
+
+	/** Attach to a (possibly reopened) session. */
+	attach(session: Pick<AgentSession, "subscribe">): void {
+		this.unsubscribe?.();
+		this.unsubscribe = session.subscribe((event) => this.handle(event));
+	}
+
+	/** Detach from the current session. */
+	detach(): void {
+		this.unsubscribe?.();
+		this.unsubscribe = undefined;
+	}
+
+	/** Reset the per-round turn counter when a new task is released. */
+	startTask(): void {
+		this.view.turnsThisRound = 0;
+	}
+
+	/** Set and broadcast the agent state. */
+	setState(state: AgentState, fields: Record<string, unknown> = {}): void {
+		if (this.view.state === state) return;
+		this.view.state = state;
+		this.view.stateSinceUnix = Date.now() / 1000;
+		this.options.log.emit("agent_state", { agent: this.options.agentId, state, ...fields });
+	}
+
+	/** Add admission wait time measured by the queue. */
+	addAdmissionWait(ms: number): void {
+		this.view.totals.admissionWaitSeconds += ms / 1000;
+	}
+
+	private handle(event: AgentSessionEvent): void {
+		switch (event.type) {
+			case "turn_start":
+				this.callStart = Date.now();
+				this.firstToken = null;
+				this.setState("streaming");
+				break;
+			case "message_update":
+				// Only a non-empty content, reasoning or tool-argument delta counts as the first
+				// token; start/end markers and empty deltas would understate time to first token.
+				if (this.firstToken === null && isNonEmptyDelta(event.assistantMessageEvent)) this.firstToken = Date.now();
+				break;
+			case "message_end":
+				if (event.message.role === "assistant") this.finishCall(event.message);
+				break;
+			case "tool_execution_start":
+				this.toolStarts.set(event.toolCallId, Date.now());
+				this.setState(event.toolName === "check_site" ? "checking" : "tool");
+				break;
+			case "tool_execution_end":
+				this.finishTool(event.toolCallId, event.toolName, event.isError, event.durationMs);
+				break;
+			case "compaction_start":
+				this.compactionStart = Date.now();
+				this.setState("compacting", { reason: event.reason });
+				break;
+			case "compaction_end":
+				this.finishCompaction(event.reason, event.result?.usage, event.result?.tokensBefore ?? null, event.aborted);
+				break;
+			case "auto_retry_start":
+				this.retryPending = true;
+				this.view.totals.retries++;
+				this.options.log.emit("retry", {
+					agent: this.options.agentId,
+					attempt: event.attempt,
+					error: event.errorMessage,
+				});
+				break;
+			case "agent_settled":
+				this.setState(event.aborted ? "aborted" : "settled");
+				break;
+			default:
+				break;
+		}
+	}
+
+	private finishCall(message: AssistantMessage): void {
+		const end = Date.now();
+		const start = this.callStart ?? end;
+		const usage = message.usage;
+		const prompt = usage.input + usage.cacheRead + usage.cacheWrite;
+		let thinkingChars = 0;
+		let textChars = 0;
+		let toolCalls = 0;
+		for (const block of message.content) {
+			if (block.type === "thinking") thinkingChars += block.thinking.length;
+			else if (block.type === "text") textChars += block.text.length;
+			else if (block.type === "toolCall") toolCalls++;
+		}
+		const record: CallRecord = {
+			agent: this.options.agentId,
+			round: this.options.log.currentRound(),
+			phase: this.options.log.currentPhase(),
+			kind: this.retryPending ? "retry" : "turn",
+			startUnixMs: start,
+			firstTokenUnixMs: this.firstToken,
+			endUnixMs: end,
+			input: usage.input,
+			cacheRead: usage.cacheRead,
+			cacheWrite: usage.cacheWrite,
+			prompt,
+			output: usage.output,
+			total: prompt + usage.output,
+			reasoning: usage.reasoning ?? 0,
+			thinkingChars,
+			textChars,
+			toolCalls,
+			stopReason: message.stopReason,
+			error: message.errorMessage ?? null,
+		};
+		this.retryPending = false;
+		this.callStart = null;
+		this.accountCall(record);
+		this.view.turnsThisRound++;
+		this.options.onTurn?.(this.view.turnsThisRound);
+		if (this.view.turnsThisRound >= this.options.maxTurnsPerRound) this.options.onTurnLimit();
+	}
+
+	private accountCall(record: CallRecord): void {
+		const totals = this.view.totals;
+		totals.calls++;
+		totals.promptTokens += record.prompt;
+		totals.cachedTokens += record.cacheRead;
+		totals.inputTokens += record.input;
+		totals.outputTokens += record.output;
+		totals.totalTokens += record.total;
+		totals.reasoningTokens += record.reasoning;
+		// Both incremental and buffered transports have a full call clock. Delta delivery
+		// timing cannot establish engine decode speed, even when multiple deltas arrive.
+		const requestMs = record.endUnixMs - record.startUnixMs;
+		const requestTokPerSec = requestMs > 0 ? (record.output * 1000) / requestMs : null;
+		if (requestMs > 0) {
+			totals.requestOutputTokens += record.output;
+			totals.requestSeconds += requestMs / 1000;
+			totals.requestTokensPerSecond = totals.requestOutputTokens / totals.requestSeconds;
+		}
+		this.view.lastTokPerSec = requestTokPerSec;
+		appendFileSync(this.options.callsPath, `${JSON.stringify(record)}\n`);
+		this.options.log.emit("call_end", {
+			agent: record.agent,
+			kind: record.kind,
+			prompt: record.prompt,
+			cached: record.cacheRead,
+			output: record.output,
+			ms: record.endUnixMs - record.startUnixMs,
+			firstTokenMs: record.firstTokenUnixMs === null ? null : record.firstTokenUnixMs - record.startUnixMs,
+			// Kept null so old consumers cannot mistake delivery bursts for decode speed.
+			tokPerSec: null,
+			requestTokPerSec,
+			firstDeltaMs: record.firstTokenUnixMs === null ? null : record.firstTokenUnixMs - record.startUnixMs,
+			stopReason: record.stopReason,
+			toolCalls: record.toolCalls,
+		});
+	}
+
+	private finishTool(toolCallId: string, toolName: string, isError: boolean, durationMs: number | undefined): void {
+		const started = this.toolStarts.get(toolCallId);
+		this.toolStarts.delete(toolCallId);
+		const ms = durationMs ?? (started === undefined ? 0 : Date.now() - started);
+		this.view.totals.toolCalls++;
+		this.view.totals.toolSeconds += ms / 1000;
+		this.options.log.emit("tool_end", { agent: this.options.agentId, tool: toolName, ms, isError });
+		if (this.toolStarts.size === 0) this.setState("streaming");
+	}
+
+	private finishCompaction(
+		reason: string,
+		usage: Usage | undefined,
+		tokensBefore: number | null,
+		aborted: boolean,
+	): void {
+		const end = Date.now();
+		const start = this.compactionStart ?? end;
+		this.compactionStart = null;
+		const totals = this.view.totals;
+		totals.compactionSeconds += (end - start) / 1000;
+		if (!aborted && tokensBefore !== null) {
+			totals.compactions++;
+			this.options.onCompaction?.();
+		}
+		if (usage) {
+			const prompt = usage.input + usage.cacheRead + usage.cacheWrite;
+			const record: CallRecord = {
+				agent: this.options.agentId,
+				round: this.options.log.currentRound(),
+				phase: this.options.log.currentPhase(),
+				kind: "compaction",
+				startUnixMs: start,
+				firstTokenUnixMs: null,
+				endUnixMs: end,
+				input: usage.input,
+				cacheRead: usage.cacheRead,
+				cacheWrite: usage.cacheWrite,
+				prompt,
+				output: usage.output,
+				total: prompt + usage.output,
+				reasoning: usage.reasoning ?? 0,
+				thinkingChars: 0,
+				textChars: 0,
+				toolCalls: 0,
+				stopReason: "stop",
+				error: null,
+			};
+			totals.compactionTokens += record.total;
+			this.accountCall(record);
+		}
+		this.options.log.emit("compaction", {
+			agent: this.options.agentId,
+			reason,
+			tokensBefore,
+			ms: end - start,
+			aborted,
+			usage: usage ?? null,
+		});
+		this.setState("streaming");
+	}
+}
diff --git a/packages/fleetpi/src/run/totals.ts b/packages/fleetpi/src/run/totals.ts
new file mode 100644
index 0000000..05e3dbf
--- /dev/null
+++ b/packages/fleetpi/src/run/totals.ts
@@ -0,0 +1,41 @@
+// Arithmetic over Totals: sums across agents, per-round differences and derived rates.
+
+import { emptyTotals, type Totals } from "../types.ts";
+
+type Rate = "streamTokensPerSecond" | "requestTokensPerSecond" | "workflowOutputTokensPerSecond";
+type Counter = Exclude<keyof Totals, Rate>;
+
+const RATES: ReadonlySet<string> = new Set<Rate>([
+	"streamTokensPerSecond",
+	"requestTokensPerSecond",
+	"workflowOutputTokensPerSecond",
+]);
+const COUNTERS = Object.keys(emptyTotals()).filter((key): key is Counter => !RATES.has(key));
+
+/** Sum totals (wall time is set by the caller with withWall). */
+export function sumTotals(parts: readonly Totals[]): Totals {
+	const total = emptyTotals();
+	for (const part of parts) for (const key of COUNTERS) total[key] += part[key];
+	return withRates(total);
+}
+
+/** after - before, per counter. */
+export function diffTotals(after: Totals, before: Totals): Totals {
+	const diff = emptyTotals();
+	for (const key of COUNTERS) diff[key] = after[key] - before[key];
+	return withRates(diff);
+}
+
+/** Set the task wall time and the workflow throughput derived from it. */
+export function withWall(totals: Totals, wallSeconds: number): Totals {
+	totals.wallSeconds = wallSeconds;
+	return withRates(totals);
+}
+
+function withRates(totals: Totals): Totals {
+	totals.streamTokensPerSecond = null;
+	totals.requestTokensPerSecond =
+		totals.requestSeconds > 0 ? totals.requestOutputTokens / totals.requestSeconds : null;
+	totals.workflowOutputTokensPerSecond = totals.wallSeconds > 0 ? totals.outputTokens / totals.wallSeconds : 0;
+	return totals;
+}
diff --git a/packages/fleetpi/src/session/open-session.ts b/packages/fleetpi/src/session/open-session.ts
