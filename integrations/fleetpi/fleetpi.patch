index 0000000..6affc97
--- /dev/null
+++ b/packages/fleetpi/src/tools/common-tools.ts
@@ -0,0 +1,101 @@
+// The common tool extension every mode loads: Pi's real built-in tools on guarded operations plus check_site.
+
+import {
+	createEditToolDefinition,
+	createLsToolDefinition,
+	createReadToolDefinition,
+	createWriteToolDefinition,
+	defineTool,
+	type ExtensionAPI,
+	type InlineExtension,
+} from "@earendil-works/pi-coding-agent";
+import { Type } from "typebox";
+import type { CheckOutcome } from "../checker/checker-service.ts";
+import type { PathGuard } from "../workspace/path-guard.ts";
+
+/** Tool names active in every FestivalPi session. No bash: nothing can bypass the guard or checker. */
+export const FESTIVAL_TOOL_NAMES = ["read", "edit", "write", "ls", "check_site"] as const;
+
+/** How check_site reaches the shared checker for one agent. */
+export interface CheckSiteBinding {
+	ownedFiles: readonly string[];
+	currentRound: () => number;
+	check: (round: number, signal: AbortSignal | undefined) => Promise<CheckOutcome>;
+}
+
+/** Inline extension registering the guarded built-in tools and check_site. */
+export function commonToolsExtension(cwd: string, guard: PathGuard, checker: CheckSiteBinding): InlineExtension {
+	return {
+		name: "fleetpi-common-tools",
+		factory: (pi: ExtensionAPI) => {
+			pi.registerTool(createReadToolDefinition(cwd, { operations: guard.readOperations() }));
+			pi.registerTool(createEditToolDefinition(cwd, { operations: guard.editOperations() }));
+			pi.registerTool(createWriteToolDefinition(cwd, { operations: guard.writeOperations() }));
+			pi.registerTool(createLsToolDefinition(cwd, { operations: guard.lsOperations() }));
+			pi.registerTool(checkSiteTool(checker));
+		},
+	};
+}
+
+const checkSiteSchema = Type.Object({});
+
+interface CheckSiteDetails {
+	round: number;
+	passed: boolean;
+	checksPassed: number;
+	checksTotal: number;
+	ownedPassed: boolean;
+}
+
+function checkSiteTool(binding: CheckSiteBinding) {
+	return defineTool<typeof checkSiteSchema, CheckSiteDetails>({
+		name: "check_site",
+		label: "check_site",
+		description:
+			"Assemble the eight page fragments and run the real cumulative browser checks for the current round at 390px and 1440px. Reports pass counts and the failures on your owned pages. Takes about ten seconds.",
+		promptSnippet: "Run the real browser checks for the current round",
+		promptGuidelines: [
+			"Use check_site after editing your owned pages and before replying that your work is complete.",
+		],
+		parameters: checkSiteSchema,
+		async execute(_toolCallId, _params, signal) {
+			const round = binding.currentRound();
+			const outcome = await binding.check(round, signal);
+			const owned = binding.ownedFiles.map((file) => outcome.pages[file]);
+			return {
+				content: [{ type: "text", text: formatOutcome(outcome, binding.ownedFiles) }],
+				details: {
+					round,
+					passed: outcome.passed,
+					checksPassed: outcome.checksPassed,
+					checksTotal: outcome.checksTotal,
+					ownedPassed: owned.every((page) => page.passed),
+				},
+				isError: outcome.infrastructureError !== undefined,
+			};
+		},
+	});
+}
+
+const MAX_REPORTED_FAILURES = 30;
+
+/** Model-facing check report limited to the agent's own pages and global failures. */
+export function formatOutcome(outcome: CheckOutcome, ownedFiles: readonly string[]): string {
+	if (outcome.infrastructureError) return `check_site could not run the checker: ${outcome.infrastructureError}`;
+	const lines = [`Round ${outcome.round} site checks: ${outcome.checksPassed}/${outcome.checksTotal} passed.`];
+	const failures: string[] = [];
+	for (const file of ownedFiles) {
+		const page = outcome.pages[file];
+		lines.push(`${file}: ${page.checksPassed}/${page.checksTotal} ${page.passed ? "passed" : "failing"}`);
+		failures.push(...page.failures);
+	}
+	failures.push(...outcome.globalFailures);
+	if (failures.length === 0) {
+		lines.push("All checks on your pages pass.");
+	} else {
+		lines.push("Failures on your pages:");
+		for (const failure of failures.slice(0, MAX_REPORTED_FAILURES)) lines.push(`- ${failure}`);
+		if (failures.length > MAX_REPORTED_FAILURES) lines.push(`- ... ${failures.length - MAX_REPORTED_FAILURES} more`);
+	}
+	return lines.join("\n");
+}
diff --git a/packages/fleetpi/src/types.ts b/packages/fleetpi/src/types.ts
new file mode 100644
index 0000000..27fd5f4
--- /dev/null
+++ b/packages/fleetpi/src/types.ts
@@ -0,0 +1,116 @@
+// Shared FleetPi vocabulary: run modes, limits, events and result totals.
+
+/** The three fair benchmark arms. */
+export type FestivalMode = "fleet8" | "vllm8" | "vllm1";
+
+/** Limits applied identically to every mode. */
+export interface RunLimits {
+	roundWallSeconds: number;
+	runWallSeconds: number;
+	maxTurnsPerAgentRound: number;
+	repairPassesPerRound: number;
+	checkerConcurrency: number;
+	maxOutputTokens: number;
+	contextWindow: number;
+}
+
+/** Defaults shared by all modes; the runner refuses per-mode overrides. */
+export const DEFAULT_LIMITS: RunLimits = {
+	roundWallSeconds: 1500,
+	runWallSeconds: 2700,
+	maxTurnsPerAgentRound: 40,
+	repairPassesPerRound: 1,
+	checkerConcurrency: 2,
+	// Common profile for every mode: 4096 output tokens per response, 96000-token context.
+	maxOutputTokens: 4096,
+	contextWindow: 96000,
+};
+
+/** One line of events.jsonl. Field names follow the visual recorder contract. */
+export interface FleetEvent {
+	event: string;
+	t_unix: number;
+	elapsed: number;
+	mode: FestivalMode;
+	round: number | null;
+	round_title?: string;
+	phase?: string;
+	[field: string]: unknown;
+}
+
+/** Lifecycle states shown per agent. */
+export type AgentState =
+	| "idle"
+	| "queued"
+	| "streaming"
+	| "tool"
+	| "checking"
+	| "compacting"
+	| "settled"
+	| "failed"
+	| "aborted";
+
+/** Aggregated accounting for one run or one round. */
+export interface Totals {
+	wallSeconds: number;
+	calls: number;
+	promptTokens: number;
+	cachedTokens: number;
+	inputTokens: number;
+	outputTokens: number;
+	totalTokens: number;
+	reasoningTokens: number;
+	compactions: number;
+	compactionTokens: number;
+	compactionSeconds: number;
+	retries: number;
+	toolCalls: number;
+	toolSeconds: number;
+	checkerRuns: number;
+	checkerSeconds: number;
+	admissionWaitSeconds: number;
+	/** Reserved: delivery deltas do not establish which tokens were streamed incrementally. */
+	streamedOutputTokens: number;
+	/** Reserved until the transport provides a reliable incremental-generation clock. */
+	streamSeconds: number;
+	/** Unknown: buffered delivery must never be presented as generation throughput. */
+	streamTokensPerSecond: null;
+	/** Full observed call duration, including admission, prefill and delivery. */
+	requestSeconds: number;
+	/** Output from calls with a positive observed duration. */
+	requestOutputTokens: number;
+	/** requestOutputTokens / requestSeconds; not engine decode throughput. */
+	requestTokensPerSecond: number | null;
+	/** Headline workflow throughput: all output tokens / task wall seconds. */
+	workflowOutputTokensPerSecond: number;
+}
+
+/** A zeroed Totals value. */
+export function emptyTotals(): Totals {
+	return {
+		wallSeconds: 0,
+		calls: 0,
+		promptTokens: 0,
+		cachedTokens: 0,
+		inputTokens: 0,
+		outputTokens: 0,
+		totalTokens: 0,
+		reasoningTokens: 0,
+		compactions: 0,
+		compactionTokens: 0,
+		compactionSeconds: 0,
+		retries: 0,
+		toolCalls: 0,
+		toolSeconds: 0,
+		checkerRuns: 0,
+		checkerSeconds: 0,
+		admissionWaitSeconds: 0,
+		streamedOutputTokens: 0,
+		streamSeconds: 0,
+		streamTokensPerSecond: null,
+		requestSeconds: 0,
+		requestOutputTokens: 0,
+		requestTokensPerSecond: null,
+		workflowOutputTokensPerSecond: 0,
+	};
+}
