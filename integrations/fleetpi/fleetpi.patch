+// Atomic-publication regressions; no model, server or browser is involved.
+
+import * as fs from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { writeAttemptAtomic, writeJsonAtomic } from "../src/run/atomic-json.ts";
+
+vi.mock("node:fs", { spy: true });
+
+const directories: string[] = [];
+afterEach(() => {
+	vi.clearAllMocks();
+	while (directories.length) fs.rmSync(directories.pop() as string, { recursive: true, force: true });
+});
+
+function destination(): string {
+	const directory = fs.mkdtempSync(join(tmpdir(), "fleetpi-atomic-"));
+	directories.push(directory);
+	return join(directory, "state.json");
+}
+
+describe("atomic JSON publication", () => {
+	it("keeps the previous valid file if publication fails after the temporary write", () => {
+		const path = destination();
+		fs.writeFileSync(path, '{"generation":1}\n');
+		vi.mocked(fs.renameSync).mockImplementationOnce((temporary, target) => {
+			expect(target).toBe(path);
+			expect(dirname(String(temporary))).toBe(dirname(path));
+			expect(JSON.parse(fs.readFileSync(temporary, "utf8"))).toEqual({ generation: 2 });
+			expect(JSON.parse(fs.readFileSync(path, "utf8"))).toEqual({ generation: 1 });
+			throw new Error("interrupted before rename");
+		});
+		expect(() => writeJsonAtomic(path, { generation: 2 })).toThrow("interrupted before rename");
+		expect(JSON.parse(fs.readFileSync(path, "utf8"))).toEqual({ generation: 1 });
+		expect(fs.readdirSync(dirname(path))).toEqual(["state.json"]);
+	});
+
+	it("publishes complete attempts and refuses to replace existing attempt evidence", () => {
+		const path = destination();
+		writeAttemptAtomic(path, { attempt: "one", complete: true });
+		const original = fs.readFileSync(path, "utf8");
+		expect(JSON.parse(original)).toEqual({ attempt: "one", complete: true });
+		expect(fs.readdirSync(dirname(path))).toEqual(["state.json"]);
+		expect(() => writeAttemptAtomic(path, { attempt: "other" })).toThrow("refusing to replace");
+		expect(fs.readFileSync(path, "utf8")).toBe(original);
+	});
+});
diff --git a/packages/fleetpi/test/checker-process.test.ts b/packages/fleetpi/test/checker-process.test.ts
new file mode 100644
index 0000000..5ec91d4
--- /dev/null
+++ b/packages/fleetpi/test/checker-process.test.ts
@@ -0,0 +1,113 @@
+// Real, model-free process-tree cancellation; no Python, browser or model is required.
+
+import { existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { setTimeout as delay } from "node:timers/promises";
+import { describe, expect, it } from "vitest";
+import { pythonCheckCommand } from "../src/checker/checker-service.ts";
+
+// Node executes this check.py fixture instead of Python. The child inherits the
+// checker's process group but not its pipes, so Python/leader close is insufficient.
+const CHECKER_TREE = `
+const { spawn } = require("node:child_process");
+const { renameSync, writeFileSync } = require("node:fs");
+const { join } = require("node:path");
+const workspace = process.argv[process.argv.indexOf("--workspace") + 1];
+if (process.argv.includes("--grandchild")) {
+  process.on("SIGTERM", () => writeFileSync(join(workspace, "grandchild-term"), "received"));
+  setInterval(() => {}, 1000);
+  writeFileSync(join(workspace, "pids.tmp"), JSON.stringify({ parent: process.ppid, grandchild: process.pid }));
+  renameSync(join(workspace, "pids.tmp"), join(workspace, "pids.json"));
+} else {
+  process.on("SIGTERM", () => {
+    writeFileSync(join(workspace, "parent-term"), "received");
+    process.exit(0);
+  });
+  spawn(process.execPath, [__filename, "--workspace", workspace, "--grandchild"], { stdio: "ignore" });
+  setInterval(() => {}, 1000);
+}
+`;
+
+async function waitUntil(predicate: () => boolean): Promise<void> {
+	const deadline = performance.now() + 5_000;
+	while (!predicate()) {
+		if (performance.now() >= deadline) throw new Error("checker fixture did not reach expected process state");
+		await delay(20);
+	}
+}
+
+function alive(pid: number): boolean {
+	try {
+		process.kill(pid, 0);
+		return true;
+	} catch (error) {
+		if ((error as NodeJS.ErrnoException).code === "ESRCH") return false;
+		throw error;
+	}
+}
+
+describe("owned checker processes", () => {
+	it.skipIf(process.platform === "win32")(
+		"kills an ignored-TERM grandchild even after the checker leader has exited",
+		async () => {
+			const directory = mkdtempSync(join(tmpdir(), "fleetpi-checker-tree-"));
+			writeFileSync(join(directory, "check.py"), CHECKER_TREE);
+			const controller = new AbortController();
+			const reason = new Error("fixture cancelled");
+			const command = pythonCheckCommand(process.execPath)({
+				taskDir: directory,
+				workspace: directory,
+				output: join(directory, "result"),
+				round: 1,
+				signal: controller.signal,
+			});
+			// Attach rejection handling before cancellation, including fixture setup failures.
+			const completed = command.then(
+				(value) => ({ value, error: undefined }),
+				(error: unknown) => ({ value: undefined, error }),
+			);
+			let pids: { parent: number; grandchild: number } | undefined;
+			try {
+				const pidPath = join(directory, "pids.json");
+				await waitUntil(() => existsSync(pidPath));
+				pids = JSON.parse(readFileSync(pidPath, "utf8")) as { parent: number; grandchild: number };
+				expect(alive(pids.parent)).toBe(true);
+				expect(alive(pids.grandchild)).toBe(true);
+				controller.abort(reason);
+				const outcome = await completed;
+				expect(outcome.error).toBe(reason);
+				expect(existsSync(join(directory, "parent-term"))).toBe(true);
+				expect(existsSync(join(directory, "grandchild-term"))).toBe(true);
+				const { parent, grandchild } = pids;
+				await waitUntil(() => !alive(parent) && !alive(grandchild));
+			} finally {
+				controller.abort(reason);
+				await completed;
+				// Failure cleanup is scoped to the fixture's process group, never a name match.
+				if (pids) {
+					try {
+						process.kill(-pids.parent, "SIGKILL");
+					} catch (error) {
+						if ((error as NodeJS.ErrnoException).code !== "ESRCH") console.error("fixture cleanup failed", error);
+					}
+				}
+				rmSync(directory, { recursive: true, force: true });
+			}
+		},
+		15_000,
+	);
+
+	it("rejects pre-aborted work before launching an executable", async () => {
+		const reason = new Error("already cancelled");
+		await expect(
+			pythonCheckCommand("executable-must-not-be-started")({
+				taskDir: tmpdir(),
+				workspace: tmpdir(),
+				output: "unused",
+				round: 1,
+				signal: AbortSignal.abort(reason),
+			}),
+		).rejects.toBe(reason);
+	});
+});
