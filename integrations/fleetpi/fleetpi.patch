+// Model-free regressions for the post-trial cancellation, evidence, resume and metric fixes.
+
+import { readdirSync, readFileSync, writeFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { PassThrough } from "node:stream";
+import type { TranscriptContext } from "@earendil-works/pi-ai";
+import { fauxAssistantMessage } from "@earendil-works/pi-ai/compat";
+import type { AgentSessionEvent } from "@earendil-works/pi-coding-agent";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { type CheckCommand, CheckerService } from "../src/checker/checker-service.ts";
+import { FleetTelemetry } from "../src/fleet/fleet-telemetry.ts";
+import { ProgressLedger } from "../src/ledger/progress-ledger.ts";
+import { EventLog } from "../src/run/event-log.ts";
+import { type RunFestivalOptions, runFestival } from "../src/run/festival-runner.ts";
+import type { RunState } from "../src/run/run-state.ts";
+import { SessionObserver } from "../src/run/session-observer.ts";
+import { sumTotals } from "../src/run/totals.ts";
+import { loadFestivalTask } from "../src/task/festival-task.ts";
+import { DEFAULT_LIMITS, emptyTotals, type FleetEvent } from "../src/types.ts";
+import { Dashboard } from "../src/ui/dashboard.ts";
+import { snapshotProtectedFiles } from "../src/workspace/workspace.ts";
+import {
+	agentContext,
+	createFaux,
+	createRunFixture,
+	HOME,
+	openAgent,
+	rawCheckResult,
+	TASK_DIR,
+	tempDir,
+	textOf,
+} from "./support.ts";
+
+const task = loadFestivalTask(TASK_DIR);
+const cleanups: Array<() => void> = [];
+afterEach(() => {
+	vi.restoreAllMocks();
+	while (cleanups.length) cleanups.pop()?.();
+});
+
+function deferred<T>() {
+	let resolve!: (value: T) => void;
+	const promise = new Promise<T>((done) => {
+		resolve = done;
+	});
+	return { promise, resolve };
+}
+
+describe("buffered delivery metrics", () => {
+	it("clears unavailable call rates and starts the resumed dashboard clock at this attempt", () => {
+		vi.spyOn(Date, "now").mockReturnValue(100000000);
+		const out = Object.assign(new PassThrough(), { columns: 160 });
+		const chunks: string[] = [];
+		out.on("data", (chunk) => chunks.push(chunk.toString()));
+		const dashboard = new Dashboard(out, "FleetPi");
+		const base = { t_unix: 100000, elapsed: 86400, mode: "fleet8" as const, round: 1 };
+		dashboard.handle({ ...base, event: "run_resume", agents: [{ agent: "home" }] });
+		dashboard.handle({ ...base, event: "call_end", agent: "home", requestTokPerSec: 100 });
+		dashboard.stop();
+		expect(chunks.join("")).toContain("100.0");
+		chunks.length = 0;
+		dashboard.handle({ ...base, event: "call_end", agent: "home", requestTokPerSec: null });
+		dashboard.stop();
+		expect(chunks.join("")).not.toContain("100.0");
+		expect(chunks.join("")).not.toContain("1440:00");
+		expect(chunks.join("")).toContain("cover this attempt");
+		out.destroy();
+	});
+
+	it("does not turn a one-millisecond delivery burst into generation throughput", () => {
+		const { dir, cleanup } = tempDir("buffered-metric");
+		cleanups.push(cleanup);
+		const log = new EventLog(join(dir, "events.jsonl"), "fleet8", 0);
+		const events: FleetEvent[] = [];
+		log.subscribe((event) => events.push(event));
+		const observer = new SessionObserver({
+			agentId: "home",
+			log,
+			callsPath: join(dir, "calls.jsonl"),
+			maxTurnsPerRound: 40,
+			onTurnLimit: () => {},
+		});
+		let emit!: (event: AgentSessionEvent) => void;
+		observer.attach({
+			subscribe: (listener) => {
+				emit = listener;
+				return () => {};
+			},
+		});
+		const now = vi.spyOn(Date, "now");
+		const message = fauxAssistantMessage("buffered result");
+		message.usage = { ...message.usage, output: 100 };
+		now.mockReturnValue(1000);
+		emit({ type: "turn_start" });
+		now.mockReturnValue(1999);
+		emit({
+			type: "message_update",
+			message,
+			assistantMessageEvent: {
+				type: "text_delta",
+				contentIndex: 0,
+				delta: "buffered result",
+				partial: message,
+			},
+		});
+		now.mockReturnValue(2000);
+		emit({ type: "message_end", message });
+		const end = events.find((event) => event.event === "call_end");
+		expect(end).toMatchObject({ tokPerSec: null, requestTokPerSec: 100, firstDeltaMs: 999, ms: 1000 });
+		expect(sumTotals([observer.view.totals])).toMatchObject({
+			streamTokensPerSecond: null,
+			streamedOutputTokens: 0,
+			streamSeconds: 0,
+			requestTokensPerSecond: 100,
+			requestSeconds: 1,
+			requestOutputTokens: 100,
+		});
+	});
+});
+
+describe("checker evidence and cancellation", () => {
+	function setup(name: string, command: CheckCommand, concurrency = 1) {
+		const fixture = createRunFixture(name, "vllm8", command);
+		cleanups.push(fixture.cleanup);
+		const options = {
+			task: fixture.task,
+			workspace: fixture.workspace,
+			outputDir: fixture.outputDir,
+			protectedSnapshot: snapshotProtectedFiles(fixture.task, fixture.workspace),
+			concurrency,
+			command,
+		};
+		return { fixture, options, checker: new CheckerService(options) };
+	}
+
+	it("never reuses old snapshot/result paths after recreating the service", async () => {
+		const { options, checker } = setup("unique-checks", async ({ round }) => rawCheckResult(task, round));
+		const first = await checker.check(1, "home");
+		const original = readFileSync(first.resultPath, "utf8");
+		const snapshot = readFileSync(join(dirname(first.resultPath), "workspace/pages/home.html"), "utf8");
+		const restarted = new CheckerService(options);
+		const next = await restarted.check(1, "home");
+		await restarted.check(1, "home"); // A memo hit removes only its own newly-created directory.
+		expect(next.resultPath).not.toBe(first.resultPath);
+		expect(readFileSync(first.resultPath, "utf8")).toBe(original);
+		expect(readFileSync(join(dirname(first.resultPath), "workspace/pages/home.html"), "utf8")).toBe(snapshot);
+	});
+
+	it("one cancelled subscriber does not abort another subscriber's shared checker", async () => {
+		const gate = deferred<unknown>();
+		let commandSignal: AbortSignal | undefined;
+		const { checker } = setup("shared-abort", async ({ signal }) => {
+			commandSignal = signal;
+			return gate.promise;
+		});
+		const cancel = new AbortController();
+		const first = checker.check(1, "a", cancel.signal);
+		const second = checker.check(1, "b");
+		cancel.abort();
+		await expect(first).rejects.toMatchObject({ name: "AbortError" });
+		expect(commandSignal?.aborted).toBe(false);
+		gate.resolve(rawCheckResult(task, 1));
+		expect((await second).passed).toBe(true);
+		expect(checker.accounting().checkerRuns).toBe(1);
+	});
+
+	it("removes cancelled queued checks without invoking their command", async () => {
+		const gate = deferred<unknown>();
+		let commands = 0;
+		const { checker } = setup("queued-check", async () => {
+			commands++;
+			return gate.promise;
+		});
+		const first = checker.check(1, "a");
+		const cancel = new AbortController();
+		const queued = checker.check(2, "b", cancel.signal);
+		cancel.abort();
+		await expect(queued).rejects.toMatchObject({ name: "AbortError" });
+		gate.resolve(rawCheckResult(task, 1));
+		await first;
+		await checker.drain();
+		expect(commands).toBe(1);
+	});
+});
+
+describe("durable ledger and terminal errors", () => {
+	it("invalidates a passing snapshot after a write and after restart", async () => {
+		const fixture = createRunFixture("stale-ledger", "fleet8", async ({ round }) => rawCheckResult(task, round));
+		cleanups.push(fixture.cleanup);
+		const path = join(fixture.outputDir, "ledger.json");
+		const ledger = ProgressLedger.create(path, "home", HOME.ownedFiles);
+		ledger.bindWorkspace(fixture.workspace);
+		ledger.setPending({ round: 1, kind: "round", prompt: "Build", issuedAtUnix: 1 });
+		const checked = await fixture.checker.check(1, "home");
+		ledger.recordCheck(checked, checked.pageHashes, false);
+		expect(ledger.completedPages()).toEqual(HOME.ownedFiles);
+		writeFileSync(join(fixture.workspace, "pages/home.html"), "changed after check");
+		const resumed = ProgressLedger.load(path) as ProgressLedger;
+		resumed.bindWorkspace(fixture.workspace);
+		expect(resumed.completedPages()).toEqual([]);
+		expect(resumed.render()).toContain("not verified for current bytes");
+		// An old check finishing after a write still cannot verify the newer content.
+		resumed.recordCheck(checked, checked.pageHashes, false);
+		expect(resumed.completedPages()).toEqual([]);
+		expect(resumed.state.pages["pages/home.html"].sha256).toBe(checked.pageHashes["pages/home.html"]);
+	});
+
+	it("keeps a provider error pending and restores consumed turn/repair counts", async () => {
+		const fixture = createRunFixture("terminal-error", "vllm1", async ({ round }) => rawCheckResult(task, round));
+		cleanups.push(fixture.cleanup);
+		const faux = await createFaux("terminal-error", fixture.outputDir);
+		cleanups.push(faux.cleanup);
+		const context = agentContext(fixture, faux, { enhanced: false, sessionSettings: { retry: { enabled: false } } });
+		context.maxTurnsPerRound = 2;
+		const agent = await openAgent(HOME, context);
+		faux.faux.setResponses([fauxAssistantMessage("", { stopReason: "error", errorMessage: "invalid request" })]);
+		const pending = { round: 1, kind: "repair" as const, prompt: "Repair", issuedAtUnix: 1 };
+		expect(await agent.runTask(pending)).toBe("failed");
+		expect(agent.ledger.state.pendingTask).toEqual(pending);
+		expect(agent.ledger.state.turnsThisRound).toBe(1);
+		expect(agent.repairsThisRound).toBe(1);
+		agent.dispose();
+		const resumed = await openAgent(HOME, context, true);
+		cleanups.push(() => resumed.dispose());
+		faux.faux.setResponses([fauxAssistantMessage("Done")]);
+		expect(await resumed.runTask(pending)).toBe("turn_limit");
+		expect(resumed.ledger.state.turnsThisRound).toBe(2);
+		expect(resumed.repairsThisRound).toBe(1); // Replayed repair uses its existing slot.
+		const calls = faux.faux.state.callCount;
+		expect(await resumed.runTask(pending)).toBe("turn_limit");
+		expect(faux.faux.state.callCount).toBe(calls);
+	});
+
+	it("keeps exhausted provider retries failed and pending", async () => {
+		const fixture = createRunFixture("exhausted-error", "vllm1", async ({ round }) => rawCheckResult(task, round));
+		cleanups.push(fixture.cleanup);
+		const faux = await createFaux("exhausted-error", fixture.outputDir);
+		cleanups.push(faux.cleanup);
+		const agent = await openAgent(
+			HOME,
+			agentContext(fixture, faux, {
+				enhanced: false,
+				sessionSettings: { retry: { enabled: true, maxRetries: 1, baseDelayMs: 1 } },
+			}),
+		);
+		cleanups.push(() => agent.dispose());
+		faux.faux.setResponses(
+			Array.from({ length: 2 }, () =>
+				fauxAssistantMessage("", { stopReason: "error", errorMessage: "overloaded_error" }),
+			),
+		);
+		const pending = { round: 1, kind: "round" as const, prompt: "Build", issuedAtUnix: 1 };
+		expect(await agent.runTask(pending)).toBe("failed");
+		expect(faux.faux.state.callCount).toBe(2);
+		expect(agent.ledger.state.pendingTask).toEqual(pending);
+	});
+});
+
+describe("runner cancellation and resume accounting", () => {
+	async function setup(name: string, mode: RunFestivalOptions["mode"] = "vllm1") {
+		const { dir, cleanup } = tempDir(name);
+		cleanups.push(cleanup);
+		const faux = await createFaux(name, dir);
+		cleanups.push(faux.cleanup);
+		faux.faux.setResponses(Array.from({ length: 100 }, () => fauxAssistantMessage("Done")));
+		const events: FleetEvent[] = [];
+		let checks = 0;
+		const options: RunFestivalOptions = {
+			mode,
+			taskDir: TASK_DIR,
+			outputDir: join(dir, "run"),
+			baseUrl: "http://127.0.0.1:1/v1",
+			model: "faux-glimmer",
+			modelRuntime: faux.runtime,
+			piModel: faux.model,
+			checkCommand: async ({ round }) => {
+				checks++;
+				return rawCheckResult(task, round);
+			},
+			telemetry: new FleetTelemetry("http://127.0.0.1:1/v1", 50, async () => new Response("", { status: 404 })),
+			onEvent: (event) => events.push(event),
+		};
+		return { options, faux, events, checks: () => checks };
+	}
+
+	it("does not call the staged workflow successful when only the final site passes", async () => {
+		const { options } = await setup("missed-milestone");
+		const result = await runFestival({
+			...options,
+			checkCommand: async ({ round }) => rawCheckResult(task, round, round === 1 ? ["pages/home.html"] : []),
+		});
+		expect(result.quality[0].checksPassed).toBeLessThan(result.quality[0].checksTotal);
+		expect(result.finalPassed).toBe(true);
+		expect(result.passed).toBe(false);
+	});
+
+	it("honors an already-aborted input without issuing model calls", async () => {
+		const { options, faux } = await setup("pre-aborted");
+		const cancel = new AbortController();
+		cancel.abort();
+		const result = await runFestival({ ...options, signal: cancel.signal });
+		expect(result.cancelled).toBe(true);
+		expect(result.infrastructureError).toBeUndefined();
+		expect(faux.faux.state.callCount).toBe(0);
+	});
+
+	it("does not launch a ready repair after cancellation during its checker", async () => {
+		const { options, faux } = await setup("cancel-ready", "fleet8");
+		const cancel = new AbortController();
+		let repairs = 0;
+		faux.faux.setResponses(
+			Array.from({ length: 100 }, () => (context: TranscriptContext) => {
+				const last = context.messages.findLast((message) => message.role === "user");
+				if (last && "content" in last && textOf(last.content).includes("still fail")) repairs++;
+				return fauxAssistantMessage("Done");
+			}),
+		);
+		const result = await runFestival({
+			...options,
+			signal: cancel.signal,
+			checkCommand: async ({ round }) => {
+				cancel.abort();
+				return rawCheckResult(task, round, task.editableFiles);
+			},
+		});
+		expect(result.cancelled).toBe(true);
+		expect(result.infrastructureError).toBeUndefined();
+		expect(result.rounds).toEqual([]);
+		expect(repairs).toBe(0);
+	});
+
+	it("charges shared baseline checks once rather than once for every agent", async () => {
+		const { options, checks } = await setup("shared-count", "vllm8");
+		const result = await runFestival(options);
+		expect(result.passed).toBe(true);
+		expect(checks()).toBe(3);
+		expect(result.totals.checkerRuns).toBe(checks());
+		expect(result.runTotals?.checkerRuns).toBe(checks());
+	});
+
+	it("preserves attempt evidence and accumulates clean resumed totals and active wall", async () => {
+		const { options, events } = await setup("resume-totals");
+		const cancel = new AbortController();
+		const first = await runFestival({
+			...options,
+			signal: cancel.signal,
+			onEvent: (event) => {
+				events.push(event);
+				if (event.event === "round_complete" && event.round === 1) cancel.abort();
+			},
+		});
+		const attemptPath = join(options.outputDir, "attempts", `${first.attemptId}.json`);
+		const original = readFileSync(attemptPath, "utf8");
+		const resumed = await runFestival({ ...options, resume: true });
+		expect(resumed.passed).toBe(true);
+		expect(resumed.totalsScope).toBe("attempt");
+		expect(resumed.runTotals?.calls).toBe(first.totals.calls + resumed.totals.calls);
+		expect(resumed.runTotals?.wallSeconds).toBeCloseTo(first.totals.wallSeconds + resumed.totals.wallSeconds, 6);
+		expect(resumed.accountingComplete).toBe(true);
+		expect(readFileSync(attemptPath, "utf8")).toBe(original);
+		expect(readdirSync(join(options.outputDir, "attempts"))).toHaveLength(2);
+		const restart = events.find((event) => event.event === "run_resume");
+		expect(restart?.remainingWallSeconds).toBeCloseTo(DEFAULT_LIMITS.runWallSeconds - first.totals.wallSeconds, 6);
+		await expect(runFestival({ ...options, resume: true })).rejects.toThrow("finished run");
+	});
+
+	it("rejects changed resume limits/model and does not charge overnight downtime after a crash", async () => {
+		const { options, events } = await setup("resume-unknown");
+		const cancel = new AbortController();
+		cancel.abort();
+		await runFestival({ ...options, signal: cancel.signal });
+		await expect(runFestival({ ...options, resume: true, model: "different" })).rejects.toThrow("different model");
+		await expect(runFestival({ ...options, resume: true, limits: { maxOutputTokens: 32 } })).rejects.toThrow(
+			"different model",
+		);
+		const path = join(options.outputDir, "state.json");
+		const state = JSON.parse(readFileSync(path, "utf8")) as RunState;
+		state.attempts[0].totals = null;
+		state.attempts[0].wallBudgetSeconds = 10;
+		state.attempts[0].startedAtUnix -= 86400;
+		writeFileSync(path, JSON.stringify(state));
+		const resumed = await runFestival({ ...options, resume: true });
+		expect(resumed.passed).toBe(true);
+		expect(resumed.runTotals).toBeNull();
+		expect(resumed.accountingComplete).toBe(false);
+		expect(resumed.unknownWallInterval).toBe(true);
+		expect(events.find((event) => event.event === "run_resume")?.remainingWallSeconds).toBe(
+			DEFAULT_LIMITS.runWallSeconds - 10,
+		);
+	});
+
+	it.each(["round", "run"] as const)("does not reset an exhausted %s wall budget on resume", async (scope) => {
+		const { options, faux } = await setup(`budget-${scope}`);
+		const cancel = new AbortController();
+		cancel.abort();
+		await runFestival({ ...options, signal: cancel.signal });
+		const path = join(options.outputDir, "state.json");
+		const state = JSON.parse(readFileSync(path, "utf8")) as RunState;
+		if (scope === "round") {
+			state.roundProgress[1] = { wallSeconds: DEFAULT_LIMITS.roundWallSeconds, totals: emptyTotals() };
+		} else {
+			state.attempts[0].wallBudgetSeconds = DEFAULT_LIMITS.runWallSeconds;
+		}
+		writeFileSync(path, JSON.stringify(state));
+		const resumed = await runFestival({ ...options, resume: true });
+		expect(resumed.timedOut).toBe(true);
+		expect(resumed.passed).toBe(false);
+		expect(faux.faux.state.callCount).toBe(0);
+	});
+});
