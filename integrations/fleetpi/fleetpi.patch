+++ b/packages/fleetpi/src/checker/checker-service.ts
@@ -0,0 +1,389 @@
+// Runs the protected browser checker on immutable workspace snapshots, shared by every mode.
+
+import { spawn } from "node:child_process";
+import { copyFileSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { type FestivalTask, pageNameOf } from "../task/festival-task.ts";
+import { type ProtectedSnapshot, pageHashes, sha256, verifyProtectedFiles } from "../workspace/workspace.ts";
+
+/** Per-page view of one checker result. */
+export interface PageCheck {
+	passed: boolean;
+	checksPassed: number;
+	checksTotal: number;
+	failures: string[];
+}
+
+/** Outcome of one checker evaluation. */
+export interface CheckOutcome {
+	round: number;
+	passed: boolean;
+	checksPassed: number;
+	checksTotal: number;
+	failures: string[];
+	globalFailures: string[];
+	pages: Record<string, PageCheck>;
+	/** SHA-256 of each page in the exact snapshot that was checked (not the live workspace). */
+	pageHashes: Record<string, string>;
+	seconds: number;
+	resultPath: string;
+	memoized: boolean;
+	infrastructureError?: string;
+}
+
+/** Executes check.py and returns its parsed stdout JSON (replaceable in model-free tests). */
+export type CheckCommand = (args: {
+	taskDir: string;
+	workspace: string;
+	output: string;
+	round: number;
+	signal?: AbortSignal;
+}) => Promise<unknown>;
+
+/** Options for a CheckerService. */
+export interface CheckerServiceOptions {
+	task: FestivalTask;
+	workspace: string;
+	outputDir: string;
+	protectedSnapshot: ProtectedSnapshot;
+	concurrency: number;
+	command?: CheckCommand;
+	python?: string;
+	onExecution?: (execution: { resultPath: string; seconds: number; aborted: boolean }) => void;
+}
+
+interface RawCheckResult {
+	passed?: boolean;
+	checks?: Array<{ name: string; passed: boolean }>;
+	failures?: string[];
+}
+
+interface CheckJob {
+	promise: Promise<CheckOutcome>;
+	controller: AbortController;
+	subscribers: number;
+	settled: boolean;
+}
+
+/** Checker with a common concurrency limit and memoization by (page hashes, round). */
+export class CheckerService {
+	private readonly options: CheckerServiceOptions;
+	private readonly command: CheckCommand;
+	private readonly memo = new Map<string, CheckJob>();
+	private readonly waiters: Array<() => void> = [];
+	private running = 0;
+	private executions = 0;
+	private executionSeconds = 0;
+	private readonly pending = new Set<Promise<CheckOutcome>>();
+
+	constructor(options: CheckerServiceOptions) {
+		this.options = options;
+		this.command = options.command ?? pythonCheckCommand(options.python ?? "python3");
+	}
+
+	/** Actual command executions, counted once regardless of memo subscribers or agent count. */
+	accounting(): { checkerRuns: number; checkerSeconds: number } {
+		return { checkerRuns: this.executions, checkerSeconds: this.executionSeconds };
+	}
+
+	/** Wait until cancelled commands have exited before final accounting and disposal. */
+	async drain(): Promise<void> {
+		await Promise.allSettled(this.pending);
+	}
+
+	/** Check the current workspace for a round; identical content shares one evaluation. */
+	async check(round: number, label: string, signal?: AbortSignal): Promise<CheckOutcome> {
+		signal?.throwIfAborted();
+		const { task, workspace, protectedSnapshot } = this.options;
+		verifyProtectedFiles(task, workspace, protectedSnapshot);
+		// Copy first, then hash the copy: the memo key and the checked bytes are the same
+		// immutable snapshot even if an agent writes while this check is being prepared.
+		const directory = join(this.options.outputDir, "checks");
+		mkdirSync(directory, { recursive: true });
+		// Exclusive creation prevents resume from replacing or deleting previous evidence.
+		const base = mkdtempSync(join(directory, `r${round}-${label}-`));
+		const snapshot = join(base, "workspace");
+		this.copySnapshot(snapshot);
+		const hashes = pageHashes(task, snapshot);
+		const key = sha256(JSON.stringify({ round, hashes }));
+		const existing = this.memo.get(key);
+		if (existing && !existing.controller.signal.aborted) {
+			rmSync(base, { recursive: true, force: true });
+			return { ...(await this.subscribe(existing, signal)), memoized: true };
+		}
+		const controller = new AbortController();
+		const pending = this.evaluate(round, base, snapshot, hashes, controller.signal);
+		this.pending.add(pending);
+		const job: CheckJob = { promise: pending, controller, subscribers: 0, settled: false };
+		this.memo.set(key, job);
+		// Failed or aborted evaluations must not poison later identical requests.
+		pending.then(
+			(outcome) => {
+				this.pending.delete(pending);
+				job.settled = true;
+				if (outcome.infrastructureError && this.memo.get(key) === job) this.memo.delete(key);
+			},
+			() => {
+				this.pending.delete(pending);
+				job.settled = true;
+				if (this.memo.get(key) === job) this.memo.delete(key);
+			},
+		);
+		return this.subscribe(job, signal);
+	}
+
+	private async subscribe(job: CheckJob, signal?: AbortSignal): Promise<CheckOutcome> {
+		job.subscribers++;
+		try {
+			return await abortable(job.promise, signal);
+		} finally {
+			job.subscribers--;
+			// One cancelled agent must not kill a check another agent still needs.
+			if (job.subscribers === 0 && !job.settled) job.controller.abort();
+		}
+	}
+
+	private async evaluate(
+		round: number,
+		base: string,
+		snapshot: string,
+		hashes: Record<string, string>,
+		signal?: AbortSignal,
+	): Promise<CheckOutcome> {
+		await this.acquire(signal);
+		const started = performance.now();
+		const resultPath = join(base, "outcome.json");
+		let executed = false;
+		try {
+			signal?.throwIfAborted();
+			const output = join(base, "result");
+			let raw: unknown;
+			let infrastructureError: string | undefined;
+			try {
+				executed = true;
+				this.executions++;
+				raw = await this.command({
+					taskDir: this.options.task.taskDir,
+					workspace: snapshot,
+					output,
+					round,
+					signal,
+				});
+			} catch (error) {
+				signal?.throwIfAborted();
+				infrastructureError = error instanceof Error ? error.message : String(error);
+			}
+			signal?.throwIfAborted();
+			const outcome = summarize(this.options.task, round, raw, infrastructureError);
+			const result: CheckOutcome = {
+				...outcome,
+				pageHashes: hashes,
+				seconds: (performance.now() - started) / 1000,
+				resultPath,
+				memoized: false,
+			};
+			writeFileSync(result.resultPath, `${JSON.stringify(result, null, 2)}\n`);
+			return result;
+		} finally {
+			if (executed) {
+				const seconds = (performance.now() - started) / 1000;
+				this.executionSeconds += seconds;
+				this.options.onExecution?.({ resultPath, seconds, aborted: signal?.aborted ?? false });
+			}
+			this.release();
+		}
+	}
+
+	// The snapshot isolates the checker from writes that land while it runs.
+	private copySnapshot(snapshot: string): void {
+		const { task, workspace } = this.options;
+		for (const file of [...task.editableFiles, ...task.readOnlyFiles]) {
+			const target = join(snapshot, file);
+			mkdirSync(dirname(target), { recursive: true });
+			copyFileSync(join(workspace, file), target);
+		}
+	}
+
+	private async acquire(signal?: AbortSignal): Promise<void> {
+		signal?.throwIfAborted();
+		if (this.running < this.options.concurrency) {
+			this.running++;
+			return;
+		}
+		let grant: (() => void) | undefined;
+		const ready = new Promise<void>((resolve) => {
+			grant = resolve;
+			this.waiters.push(resolve);
+		});
+		try {
+			await abortable(ready, signal);
+		} catch (error) {
+			const index = grant ? this.waiters.indexOf(grant) : -1;
+			if (index >= 0) this.waiters.splice(index, 1);
+			else this.release(); // The permit was transferred just before the abort.
+			throw error;
+		}
+	}
+
+	private release(): void {
+		const next = this.waiters.shift();
+		if (next)
+			next(); // Transfer the reserved slot; no new caller can overtake the waiter.
+		else this.running--;
+	}
+}
+
+function abortable<T>(promise: Promise<T>, signal?: AbortSignal): Promise<T> {
+	if (!signal) return promise;
+	if (signal.aborted) return Promise.reject(signal.reason);
+	return new Promise<T>((resolve, reject) => {
+		const aborted = () => reject(signal.reason);
+		signal.addEventListener("abort", aborted, { once: true });
+		promise.then(resolve, reject).finally(() => signal.removeEventListener("abort", aborted));
+	});
+}
+
+/** Group raw checker output by page; checks without a page prefix are global. */
+export function summarize(
+	task: FestivalTask,
+	round: number,
+	raw: unknown,
+	infrastructureError?: string,
+): Omit<CheckOutcome, "pageHashes" | "seconds" | "resultPath" | "memoized"> {
+	const pages: Record<string, PageCheck> = Object.fromEntries(
+		task.editableFiles.map((file) => [file, { passed: false, checksPassed: 0, checksTotal: 0, failures: [] }]),
+	);
+	const result = (raw ?? {}) as RawCheckResult;
+	if (infrastructureError || !Array.isArray(result.checks)) {
+		const reason = infrastructureError ?? "checker returned no checks";
+		return {
+			round,
+			passed: false,
+			checksPassed: 0,
+			checksTotal: 0,
+			failures: [reason],
+			globalFailures: [reason],
+			pages,
+			infrastructureError: reason,
+		};
+	}
+	const failures = result.failures ?? [];
+	const globalFailures: string[] = [];
+	const fileByPage = new Map(task.editableFiles.map((file) => [pageNameOf(file), file]));
+	for (const check of result.checks) {
+		const file = fileByPage.get(check.name.split(/[/:]/, 1)[0]);
+		if (!file) {
+			if (!check.passed) globalFailures.push(...failures.filter((failure) => failure.startsWith(`${check.name}:`)));
+			continue;
+		}
+		const page = pages[file];
+		page.checksTotal++;
+		if (check.passed) page.checksPassed++;
+		else page.failures.push(...failures.filter((failure) => failure.startsWith(`${check.name}:`)));
+	}
+	for (const page of Object.values(pages))
+		page.passed = page.checksTotal > 0 && page.checksPassed === page.checksTotal;
+	const checksPassed = result.checks.filter((check) => check.passed).length;
+	return {
+		round,
+		passed: result.passed === true && failures.length === 0,
+		checksPassed,
+		checksTotal: result.checks.length,
+		failures,
+		globalFailures,
+		pages,
+	};
+}
+
+const CHECK_TIMEOUT_MS = 180_000;
+const CHECK_TERMINATION_GRACE_MS = 1_000;
+
+/** The production checker: python3 check.py --workspace W --output O --round R. */
+export function pythonCheckCommand(python: string): CheckCommand {
+	return ({ taskDir, workspace, output, round, signal }) =>
+		new Promise((resolve, reject) => {
+			signal?.throwIfAborted();
+			const processGroup = process.platform !== "win32";
+			const child = spawn(
+				python,
+				[join(taskDir, "check.py"), "--workspace", workspace, "--output", output, "--round", String(round)],
+				// Descendants inherit this owned group, including check.py's Node/browser children.
+				{ cwd: taskDir, stdio: ["ignore", "pipe", "pipe"], detached: processGroup },
+			);
+			let stdout = "";
+			let stderr = "";
+			let spawnError: Error | undefined;
+			let stopping = false;
+			let stopReason: unknown;
+			let closed = false;
+			let exitCode: number | null = null;
+			let escalation: ReturnType<typeof setTimeout> | undefined;
+			const timeout = setTimeout(
+				() => stop(new Error(`checker timed out after ${CHECK_TIMEOUT_MS} ms`)),
+				CHECK_TIMEOUT_MS,
+			);
+			const aborted = () => stop(signal?.reason);
+
+			function signalOwnedProcesses(killSignal: NodeJS.Signals): void {
+				try {
+					if (processGroup && child.pid) process.kill(-child.pid, killSignal);
+					else child.kill(killSignal); // Windows fallback: Node cannot signal POSIX groups.
+				} catch (error) {
+					if ((error as NodeJS.ErrnoException).code !== "ESRCH") spawnError = error as Error;
+				}
+			}
+
+			function stop(reason: unknown): void {
+				if (stopping) return;
+				stopping = true;
+				stopReason = reason;
+				clearTimeout(timeout);
+				signal?.removeEventListener("abort", aborted);
+				signalOwnedProcesses("SIGTERM");
+				// Keep escalation even if Python exits first: an ignored TERM in a browser
+				// must not survive merely because its parent closed its output pipes.
+				escalation = setTimeout(() => {
+					escalation = undefined;
+					signalOwnedProcesses("SIGKILL");
+					if (closed) finish();
+				}, CHECK_TERMINATION_GRACE_MS);
+			}
+
+			function finish(): void {
+				clearTimeout(timeout);
+				if (escalation) clearTimeout(escalation);
+				signal?.removeEventListener("abort", aborted);
+				if (stopping || spawnError) {
+					reject(spawnError ?? stopReason);
+					return;
+				}
+				const line = stdout.trim().split("\n").at(-1) ?? "";
+				try {
+					resolve(JSON.parse(line));
+				} catch {
+					reject(new Error(`checker exited ${exitCode} without JSON: ${stderr.slice(-400)}`));
+				}
+			}
+
+			signal?.addEventListener("abort", aborted, { once: true });
+			child.stdout.on("data", (chunk) => {
+				stdout += chunk;
+			});
+			child.stderr.on("data", (chunk) => {
+				stderr += chunk;
+			});
+			child.once("error", (error) => {
+				spawnError = error;
+			});
+			child.once("close", (code) => {
+				closed = true;
+				exitCode = code;
+				if (!escalation) finish();
+			});
+		});
+}
+
+/** Read a persisted outcome (used on resume). */
+export function readOutcome(path: string): CheckOutcome {
+	return JSON.parse(readFileSync(path, "utf8")) as CheckOutcome;
+}
