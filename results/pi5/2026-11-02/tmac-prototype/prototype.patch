diff --git a/src/q2lut.c b/src/q2lut.c
new file mode 100644
index 0000000..7d29a0f
--- /dev/null
+++ b/src/q2lut.c
@@ -0,0 +1,56 @@
+#include "q2lut.h"
+#include "q2lut_impl.h"
+
+void q2lut_repack(cq_mat *w, int bits) {
+#if !defined(__aarch64__)
+  fprintf(stderr, "Q2 LUT prototype requires AArch64 NEON\n");
+  abort();
+#endif
+  if (w->kind != CQ2K ||
+      (bits != 16 && bits != 8 && bits != 116 && bits != 108))
+    return;
+  lut_mat m = bits > 100 ? repack16(w) : repack(w);
+  free(w->codes);
+  w->codes = m.codes;
+  w->lut_bits = bits;
+}
+void q2lut_reset(cq_act *a) {
+  lut_act *p = a->lut_ctx;
+  if (!p)
+    return;
+  free(p->lo);
+  free(p->hi);
+  free(p->q8);
+  free(p->scale);
+  free(p);
+  a->lut_ctx = NULL;
+}
+void q2lut_prepare(cq_act *a) {
+  if (a->lut_ctx)
+    return;
+  lut_act *p = malloc(sizeof *p);
+  *p = tables(a);
+  a->lut_ctx = p;
+}
+void q2lut_rows(const cq_mat *w, const cq_act *a, float *y, int ldy, int r0,
+                int r1) {
+  if (!a->lut_ctx || ldy != w->rows) {
+    fprintf(stderr, "q2 LUT prototype needs prepared activations and dense "
+                    "output stride\n");
+    abort();
+  }
+#if defined(__aarch64__)
+  lut_mat m = {w, w->codes};
+  job j = {w, a, &m, a->lut_ctx, y, w->lut_bits};
+  if (w->lut_bits == 116)
+    lut_run16(&j, r0, r1, 16);
+  else if (w->lut_bits == 108)
+    lut_run16(&j, r0, r1, 8);
+  else if (w->lut_bits == 16)
+    lut_run(&j, r0, r1, 16);
+  else
+    lut_run(&j, r0, r1, 8);
+#else
+  abort();
+#endif
+}
