@@ -0,0 +1,71 @@
+// Common local-model registration (models.json in an isolated agent dir), identical for Fleet and vLLM.
+
+import { mkdirSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import type { Api, Model } from "@earendil-works/pi-ai";
+import { ModelRuntime } from "@earendil-works/pi-coding-agent";
+import type { RunLimits } from "../types.ts";
+
+/** Provider id used for the served Glimmer model in every mode. */
+export const LOCAL_PROVIDER = "fleetpi-local";
+
+/** The models.json document for one OpenAI-compatible endpoint. */
+export function localModelsJson(
+	baseUrl: string,
+	modelId: string,
+	limits: Pick<RunLimits, "contextWindow" | "maxOutputTokens">,
+) {
+	return {
+		providers: {
+			[LOCAL_PROVIDER]: {
+				name: "Local Glimmer endpoint",
+				baseUrl,
+				api: "openai-completions",
+				apiKey: "local",
+				// Verified differences of the local Glimmer endpoints from the OpenAI defaults Pi
+				// would auto-detect: system (not developer) role, no store field, max_tokens.
+				compat: {
+					supportsDeveloperRole: false,
+					supportsStore: false,
+					maxTokensField: "max_tokens",
+					supportsReasoningEffort: true,
+					thinkingFormat: "openai",
+					supportsUsageInStreaming: true,
+				},
+				models: [
+					{
+						id: modelId,
+						name: "Muse Glimmer 30B 4-bit",
+						reasoning: true,
+						input: ["text"],
+						contextWindow: limits.contextWindow,
+						maxTokens: limits.maxOutputTokens,
+						cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+						samplingParams: { temperature: 0, chat_template_kwargs: { reasoning_strength: "low" } },
+					},
+				],
+			},
+		},
+	};
+}
+
+/** Write models.json into agentDir and load a ModelRuntime from it. */
+export async function createLocalModelRuntime(
+	agentDir: string,
+	baseUrl: string,
+	modelId: string,
+	limits: Pick<RunLimits, "contextWindow" | "maxOutputTokens">,
+): Promise<{ runtime: ModelRuntime; model: Model<Api> }> {
+	mkdirSync(agentDir, { recursive: true });
+	const modelsPath = join(agentDir, "models.json");
+	writeFileSync(modelsPath, `${JSON.stringify(localModelsJson(baseUrl, modelId, limits), null, 2)}\n`);
+	const runtime = await ModelRuntime.create({
+		authPath: join(agentDir, "auth.json"),
+		modelsPath,
+		allowModelNetwork: false,
+	});
+	const model = runtime.getModel(LOCAL_PROVIDER, modelId);
+	if (!model)
+		throw new Error(`models.json did not register ${LOCAL_PROVIDER}/${modelId}: ${runtime.getError() ?? "unknown"}`);
+	return { runtime, model };
+}
diff --git a/packages/fleetpi/src/run/agent-runtime.ts b/packages/fleetpi/src/run/agent-runtime.ts
new file mode 100644
index 0000000..b551411
--- /dev/null
+++ b/packages/fleetpi/src/run/agent-runtime.ts
@@ -0,0 +1,314 @@
+// One agent: its guarded tools, Pi session, durable ledger and accounting, and task execution.
+
+import { existsSync, mkdirSync, readdirSync } from "node:fs";
+import { join } from "node:path";
+import type { Api, Model } from "@earendil-works/pi-ai";
+import type { AgentSession, InlineExtension, ModelRuntime } from "@earendil-works/pi-coding-agent";
+import type { CheckerService, CheckOutcome } from "../checker/checker-service.ts";
+import type { AdmissionPriority, AdmissionQueue } from "../fleet/admission-queue.ts";
+import { fleetExtension } from "../fleet/fleet-extension.ts";
+import { appendLedgerEntry, latestLedgerEntry, type PendingTask, ProgressLedger } from "../ledger/progress-ledger.ts";
+import { openSession, type SessionSettings } from "../session/open-session.ts";
+import type { AgentAssignment, FestivalTask } from "../task/festival-task.ts";
+import { commonToolsExtension } from "../tools/common-tools.ts";
+import { PathGuard } from "../workspace/path-guard.ts";
+import { sha256 } from "../workspace/workspace.ts";
+import type { EventLog } from "./event-log.ts";
+import { SessionObserver } from "./session-observer.ts";
+
+/** Shared services every agent of a run uses. */
+export interface AgentContext {
+	task: FestivalTask;
+	workspace: string;
+	outputDir: string;
+	agentDir: string;
+	log: EventLog;
+	checker: CheckerService;
+	modelRuntime: ModelRuntime;
+	model: Model<Api>;
+	maxTurnsPerRound: number;
+	/** Enhanced mode only. */
+	fleet?: { queue: AdmissionQueue; sharedContext: string };
+	sessionSettings?: SessionSettings;
+}
+
+/** How a task ended. */
+export type TaskOutcome = "settled" | "aborted" | "failed" | "turn_limit";
+
+/** Owns one agent's Pi session for the whole run. */
+export class AgentRuntime {
+	readonly assignment: AgentAssignment;
+	readonly guard: PathGuard;
+	readonly observer: SessionObserver;
+	private currentLedger: ProgressLedger;
+	private readonly ledgerFromFile: boolean;
+	private readonly resume: boolean;
+	private readonly context: AgentContext;
+	private session: AgentSession | undefined;
+	private nextPriority: AdmissionPriority = "fresh";
+	private turnLimited = false;
+
+	constructor(assignment: AgentAssignment, context: AgentContext, resume: boolean) {
+		this.assignment = assignment;
+		this.context = context;
+		const { log } = context;
+		this.guard = new PathGuard(context.workspace, assignment.ownedFiles, {
+			onDenied: (denial, operation) =>
+				log.emit("guard_block", { agent: assignment.agentId, tool: operation, ...denial }),
+			onWrite: (path, content, operation) => {
+				this.currentLedger.invalidate(path);
+				log.emit("file_write", {
+					agent: assignment.agentId,
+					path,
+					sha256: sha256(content),
+					bytes: Buffer.byteLength(content),
+					tool: operation,
+				});
+			},
+		});
+		mkdirSync(join(context.outputDir, "ledger"), { recursive: true });
+		mkdirSync(this.sessionDir, { recursive: true });
+		const ledgerPath = join(context.outputDir, "ledger", `${assignment.agentId}.json`);
+		const loaded = resume ? ProgressLedger.load(ledgerPath) : undefined;
+		this.ledgerFromFile = loaded !== undefined;
+		this.resume = resume;
+		this.currentLedger = loaded ?? ProgressLedger.create(ledgerPath, assignment.agentId, assignment.ownedFiles);
+		this.currentLedger.bindWorkspace(context.workspace);
+		this.observer = new SessionObserver({
+			agentId: assignment.agentId,
+			log,
+			callsPath: join(context.outputDir, "calls.jsonl"),
+			maxTurnsPerRound: context.maxTurnsPerRound,
+			onTurnLimit: () => {
+				this.turnLimited = true;
+				void this.session?.abort();
+			},
+			onCompaction: () => this.currentLedger.recordCompaction(),
+			onTurn: (turns) => this.currentLedger.recordTurns(turns),
+		});
+	}
+
+	/** The durable progress ledger. */
+	get ledger(): ProgressLedger {
+		return this.currentLedger;
+	}
+
+	/** Agent id. */
+	get agentId(): string {
+		return this.assignment.agentId;
+	}
+
+	/** Directory holding this agent's Pi session files (outside the workspace). */
+	get sessionDir(): string {
+		return join(this.context.outputDir, "sessions", this.assignment.agentId);
+	}
+
+	/** Repair prompts issued in the current round. */
+	get repairsThisRound(): number {
+		return this.ledger.state.repairsThisRound;
+	}
+
+	/** The open Pi session. */
+	get piSession(): AgentSession {
+		if (!this.session) throw new Error(`${this.agentId} session is not open`);
+		return this.session;
+	}
+
+	/** Open (or reopen from the persisted session file) this agent's Pi session. */
+	async open(): Promise<void> {
+		const recorded = this.ledger.state.sessionFile;
+		const sessionFile =
+			recorded && existsSync(recorded) ? recorded : this.resume ? newestSessionFile(this.sessionDir) : undefined;
+		this.session = await openSession({
+			cwd: this.context.workspace,
+			agentDir: this.context.agentDir,
+			sessionDir: this.sessionDir,
+			sessionFile,
+			modelRuntime: this.context.modelRuntime,
+			model: this.context.model,
+			extensions: this.extensions(),
+			appendSystemPrompt: this.context.fleet ? [this.context.fleet.sharedContext] : [],
+			settings: this.context.sessionSettings,
+		});
+		// The ledger file is authoritative; the copy mirrored into the session file restores it
+		// when the file was lost.
+		if (this.resume && !this.ledgerFromFile) {
+			const mirrored = latestLedgerEntry(this.session.sessionManager);
+			if (mirrored) {
+				this.currentLedger = new ProgressLedger(this.currentLedger.path, mirrored);
+				this.currentLedger.bindWorkspace(this.context.workspace);
+				this.currentLedger.save();
+			}
+		}
+		this.currentLedger.setSessionFile(this.session.sessionFile);
+		this.observer.view.turnsThisRound = this.ledger.state.turnsThisRound;
+		this.turnLimited = this.observer.view.turnsThisRound >= this.context.maxTurnsPerRound;
+		this.observer.attach(this.session);
+	}
+
+	/** Reset per-round counters when a new round is released. */
+	startRound(): void {
+		this.ledger.startRound();
+		this.observer.startTask();
+		this.turnLimited = false;
+	}
+
+	/** Run one prompt to settlement (Pi's prompt() resolves after retries and recovery). */
+	async runTask(task: PendingTask, signal?: AbortSignal): Promise<TaskOutcome> {
+		const session = this.piSession;
+		if (signal?.aborted) return "aborted";
+		if (this.turnLimited) return "turn_limit";
+		this.nextPriority = task.kind === "repair" ? "repair" : "fresh";
+		this.ledger.setPending(task);
+		appendLedgerEntry(session.sessionManager, this.ledger);
+		this.observer.setState("queued");
+		const toolCallsBefore = this.observer.view.totals.toolCalls;
+		let outcome: TaskOutcome = "settled";
+		const abort = () => {
+			void session.abort();
+		};
+		signal?.addEventListener("abort", abort, { once: true });
+		// Abort can arrive during Pi's asynchronous prompt preflight, before a run exists.
+		// Reapply it at agent_start so that preflight cannot resurrect cancelled work.
+		const unsubscribe = session.subscribe((event) => {
+			if (event.type === "agent_start" && signal?.aborted) abort();
+		});
+		try {
+			await session.prompt(task.prompt);
+			if (signal?.aborted) outcome = "aborted";
+			else if (lastStopReason(session) === "error") {
+				outcome = "failed";
+				this.context.log.emit("agent_error", { agent: this.agentId, error: "provider settled with an error" });
+			} else if (this.turnLimited) outcome = "turn_limit";
+			else if (lastStopReason(session) === "aborted") outcome = "aborted";
+		} catch (error) {
+			outcome = signal?.aborted ? "aborted" : "failed";
+			if (outcome === "failed") {
+				this.context.log.emit("agent_error", {
+					agent: this.agentId,
+					error: error instanceof Error ? error.message : String(error),
+				});
+			}
+		} finally {
+			unsubscribe();
+			signal?.removeEventListener("abort", abort);
+		}
+		// A settled task without any tool call usually means the endpoint returned tool markup as
+		// text (no native tool parsing). Report it loudly instead of scoring a silent no-op.
+		if (outcome === "settled" && this.observer.view.totals.toolCalls === toolCallsBefore) {
+			this.context.log.emit("no_tool_calls", {
+				agent: this.agentId,
+				kind: task.kind,
+				lastText: lastText(session).slice(0, 400),
+			});
+		}
+		// An aborted (cancelled) task stays pending so a restart can continue it.
+		if (outcome === "settled" || outcome === "turn_limit") this.ledger.clearPending();
+		this.ledger.setSessionFile(session.sessionFile);
+		appendLedgerEntry(session.sessionManager, this.ledger);
+		this.observer.setState(
+			outcome === "settled" || outcome === "turn_limit" ? "settled" : outcome === "failed" ? "failed" : "aborted",
+			{ outcome },
+		);
+		this.context.log.emit("ledger", {
+			agent: this.agentId,
+			completedPages: this.ledger.completedPages(),
+			pendingTask: this.ledger.state.pendingTask?.kind ?? null,
+		});
+		return outcome;
+	}
+
+	/** Run the shared checker and record the result in the ledger. */
+	async check(round: number, label: string, official: boolean, signal?: AbortSignal): Promise<CheckOutcome> {
+		const outcome = await this.context.checker.check(round, label, signal);
+		this.recordCheck(outcome, official);
+		return outcome;
+	}
+
+	/** Record a check computed elsewhere (official round check). */
+	recordCheck(outcome: CheckOutcome, official: boolean): void {
+		// Hashes of the checked snapshot, so the ledger never pairs a result with newer bytes.
+		this.ledger.recordCheck(outcome, outcome.pageHashes, official);
+		const owned = this.assignment.ownedFiles.map((file) => outcome.pages[file]);
+		this.context.log.emit("check", {
+			agent: this.agentId,
+			official,
+			passed: outcome.passed,
+			ownedPassed: owned.every((page) => page.passed),
+			checksPassed: outcome.checksPassed,
+			checksTotal: outcome.checksTotal,
+			ownedChecksPassed: owned.reduce((sum, page) => sum + page.checksPassed, 0),
+			ownedChecksTotal: owned.reduce((sum, page) => sum + page.checksTotal, 0),
+			seconds: outcome.seconds,
+			memoized: outcome.memoized,
+			resultPath: outcome.resultPath,
+			infrastructureError: outcome.infrastructureError ?? null,
+		});
+	}
+
+	/** Failures on this agent's pages plus global failures. */
+	failuresIn(outcome: CheckOutcome): string[] {
+		return [...this.assignment.ownedFiles.flatMap((file) => outcome.pages[file].failures), ...outcome.globalFailures];
+	}
+
+	/** True when every owned page passes. Site-wide checks cannot be attributed to one owner, so
+	 * they are reported in repair prompts but never trigger a repair on their own. */
+	ownsPassing(outcome: CheckOutcome): boolean {
+		return this.assignment.ownedFiles.every((file) => outcome.pages[file].passed);
+	}
+
+	/** Abort the running task, if any. */
+	async abort(): Promise<void> {
+		await this.session?.abort();
+	}
+
+	/** Detach and dispose the Pi session. */
+	dispose(): void {
+		this.observer.detach();
+		this.session?.dispose();
+		this.session = undefined;
+	}
+
+	private extensions(): InlineExtension[] {
+		const { log } = this.context;
+		const tools = commonToolsExtension(this.context.workspace, this.guard, {
+			ownedFiles: this.assignment.ownedFiles,
+			currentRound: () => log.currentRound() ?? 1,
+			check: (round, signal) => this.check(round, this.agentId, false, signal),
+		});
+		const fleet = this.context.fleet;
+		if (!fleet) return [tools];
+		return [
+			tools,
+			fleetExtension({
+				agentId: this.agentId,
+				queue: fleet.queue,
+				ledger: () => this.ledger,
+				priority: () => this.nextPriority,
+				onGranted: (permit) => {
+					this.nextPriority = "continue";
+					this.observer.addAdmissionWait(permit.waitedMs);
+				},
+			}),
+		];
+	}
+}
+
+function lastStopReason(session: AgentSession): string | undefined {
+	const last = session.messages.findLast((message) => message.role === "assistant");
+	return last?.role === "assistant" ? last.stopReason : undefined;
+}
+
+function lastText(session: AgentSession): string {
+	const last = session.messages.findLast((message) => message.role === "assistant");
+	if (last?.role !== "assistant") return "";
+	return last.content.map((block) => (block.type === "text" ? block.text : "")).join("");
+}
+
+function newestSessionFile(dir: string): string | undefined {
+	if (!existsSync(dir)) return undefined;
+	const files = readdirSync(dir)
+		.filter((name) => name.endsWith(".jsonl"))
+		.sort();
+	return files.length > 0 ? join(dir, files[files.length - 1]) : undefined;
+}
diff --git a/packages/fleetpi/src/run/atomic-json.ts b/packages/fleetpi/src/run/atomic-json.ts
new file mode 100644
index 0000000..fd3c5ae
--- /dev/null
+++ b/packages/fleetpi/src/run/atomic-json.ts
@@ -0,0 +1,21 @@
+// Publishes complete JSON files with a same-directory temporary file and atomic rename.
+
+import { randomUUID } from "node:crypto";
+import { existsSync, renameSync, rmSync, writeFileSync } from "node:fs";
+
+/** Publish complete JSON; callers must already own the destination directory. */
+export function writeJsonAtomic(path: string, value: object): void {
+	const temporary = `${path}.${randomUUID()}.tmp`;
+	try {
+		writeFileSync(temporary, `${JSON.stringify(value, null, 2)}\n`, { flag: "wx" });
+		renameSync(temporary, path);
+	} finally {
+		rmSync(temporary, { force: true });
+	}
+}
+
+/** Publish one unique attempt ID, refusing accidental reuse by this single-writer runner. */
+export function writeAttemptAtomic(path: string, value: object): void {
+	if (existsSync(path)) throw new Error(`refusing to replace existing attempt: ${path}`);
+	writeJsonAtomic(path, value);
+}
diff --git a/packages/fleetpi/src/run/event-log.ts b/packages/fleetpi/src/run/event-log.ts
new file mode 100644
index 0000000..dd0c984
--- /dev/null
+++ b/packages/fleetpi/src/run/event-log.ts
@@ -0,0 +1,78 @@
+// Durable events.jsonl writer with the shared clock used by the visual recorder.
+
+import { appendFileSync, mkdirSync } from "node:fs";
+import { dirname } from "node:path";
+import type { FestivalMode, FleetEvent } from "../types.ts";
+
+/** Appends one JSON object per line and fans events out to listeners. */
+export class EventLog {
+	readonly path: string;
+	readonly mode: FestivalMode;
+	private startTimeUnix: number;
+	private round: number | null = null;
+	private roundTitle = "";
+	private phase = "";
+	private readonly listeners: Array<(event: FleetEvent) => void> = [];
+
+	constructor(path: string, mode: FestivalMode, startTimeUnix: number) {
+		this.path = path;
+		this.mode = mode;
+		this.startTimeUnix = startTimeUnix;
+		mkdirSync(dirname(path), { recursive: true });
+	}
+
+	/** Register a listener (dashboard, --json stdout, root's onEvent). */
+	subscribe(listener: (event: FleetEvent) => void): void {
+		this.listeners.push(listener);
+	}
+
+	/** Set the round context carried by subsequent events. */
+	setRound(round: number, title: string): void {
+		this.round = round;
+		this.roundTitle = title;
+	}
+
+	/** Set the phase carried by subsequent events and emit a phase event. */
+	setPhase(phase: string): void {
+		this.phase = phase;
+		this.emit("phase", { phase });
+	}
+
+	/** Move the clock origin (used once, when the task starts after setup and beforeRun). */
+	resetClock(startTimeUnix: number): void {
+		this.startTimeUnix = startTimeUnix;
+	}
+
+	/** Round carried by events right now. */
+	currentRound(): number | null {
+		return this.round;
+	}
+
+	/** Phase carried by events right now. */
+	currentPhase(): string {
+		return this.phase;
+	}
+
+	/** Seconds since the shared start time. */
+	elapsed(): number {
+		return Math.max(0, Date.now() / 1000 - this.startTimeUnix);
+	}
+
+	/** Write one event synchronously so a crash never loses an emitted line. */
+	emit(event: string, fields: Record<string, unknown> = {}): FleetEvent {
+		const now = Date.now() / 1000;
+		const record: FleetEvent = {
+			event,
+			t_unix: now,
+			elapsed: Math.max(0, now - this.startTimeUnix),
+			mode: this.mode,
+			round: this.round,
+			round_title: this.roundTitle,
+			phase: this.phase,
+			...fields,
+		};
+		appendFileSync(this.path, `${JSON.stringify(record)}\n`);
+		for (const listener of this.listeners) listener(record);
+		return record;
+	}
+}
diff --git a/packages/fleetpi/src/run/festival-runner.ts b/packages/fleetpi/src/run/festival-runner.ts
new file mode 100644
index 0000000..6cfc793
--- /dev/null
+++ b/packages/fleetpi/src/run/festival-runner.ts
@@ -0,0 +1,643 @@
+// runFestival: releases the three stakeholder rounds to real Pi sessions in one of the three fair modes.
+
+import { randomUUID } from "node:crypto";
+import { existsSync, mkdirSync, readdirSync, writeFileSync } from "node:fs";
+import { join, resolve } from "node:path";
+import { isDeepStrictEqual } from "node:util";
+import type { Api, Model } from "@earendil-works/pi-ai";
+import type { ModelRuntime } from "@earendil-works/pi-coding-agent";
+import { type CheckCommand, CheckerService, type CheckOutcome } from "../checker/checker-service.ts";
+import { AdmissionQueue } from "../fleet/admission-queue.ts";
+import { FleetTelemetry } from "../fleet/fleet-telemetry.ts";
+import type { PendingTask } from "../ledger/progress-ledger.ts";
+import { createLocalModelRuntime } from "../model/local-model.ts";
+import type { SessionSettings } from "../session/open-session.ts";
+import { type FestivalRound, type FestivalTask, loadFestivalTask, planAgents } from "../task/festival-task.ts";
+import {
+	firstUserPromptWithContext,
+	repairPrompt,
+	resumePrompt,
+	roundPrompt,
+	sharedProjectContext,
+} from "../task/prompts.ts";
+import {
+	DEFAULT_LIMITS,
+	emptyTotals,
+	type FestivalMode,
+	type FleetEvent,
+	type RunLimits,
+	type Totals,
+} from "../types.ts";
+import { prepareWorkspace, snapshotProtectedFiles, verifyProtectedFiles } from "../workspace/workspace.ts";
+import { type AgentContext, AgentRuntime, type TaskOutcome } from "./agent-runtime.ts";
+import { writeAttemptAtomic, writeJsonAtomic } from "./atomic-json.ts";
+import { EventLog } from "./event-log.ts";
+import { type RoundResult, type RunAttempt, type RunState, RunStateStore } from "./run-state.ts";
+import { diffTotals, sumTotals, withWall } from "./totals.ts";
+
+/** Inputs of one festival run. Root's benchmark wrapper uses this directly. */
+export interface RunFestivalOptions {
+	mode: FestivalMode;
+	taskDir: string;
+	outputDir: string;
+	baseUrl: string;
+	model: string;
+	onEvent?: (event: FleetEvent) => void;
+	signal?: AbortSignal;
+	limits?: Partial<RunLimits>;
+	resume?: boolean;
+	pythonPath?: string;
+	/** Event clock origin. When omitted, the clock starts right after beforeRun returns. */
+	startTimeUnix?: number;
+	/**
+	 * Awaited after the workspace is prepared and before any session opens or model call is made
+	 * (e.g. to capture the unedited site). Its time is excluded from the reported task wall.
+	 */
+	beforeRun?: (info: { workspace: string; outputDir: string }) => Promise<void>;
+	/** Model-free test seams; production leaves them unset. */
+	modelRuntime?: ModelRuntime;
+	piModel?: Model<Api>;
+	checkCommand?: CheckCommand;
+	sessionSettings?: SessionSettings;
+	telemetry?: FleetTelemetry;
+}
+
+/** Outcome of a run. */
+export interface FestivalResult {
+	mode: FestivalMode;
+	passed: boolean;
+	/** Final cumulative site score can pass even if an earlier required milestone failed. */
+	finalPassed: boolean;
+	cancelled: boolean;
+	timedOut: boolean;
+	infrastructureError?: string;
+	totals: Totals;
+	/** totals covers this attempt only; historical rounds can predate it. */
+	totalsScope: "attempt";
+	attemptId: string;
+	/** Null after an unclean interruption: incomplete usage must not look benchmark-comparable. */
+	runTotals: Totals | null;
+	accountingComplete: boolean;
+	/** Crashed attempts use their last active-time checkpoint, with an unknown lost interval. */
+	wallBudgetPolicy: "active-time-checkpoints";
+	unknownWallInterval: boolean;
+	rounds: RoundResult[];
+	quality: Array<{ round: number; checksPassed: number; checksTotal: number; failures: string[] }>;
+	outputDir: string;
+}
+
+/** Run (or resume) the eight-page, three-round festival task in one mode. */
+export async function runFestival(options: RunFestivalOptions): Promise<FestivalResult> {
+	const run = await FestivalRun.create(options);
+	return run.execute();
+}
+
+// Entries a supervising caller (the CLI, root's wrapper) may create before the run: server logs.
+const SETUP_ENTRIES: ReadonlySet<string> = new Set(["logs"]);
+
+const AGING_MS = 20_000;
+const PRESSURE_POLL_MS = 500;
+const STATS_EVENT_MS = 1000;
+
+class FestivalRun {
+	private readonly options: RunFestivalOptions;
+	private readonly limits: RunLimits;
+	private readonly outputDir: string;
+	private readonly task: FestivalTask;
+	private readonly workspace: string;
+	private readonly store: RunStateStore;
+	private readonly state: RunState;
+	private readonly log: EventLog;
+	private readonly checker: CheckerService;
+	private readonly agents: AgentRuntime[];
+	private readonly telemetry: FleetTelemetry | undefined;
+	private readonly queue: AdmissionQueue | undefined;
+	private readonly sharedContext: string;
+	private readonly cancel = new AbortController();
+	private roundAbort = new AbortController();
+	private timedOut = false;
+	private roundTimedOut = false;
+	private taskStarted = performance.now();
+	private attempt: RunAttempt | undefined;
+	private checkpointRound: (() => void) | undefined;
+
+	private constructor(fields: {
+		options: RunFestivalOptions;
+		limits: RunLimits;
+		outputDir: string;
+		task: FestivalTask;
+		workspace: string;
+		store: RunStateStore;
+		state: RunState;
+		log: EventLog;
+		checker: CheckerService;
+		agents: AgentRuntime[];
+		telemetry?: FleetTelemetry;
+		queue?: AdmissionQueue;
+		sharedContext: string;
+	}) {
+		this.options = fields.options;
+		this.limits = fields.limits;
+		this.outputDir = fields.outputDir;
+		this.task = fields.task;
+		this.workspace = fields.workspace;
+		this.store = fields.store;
+		this.state = fields.state;
+		this.log = fields.log;
+		this.checker = fields.checker;
+		this.agents = fields.agents;
+		this.telemetry = fields.telemetry;
+		this.queue = fields.queue;
+		this.sharedContext = fields.sharedContext;
+	}
+
+	static async create(options: RunFestivalOptions): Promise<FestivalRun> {
+		let limits = { ...DEFAULT_LIMITS, ...options.limits };
+		const outputDir = resolve(options.outputDir);
+		const resume = options.resume === true;
+		const unexpected = existsSync(outputDir) ? readdirSync(outputDir).filter((name) => !SETUP_ENTRIES.has(name)) : [];
+		if (!resume && unexpected.length > 0) {
+			throw new Error(
+				`output directory is not empty (${unexpected.join(", ")}): ${outputDir} (use resume to continue a run)`,
+			);
+		}
+		mkdirSync(join(outputDir, "logs"), { recursive: true });
+		const task = loadFestivalTask(options.taskDir);
+		const workspace = join(outputDir, "workspace");
+		const store = new RunStateStore(join(outputDir, "state.json"));
+		let state: RunState;
+		if (resume) {
+			state = store.load();
+			if (state.mode !== options.mode) throw new Error(`cannot resume a ${state.mode} run as ${options.mode}`);
+			if (state.finished) throw new Error("cannot resume a finished run; its summary is immutable");
+			limits = { ...state.limits, ...options.limits };
+			if (
+				state.model !== options.model ||
+				state.baseUrl !== options.baseUrl ||
+				state.taskDir !== task.taskDir ||
+				!isDeepStrictEqual(limits, state.limits) ||
+				!isDeepStrictEqual(options.sessionSettings ?? null, state.sessionSettings)
+			) {
+				throw new Error("cannot resume with a different model, endpoint, task, limits or session settings");
+			}
+			verifyProtectedFiles(task, workspace, state.protectedSnapshot);
+			const interrupted = state.attempts.at(-1);
+			if (interrupted && interrupted.totals === null) {
+				// The lost interval after the last checkpoint is unknown. Keep its active-time
+				// lower bound and flag incomplete accounting; time spent stopped is never work.
+				state.activeRound = null;
+				store.save(state);
+			}
+		} else {
+			prepareWorkspace(task, workspace);
+			state = {
+				version: 2,
+				mode: options.mode,
+				taskDir: task.taskDir,
+				baseUrl: options.baseUrl,
+				model: options.model,
+				startTimeUnix: options.startTimeUnix ?? Date.now() / 1000,
+				limits,
+				protectedSnapshot: snapshotProtectedFiles(task, workspace),
+				rounds: [],
+				finished: false,
+				sessionSettings: options.sessionSettings ?? null,
+				attempts: [],
+				roundProgress: {},
+				activeRound: null,
+			};
+			store.save(state);
+		}
+		const log = new EventLog(join(outputDir, "events.jsonl"), options.mode, state.startTimeUnix);
+		if (options.onEvent) log.subscribe(options.onEvent);
+		const { runtime, model } =
+			options.modelRuntime && options.piModel
+				? { runtime: options.modelRuntime, model: options.piModel }
+				: await createLocalModelRuntime(join(outputDir, "pi-agent"), options.baseUrl, options.model, limits);
+		const checker = new CheckerService({
+			task,
+			workspace,
+			outputDir,
+			protectedSnapshot: state.protectedSnapshot,
+			concurrency: limits.checkerConcurrency,
+			command: options.checkCommand,
+			python: options.pythonPath,
+			onExecution: (execution) => log.emit("checker_execution", execution),
+		});
+		const sharedContext = sharedProjectContext(task, workspace);
+		const enhanced = options.mode === "fleet8";
+		const telemetry = enhanced
+			? (options.telemetry ?? new FleetTelemetry(options.baseUrl, PRESSURE_POLL_MS))
+			: undefined;
+		const capabilities = telemetry ? await telemetry.capabilities() : undefined;
+		const queue = telemetry
+			? new AdmissionQueue({
+					permits: Math.max(1, capabilities?.maxActive ?? 8),
+					agingMs: AGING_MS,
+					pressurePollMs: PRESSURE_POLL_MS,
+					pressure: () => telemetry.pressure(),
+					listener: (event) => log.emit("admission", { agent: event.agentId, ...event }),
+				})
+			: undefined;
+		if (telemetry) log.emit("engine", { state: "telemetry", capabilities: capabilities ?? null });
+		const context: AgentContext = {
+			task,
+			workspace,
+			outputDir,
+			agentDir: join(outputDir, "pi-agent"),
+			log,
+			checker,
+			modelRuntime: runtime,
+			model,
+			maxTurnsPerRound: limits.maxTurnsPerAgentRound,
+			fleet: queue ? { queue, sharedContext } : undefined,
+			sessionSettings: options.sessionSettings,
+		};
+		const agents = planAgents(task, options.mode).map((assignment) => new AgentRuntime(assignment, context, resume));
+		return new FestivalRun({
+			options,
+			limits,
+			outputDir,
+			task,
+			workspace,
+			store,
+			state,
+			log,
+			checker,
+			agents,
+			telemetry,
+			queue,
+			sharedContext,
+		});
+	}
+
+	async execute(): Promise<FestivalResult> {
+		await this.options.beforeRun?.({ workspace: this.workspace, outputDir: this.outputDir });
+		// The task clock starts after setup and the hook, so neither counts as task time.
+		this.taskStarted = performance.now();
+		const priorWall = this.state.attempts.reduce((sum, attempt) => sum + attempt.wallBudgetSeconds, 0);
+		this.attempt = { id: randomUUID(), startedAtUnix: Date.now() / 1000, totals: null, wallBudgetSeconds: 0 };
+		this.state.attempts.push(this.attempt);
+		this.store.save(this.state);
+		if (!this.options.resume && this.options.startTimeUnix === undefined) {
+			this.state.startTimeUnix = Date.now() / 1000;
+			this.log.resetClock(this.state.startTimeUnix);
+			this.store.save(this.state);
+		}
+		const onCancel = () => this.abortEverything();
+		this.options.signal?.addEventListener("abort", onCancel, { once: true });
+		if (this.options.signal?.aborted) onCancel();
+		const expire = () => {
+			this.timedOut = true;
+			this.roundAbort.abort();
+			void Promise.all(this.agents.map((agent) => agent.abort()));
+		};
+		const remainingWall = Math.max(0, this.limits.runWallSeconds - priorWall);
+		if (remainingWall === 0) expire();
+		const runTimer = setTimeout(expire, remainingWall * 1000);
+		const checkpointTimer = setInterval(() => {
+			if (this.attempt) this.attempt.wallBudgetSeconds = (performance.now() - this.taskStarted) / 1000;
+			this.checkpointRound?.();
+			this.store.save(this.state);
+		}, 1000);
+		let infrastructureError: string | undefined;
+		try {
+			this.log.emit(this.options.resume ? "run_resume" : "run_start", {
+				taskDir: this.task.taskDir,
+				workspace: this.workspace,
+				agents: this.agents.map((agent) => ({ agent: agent.agentId, owns: agent.assignment.ownedFiles })),
+				limits: this.limits,
+				baseUrl: this.options.baseUrl,
+				model: this.options.model,
+				attemptId: this.attempt.id,
+				totalsScope: "attempt",
+				remainingWallSeconds: remainingWall,
+				accountingComplete: this.state.attempts.slice(0, -1).every((attempt) => attempt.totals !== null),
+				wallBudgetPolicy: "active-time-checkpoints",
+				unknownWallInterval: this.state.attempts.slice(0, -1).some((attempt) => attempt.totals === null),
+			});
+			for (const agent of this.agents) {
+				if (this.stopped()) break;
+				await agent.open();
+			}
+			this.startTelemetry();
+			for (const round of this.task.rounds) {
+				if (this.state.rounds.some((done) => done.round === round.id)) continue;
+				if (this.cancel.signal.aborted || this.timedOut) break;
+				const result = await this.runRound(round);
+				if (!result) break;
+				this.state.rounds.push(result);
+				this.store.save(this.state);
+				if (result.infrastructureError) {
+					infrastructureError = result.infrastructureError;
+					break;
+				}
+			}
+		} catch (error) {
+			if (!this.cancel.signal.aborted && !this.timedOut && !this.roundTimedOut) {
+				infrastructureError = error instanceof Error ? error.message : String(error);
+				this.log.emit("infrastructure_error", { error: infrastructureError });
+				this.roundAbort.abort();
+			}
+		} finally {
+			clearTimeout(runTimer);
+			clearInterval(checkpointTimer);
+			this.options.signal?.removeEventListener("abort", onCancel);
+			this.telemetry?.stop();
+			await Promise.all(this.agents.map((agent) => agent.abort()));
+			await this.checker.drain();
+			this.queue?.dispose();
+			for (const agent of this.agents) agent.dispose();
+		}
+		return this.finish(infrastructureError);
+	}
+
+	private async runRound(round: FestivalRound): Promise<RoundResult | undefined> {
+		this.roundAbort = new AbortController();
+		const progress = this.state.roundProgress[round.id] ?? { wallSeconds: 0, totals: emptyTotals() };
+		const expire = () => {
+			this.roundTimedOut = true;
+			this.roundAbort.abort();
+			void Promise.all(this.agents.map((agent) => agent.abort()));
+		};
+		const remainingWall = Math.max(0, this.limits.roundWallSeconds - progress.wallSeconds);
+		if (remainingWall === 0) expire();
+		const roundTimer = setTimeout(expire, remainingWall * 1000);
+		const before = this.currentTotals();
+		const started = performance.now();
+		const outcomes: Record<string, TaskOutcome[]> = Object.fromEntries(
+			this.agents.map((agent) => [agent.agentId, []]),
+		);
+		this.log.setRound(round.id, round.title);
+		this.log.emit("round_start", { title: round.title });
+		this.log.setPhase("working");
+		this.state.activeRound = round.id;
+		const checkpointRound = () => {
+			const wallSeconds = progress.wallSeconds + (performance.now() - started) / 1000;
+			this.state.roundProgress[round.id] = {
+				wallSeconds,
+				totals: withWall(sumTotals([progress.totals, diffTotals(this.currentTotals(), before)]), wallSeconds),
+			};
+		};
+		this.checkpointRound = checkpointRound;
+		this.store.save(this.state);
+		try {
+			if (this.stopped()) return undefined;
+			if (this.options.mode === "fleet8") await this.runReadyRepairs(round, outcomes);
+			else await this.runBarrierRepairs(round, outcomes);
+			// A user cancellation leaves the round unfinished so a restart can continue it.
+			if (this.stopped()) return undefined;
+			this.log.setPhase("official_check");
+			const official = await this.checker.check(round.id, "official", this.checkSignal());
+			if (this.stopped()) return undefined;
+			throwIfInfrastructure(official);
+			const officialResultPath = join(this.outputDir, "official", `round-${round.id}.json`);
+			mkdirSync(join(this.outputDir, "official"), { recursive: true });
+			writeFileSync(officialResultPath, `${JSON.stringify(official, null, 2)}\n`);
+			for (const agent of this.agents) {
+				agent.recordCheck(official, true);
+				if (agent.ledger.state.pendingTask?.round === round.id) agent.ledger.clearPending();
+			}
+			const pagesPassed = Object.fromEntries(
+				this.task.editableFiles.map((file) => [file, official.pages[file].passed]),
+			);
+			const timedOut = this.roundAbort.signal.aborted;
+			this.log.emit("round_complete", {
+				title: round.title,
+				passed: official.passed,
+				checksPassed: official.checksPassed,
+				checksTotal: official.checksTotal,
+				pagesPassed,
+				timedOut,
+			});
+			this.log.setPhase("done");
+			const wallSeconds = progress.wallSeconds + (performance.now() - started) / 1000;
+			return {
+				round: round.id,
+				title: round.title,
+				wallSeconds,
+				passed: official.passed,
+				checksPassed: official.checksPassed,
+				checksTotal: official.checksTotal,
+				failures: official.failures,
+				pagesPassed,
+				agentOutcomes: outcomes,
+				timedOut,
+				totals: withWall(sumTotals([progress.totals, diffTotals(this.currentTotals(), before)]), wallSeconds),
+				officialResultPath,
+				infrastructureError: official.infrastructureError,
+			};
+		} finally {
+			clearTimeout(roundTimer);
+			// Include cancelled checker execution before persisting the round's consumed budget.
+			if (this.stopped()) await this.checker.drain();
+			checkpointRound();
+			this.checkpointRound = undefined;
+			this.state.activeRound = null;
+			this.store.save(this.state);
+		}
+	}
+
+	// Enhanced: each agent is checked and repaired as soon as it settles, while others keep working.
+	private async runReadyRepairs(round: FestivalRound, outcomes: Record<string, TaskOutcome[]>): Promise<void> {
+		await this.runAgents(async (agent) => {
+			if (this.stopped()) return;
+			const initial = this.initialTask(agent, round);
+			if (initial) outcomes[agent.agentId].push(await agent.runTask(initial, this.checkSignal()));
+			while (this.canRepair(agent, outcomes[agent.agentId])) {
+				const check = await agent.check(round.id, `${agent.agentId}-ready`, false, this.checkSignal());
+				if (this.stopped()) return;
+				throwIfInfrastructure(check);
+				if (agent.ownsPassing(check)) break;
+				outcomes[agent.agentId].push(await agent.runTask(this.repairTask(agent, round, check), this.checkSignal()));
+			}
+		});
+	}
+
+	// Baselines: ordinary concurrent sessions, then one shared check and repairs per pass.
+	private async runBarrierRepairs(round: FestivalRound, outcomes: Record<string, TaskOutcome[]>): Promise<void> {
+		await this.runAgents(async (agent) => {
+			if (this.stopped()) return;
+			const initial = this.initialTask(agent, round);
+			if (initial) outcomes[agent.agentId].push(await agent.runTask(initial, this.checkSignal()));
+		});
+		for (let pass = 0; pass < this.limits.repairPassesPerRound; pass++) {
+			if (this.stopped()) return;
+			this.log.setPhase("repair");
+			const check = await this.checker.check(round.id, `repair-${pass + 1}`, this.checkSignal());
+			if (this.stopped()) return;
+			throwIfInfrastructure(check);
+			for (const agent of this.agents) agent.recordCheck(check, false);
+			const failing = this.agents.filter(
+				(agent) => !agent.ownsPassing(check) && this.canRepair(agent, outcomes[agent.agentId]),
+			);
+			if (failing.length === 0) return;
+			await Promise.all(
+				failing.map(async (agent) =>
+					outcomes[agent.agentId].push(
+						await agent.runTask(this.repairTask(agent, round, check), this.checkSignal()),
+					),
+				),
+			);
+		}
+	}
+
+	private async runAgents(work: (agent: AgentRuntime) => Promise<void>): Promise<void> {
+		const failures: unknown[] = [];
+		await Promise.allSettled(
+			this.agents.map(async (agent) => {
+				try {
+					await work(agent);
+				} catch (error) {
+					failures.push(error);
+					this.roundAbort.abort();
+					await Promise.all(this.agents.map((other) => other.abort()));
+					throw error;
+				}
+			}),
+		);
+		if (failures.length > 0) throw failures[0];
+	}
+
+	// Decide the first task of a round for an agent, honouring a persisted pending task on resume.
+	private initialTask(agent: AgentRuntime, round: FestivalRound): PendingTask | undefined {
+		const ledger = agent.ledger.state;
+		if (ledger.pendingTask?.round === round.id) {
+			const enhanced = this.options.mode === "fleet8";
+			return {
+				...ledger.pendingTask,
+				prompt: resumePrompt(ledger.pendingTask.prompt, enhanced ? agent.ledger.render() : undefined),
+			};
+		}
+		if (ledger.round >= round.id) return undefined;
+		agent.startRound();
+		const prompt =
+			round.id === 1 && this.options.mode !== "fleet8"
+				? firstUserPromptWithContext(this.sharedContext, round, agent.assignment)
+				: roundPrompt(round, agent.assignment);
+		return { round: round.id, kind: "round", prompt, issuedAtUnix: Date.now() / 1000 };
+	}
+
+	private repairTask(agent: AgentRuntime, round: FestivalRound, check: CheckOutcome): PendingTask {
+		return {
+			round: round.id,
+			kind: "repair",
+			prompt: repairPrompt(round, agent.failuresIn(check)),
+			issuedAtUnix: Date.now() / 1000,
+		};
+	}
+
+	private canRepair(agent: AgentRuntime, history: TaskOutcome[]): boolean {
+		const last = history.at(-1);
+		if (last === "aborted" || last === "failed" || last === "turn_limit") return false;
+		return !this.stopped() && agent.repairsThisRound < this.limits.repairPassesPerRound;
+	}
+
+	private stopped(): boolean {
+		return this.cancel.signal.aborted || this.roundAbort.signal.aborted || this.timedOut;
+	}
+
+	private checkSignal(): AbortSignal {
+		return AbortSignal.any([this.cancel.signal, this.roundAbort.signal]);
+	}
+
+	private abortEverything(): void {
+		this.cancel.abort();
+		this.roundAbort.abort();
+		void Promise.all(this.agents.map((agent) => agent.abort()));
+	}
+
+	private startTelemetry(): void {
+		const telemetry = this.telemetry;
+		if (!telemetry) return;
+		let lastEmit = 0;
+		telemetry.start((stats) => {
+			this.queue?.pump();
+			const now = Date.now();
+			if (now - lastEmit < STATS_EVENT_MS) return;
+			lastEmit = now;
+			this.log.emit("engine_stats", {
+				active: stats.active,
+				queued: stats.queued,
+				kvFreeFraction: telemetry.pressure()?.kvFreeFraction ?? null,
+				kvFull: stats.kvFull,
+				sharedPrefixTokens: stats.sharedPrefixTokens,
+				prefillTokens: stats.prefillTokens,
+				generatedTokens: stats.generatedTokens,
+			});
+		});
+	}
+
+	private currentTotals(): Totals {
+		const totals = sumTotals(this.agents.map((agent) => agent.observer.view.totals));
+		return { ...totals, ...this.checker.accounting() };
+	}
+
+	private finish(infrastructureError: string | undefined): FestivalResult {
+		// Monotonic task wall of this execution: excludes setup and beforeRun (and, on resume,
+		// the downtime before the restart).
+		const totals = withWall(this.currentTotals(), (performance.now() - this.taskStarted) / 1000);
+		const attempt = this.attempt;
+		if (!attempt) throw new Error("run attempt was not started");
+		attempt.totals = totals;
+		attempt.wallBudgetSeconds = totals.wallSeconds;
+		const accountingComplete = this.state.attempts.every((entry) => entry.totals !== null);
+		const runTotals = accountingComplete
+			? sumTotals(this.state.attempts.map((entry) => entry.totals as Totals))
+			: null;
+		const rounds = [...this.state.rounds].sort((a, b) => a.round - b.round);
+		const final = rounds.find((round) => round.round === 3);
+		const cancelled = this.cancel.signal.aborted;
+		const result: FestivalResult = {
+			mode: this.options.mode,
+			passed:
+				rounds.length === this.task.rounds.length &&
+				rounds.every((round) => round.passed) &&
+				!infrastructureError &&
+				!cancelled &&
+				!this.stopped(),
+			finalPassed: final?.passed === true,
+			cancelled,
+			timedOut: this.timedOut || this.roundTimedOut,
+			infrastructureError,
+			totals,
+			totalsScope: "attempt",
+			attemptId: attempt.id,
+			runTotals,
+			accountingComplete,
+			wallBudgetPolicy: "active-time-checkpoints",
+			unknownWallInterval: !accountingComplete,
+			rounds,
+			quality: rounds.map((round) => ({
+				round: round.round,
+				checksPassed: round.checksPassed,
+				checksTotal: round.checksTotal,
+				failures: round.failures,
+			})),
+			outputDir: this.outputDir,
+		};
+		this.state.finished = !cancelled && !infrastructureError && rounds.length === this.task.rounds.length;
+		this.store.save(this.state);
+		mkdirSync(join(this.outputDir, "attempts"), { recursive: true });
+		writeAttemptAtomic(join(this.outputDir, "attempts", `${attempt.id}.json`), result);
+		writeJsonAtomic(join(this.outputDir, "summary.json"), result);
+		this.log.emit("run_end", {
+			passed: result.passed,
+			cancelled,
+			timedOut: result.timedOut,
+			infrastructureError: infrastructureError ?? null,
+			totals,
+			totalsScope: result.totalsScope,
+			attemptId: attempt.id,
+			runTotals,
+			accountingComplete,
+			wallBudgetPolicy: result.wallBudgetPolicy,
+			unknownWallInterval: result.unknownWallInterval,
+		});
+		return result;
+	}
+}
+
+function throwIfInfrastructure(check: CheckOutcome): void {
+	if (check.infrastructureError) throw new Error(`checker infrastructure failure: ${check.infrastructureError}`);
+}
