@@ -0,0 +1,204 @@
+// Owns exactly one model server process: refuses occupied ports, waits for health, stops the whole group.
+
+import { type ChildProcess, spawn } from "node:child_process";
+import { closeSync, openSync, readFileSync } from "node:fs";
+import { join } from "node:path";
+import { type EngineProfile, fleetArguments } from "./hardware-profile.ts";
+
+/** How to launch one server. */
+export interface ServerSpec {
+	engine: "fleet" | "vllm";
+	command: string;
+	args: string[];
+	cwd: string;
+	baseUrl: string;
+	logPath: string;
+	env?: Record<string, string>;
+	unsetEnv?: string[];
+	startupTimeoutMs: number;
+}
+
+/** Lifecycle notifications. */
+export type SupervisorState = "starting" | "ready" | "stopping" | "stopped" | "exited";
+
+/** Starts, health-checks and stops one server process group. */
+export class EngineSupervisor {
+	readonly spec: ServerSpec;
+	private child: ChildProcess | undefined;
+	private exitCode: number | null = null;
+	private readonly onState: (state: SupervisorState, detail: Record<string, unknown>) => void;
+
+	constructor(
+		spec: ServerSpec,
+		onState: (state: SupervisorState, detail: Record<string, unknown>) => void = () => {},
+	) {
+		this.spec = spec;
+		this.onState = onState;
+	}
+
+	/** Server process id while running. */
+	get pid(): number | undefined {
+		return this.child?.pid;
+	}
+
+	/** Health endpoint derived from the OpenAI base URL. */
+	get healthUrl(): string {
+		return `${this.spec.baseUrl.replace(/\/+$/, "").replace(/\/v1$/, "")}/health`;
+	}
+
+	/** Launch and wait until /health answers. Refuses if another server already answers. */
+	async start(signal?: AbortSignal): Promise<void> {
+		if (await this.healthy())
+			throw new Error(`refusing to start ${this.spec.engine}: ${this.healthUrl} is already serving`);
+		const env: NodeJS.ProcessEnv = { ...process.env, ...this.spec.env };
+		for (const key of this.spec.unsetEnv ?? []) delete env[key];
+		const log = openSync(this.spec.logPath, "a");
+		try {
+			// A new process group lets stop() terminate helper processes the server spawns.
+			this.child = spawn(this.spec.command, this.spec.args, {
+				cwd: this.spec.cwd,
+				env,
+				stdio: ["ignore", log, log],
+				detached: true,
+			});
+		} finally {
+			closeSync(log);
+		}
+		this.child.on("exit", (code) => {
+			this.exitCode = code ?? -1;
+			this.onState("exited", { code });
+		});
+		this.onState("starting", { pid: this.child.pid, command: [this.spec.command, ...this.spec.args] });
+		const deadline = Date.now() + this.spec.startupTimeoutMs;
+		while (!(await this.healthy())) {
+			if (signal?.aborted) throw new Error("cancelled during engine startup");
+			if (this.exitCode !== null)
+				throw new Error(
+					`${this.spec.engine} exited during startup (code ${this.exitCode}); see ${this.spec.logPath}`,
+				);
+			if (Date.now() > deadline)
+				throw new Error(`${this.spec.engine} did not become healthy in ${this.spec.startupTimeoutMs / 1000}s`);
+			await new Promise((resolve) => setTimeout(resolve, 500));
+		}
+		this.onState("ready", { pid: this.child.pid });
+	}
+
+	/** SIGTERM the process group, then SIGKILL after a grace period. */
+	async stop(graceMs = 15000): Promise<void> {
+		const child = this.child;
+		if (!child || this.exitCode !== null) {
+			this.onState("stopped", {});
+			return;
+		}
+		this.onState("stopping", { pid: child.pid });
+		const exited = new Promise<void>((resolve) => child.once("exit", () => resolve()));
+		this.signalGroup("SIGTERM");
+		const timedOut = await Promise.race([
+			exited.then(() => false),
+			new Promise<boolean>((r) => setTimeout(() => r(true), graceMs)),
+		]);
+		if (timedOut) {
+			this.signalGroup("SIGKILL");
+			await exited;
+		}
+		this.onState("stopped", {});
+	}
+
+	/** Synchronous signal for process-exit handlers, where async work cannot run. */
+	signalSync(signal: NodeJS.Signals): void {
+		if (this.child && this.exitCode === null) this.signalGroup(signal);
+	}
+
+	private signalGroup(signal: NodeJS.Signals): void {
+		const pid = this.child?.pid;
+		if (pid === undefined) return;
+		try {
+			process.kill(-pid, signal);
+		} catch {
+			// Already gone.
+		}
+	}
+
+	private async healthy(): Promise<boolean> {
+		try {
+			const response = await fetch(this.healthUrl, { signal: AbortSignal.timeout(1000) });
+			return response.ok;
+		} catch {
+			return false;
+		}
+	}
+}
+
+/** Fleet server spec for the selected profile. */
+export function fleetServerSpec(options: {
+	repoRoot: string;
+	profile: EngineProfile;
+	port: number;
+	logPath: string;
+	fleetBin?: string;
+	modelPath?: string;
+}): ServerSpec {
+	return {
+		engine: "fleet",
+		command: options.fleetBin ?? join(options.repoRoot, "build/fleet-serve"),
+		args: fleetArguments(options.profile, options.port, options.modelPath),
+		cwd: options.repoRoot,
+		baseUrl: `http://127.0.0.1:${options.port}/v1`,
+		logPath: options.logPath,
+		env: { FLEET_TRACE_STATS: "1" },
+		startupTimeoutMs: 300_000,
+	};
+}
+
+interface VllmConfigFile {
+	command: string[];
+	env?: Record<string, string>;
+	unset_env?: string[];
+	base?: string;
+}
+
+// Native Glimmer tool use on vLLM needs these model-compatibility flags; they are not tuning.
+const VLLM_TOOL_FLAGS: Array<[string, string | undefined]> = [
+	["--reasoning-parser", "muse_glimmer"],
+	["--enable-auto-tool-choice", undefined],
+	["--tool-call-parser", "muse_glimmer"],
+	["--language-model-only", undefined],
+];
+
+/** vLLM server spec from the existing default config, adding the required native-tool flags. */
+export function vllmServerSpec(options: {
+	repoRoot: string;
+	configPath: string;
+	logPath: string;
+	port?: number;
+}): ServerSpec {
+	const config = JSON.parse(readFileSync(options.configPath, "utf8")) as VllmConfigFile;
+	const [command, ...args] = config.command;
+	let baseUrl = config.base ?? "http://127.0.0.1:8090/v1";
+	if (options.port !== undefined) {
+		if (!Number.isInteger(options.port) || options.port < 1 || options.port > 65535)
+			throw new Error("port must be an integer from 1 to 65535");
+		const index = args.indexOf("--port");
+		if (index >= 0) args[index + 1] = String(options.port);
+		else args.push("--port", String(options.port));
+		const url = new URL(baseUrl);
+		url.port = String(options.port);
+		baseUrl = url.toString().replace(/\/$/, "");
+	}
+	for (const [flag, value] of VLLM_TOOL_FLAGS) {
+		if (args.includes(flag)) continue;
+		args.push(flag);
+		if (value !== undefined) args.push(value);
+	}
+	return {
+		engine: "vllm",
+		command,
+		args,
+		cwd: options.repoRoot,
+		baseUrl,
+		logPath: options.logPath,
+		env: config.env,
+		unsetEnv: config.unset_env,
+		startupTimeoutMs: 600_000,
+	};
+}
