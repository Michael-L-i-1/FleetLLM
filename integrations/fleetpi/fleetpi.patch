+++ b/packages/fleetpi/src/interactive.ts
@@ -0,0 +1,96 @@
+// `fleetpi` interactive: owns the Fleet engine and runs the real Pi TUI with the Fleet extension.
+
+import { mkdirSync, writeFileSync } from "node:fs";
+import { homedir } from "node:os";
+import { join } from "node:path";
+import { type ExtensionAPI, type InlineExtension, main } from "@earendil-works/pi-coding-agent";
+import { EngineSupervisor, fleetServerSpec } from "./engine/engine-supervisor.ts";
+import { currentHost, selectProfile } from "./engine/hardware-profile.ts";
+import { AdmissionQueue } from "./fleet/admission-queue.ts";
+import { fleetExtension } from "./fleet/fleet-extension.ts";
+import { FleetTelemetry } from "./fleet/fleet-telemetry.ts";
+import { LOCAL_PROVIDER, localModelsJson } from "./model/local-model.ts";
+
+/** Options for the interactive command. */
+export interface InteractiveOptions {
+	repoRoot: string;
+	port: number;
+	fleetBin?: string;
+	modelPath?: string;
+	piArgs: string[];
+}
+
+// Pi resolves its agent directory from this variable (APP_NAME "pi" + _CODING_AGENT_DIR).
+const AGENT_DIR_ENV = "PI_CODING_AGENT_DIR";
+
+/** Start Fleet, run Pi interactively against it, and always stop the engine afterwards. */
+export async function runInteractive(options: InteractiveOptions): Promise<void> {
+	const selection = selectProfile(currentHost());
+	if ("error" in selection) throw new Error(selection.error);
+	const { profile } = selection;
+	const home = join(homedir(), ".fleetpi");
+	const agentDir = join(home, "agent");
+	mkdirSync(join(home, "logs"), { recursive: true });
+	mkdirSync(agentDir, { recursive: true });
+	const spec = fleetServerSpec({
+		repoRoot: options.repoRoot,
+		profile,
+		port: options.port,
+		logPath: join(home, "logs", "engine.log"),
+		fleetBin: options.fleetBin,
+		modelPath: options.modelPath,
+	});
+	const supervisor = new EngineSupervisor(spec);
+	process.stderr.write(`FleetPi: starting Fleet (${profile.id}); engine log ${spec.logPath}\n`);
+	// Pi's TUI may exit the process directly; the engine must not outlive it.
+	const onExit = () => supervisor.signalSync("SIGTERM");
+	process.on("exit", onExit);
+	await supervisor.start();
+	writeFileSync(
+		join(agentDir, "models.json"),
+		`${JSON.stringify(localModelsJson(spec.baseUrl, profile.modelId, { contextWindow: profile.contextWindow, maxOutputTokens: profile.maxTokens }), null, 2)}\n`,
+	);
+	process.env[AGENT_DIR_ENV] = agentDir;
+	const telemetry = new FleetTelemetry(spec.baseUrl);
+	const capabilities = await telemetry.capabilities();
+	const queue = new AdmissionQueue({
+		permits: capabilities?.maxActive ?? profile.maxActive,
+		agingMs: 20_000,
+		pressurePollMs: 500,
+		pressure: () => telemetry.pressure(),
+	});
+	try {
+		await main(["--model", `${LOCAL_PROVIDER}/${profile.modelId}`, "--thinking", "low", ...options.piArgs], {
+			extensionFactories: [
+				fleetExtension({ agentId: "interactive", queue, priority: () => "continue" }),
+				engineStatusExtension(telemetry, queue),
+			],
+		});
+	} finally {
+		telemetry.stop();
+		queue.dispose();
+		process.off("exit", onExit);
+		await supervisor.stop();
+	}
+}
+
+/** Footer status with live engine activity and KV headroom. */
+function engineStatusExtension(telemetry: FleetTelemetry, queue: AdmissionQueue): InlineExtension {
+	return {
+		name: "fleetpi-engine-status",
+		factory: (pi: ExtensionAPI) => {
+			pi.on("session_start", (_event, ctx) => {
+				telemetry.stop();
+				telemetry.start((stats) => {
+					queue.pump();
+					const kv = telemetry.pressure()?.kvFreeFraction;
+					ctx.ui.setStatus(
+						"fleet",
+						`fleet: active ${stats.active ?? "?"} queued ${stats.queued ?? "?"} · KV free ${kv === null || kv === undefined ? "?" : `${Math.round(kv * 100)}%`} · shared prefix ${stats.sharedPrefixTokens ?? "?"}`,
+					);
+				});
+			});
+			pi.on("session_shutdown", () => telemetry.stop());
+		},
+	};
+}
diff --git a/packages/fleetpi/src/ledger/progress-ledger.ts b/packages/fleetpi/src/ledger/progress-ledger.ts
new file mode 100644
index 0000000..852ab40
--- /dev/null
+++ b/packages/fleetpi/src/ledger/progress-ledger.ts
@@ -0,0 +1,269 @@
+// Durable per-agent progress (completed pages, checks, pending task) that survives compaction and restart.
+
+import { existsSync, readFileSync } from "node:fs";
+import { join } from "node:path";
+import type { SessionManager } from "@earendil-works/pi-coding-agent";
+import type { CheckOutcome } from "../checker/checker-service.ts";
+import { writeJsonAtomic } from "../run/atomic-json.ts";
+import { sha256 } from "../workspace/workspace.ts";
+
+/** Custom session entry type carrying ledger snapshots inside the Pi session file. */
+export const LEDGER_ENTRY_TYPE = "fleetpi-ledger";
+
+/** Custom message type used when the enhanced mode re-injects the ledger into model context. */
+export const LEDGER_MESSAGE_TYPE = "fleetpi-ledger-context";
+
+/** Progress of one owned page. */
+export interface PageProgress {
+	passedRound: number | null;
+	sha256: string | null;
+	/** True only while the current bytes still match the checked snapshot. */
+	verified: boolean;
+	failures: string[];
+}
+
+/** Work the agent has been given but not yet finished. */
+export interface PendingTask {
+	round: number;
+	kind: "round" | "repair";
+	prompt: string;
+	issuedAtUnix: number;
+}
+
+/** One recorded check. */
+export interface LedgerCheck {
+	round: number;
+	official: boolean;
+	passed: boolean;
+	checksPassed: number;
+	checksTotal: number;
+	ownedPassed: boolean;
+	atUnix: number;
+}
+
+/** Serialized ledger. */
+export interface LedgerState {
+	version: 2;
+	agentId: string;
+	ownedFiles: string[];
+	round: number;
+	pages: Record<string, PageProgress>;
+	checks: LedgerCheck[];
+	pendingTask: PendingTask | null;
+	compactions: number;
+	sessionFile: string | null;
+	turnsThisRound: number;
+	repairsThisRound: number;
+}
+
+const MAX_CHECKS = 24;
+
+/** Ledger persisted atomically to its own JSON file and mirrored into the session file. */
+export class ProgressLedger {
+	readonly path: string;
+	private current: LedgerState;
+	private workspace: string | undefined;
+
+	constructor(path: string, state: LedgerState) {
+		this.path = path;
+		this.current = state;
+	}
+
+	/** A fresh ledger for an agent. */
+	static create(path: string, agentId: string, ownedFiles: readonly string[]): ProgressLedger {
+		const pages = Object.fromEntries(
+			ownedFiles.map((file) => [file, { passedRound: null, sha256: null, verified: false, failures: [] }]),
+		);
+		return new ProgressLedger(path, {
+			version: 2,
+			agentId,
+			ownedFiles: [...ownedFiles],
+			round: 0,
+			pages,
+			checks: [],
+			pendingTask: null,
+			compactions: 0,
+			sessionFile: null,
+			turnsThisRound: 0,
+			repairsThisRound: 0,
+		});
+	}
+
+	/** Load a persisted ledger file, if present. */
+	static load(path: string): ProgressLedger | undefined {
+		if (!existsSync(path)) return undefined;
+		const state = JSON.parse(readFileSync(path, "utf8")) as LedgerState;
+		if (state.version !== 2) throw new Error(`unsupported ledger version in ${path}`);
+		return new ProgressLedger(path, state);
+	}
+
+	/** Current state (treat as read-only). */
+	get state(): LedgerState {
+		return this.current;
+	}
+
+	/** Bind live content so context summaries cannot advertise stale passing checks. */
+	bindWorkspace(workspace: string): void {
+		this.workspace = workspace;
+		this.refreshVerification();
+	}
+
+	/** A write invalidates the checked status until the new bytes are evaluated. */
+	invalidate(file: string): void {
+		const page = this.current.pages[file];
+		if (!page?.verified) return;
+		this.current = { ...this.current, pages: { ...this.current.pages, [file]: { ...page, verified: false } } };
+		this.save();
+	}
+
+	/** Reset durable budgets only when releasing a new round. */
+	startRound(): void {
+		this.current = { ...this.current, turnsThisRound: 0, repairsThisRound: 0 };
+		this.save();
+	}
+
+	/** Persist a completed assistant turn before another request can be admitted. */
+	recordTurns(turns: number): void {
+		this.current = { ...this.current, turnsThisRound: turns };
+		this.save();
+	}
+
+	/** Record that a round or repair task was issued. */
+	setPending(task: PendingTask): void {
+		// Replaying the pending repair on resume consumes its original repair slot.
+		const replay =
+			this.current.pendingTask?.issuedAtUnix === task.issuedAtUnix &&
+			this.current.pendingTask.round === task.round &&
+			this.current.pendingTask.kind === task.kind;
+		this.current = {
+			...this.current,
+			round: Math.max(this.current.round, task.round),
+			pendingTask: task,
+			repairsThisRound: this.current.repairsThisRound + (task.kind === "repair" && !replay ? 1 : 0),
+		};
+		this.save();
+	}
+
+	/** Mark the pending task finished. */
+	clearPending(): void {
+		this.current = { ...this.current, pendingTask: null };
+		this.save();
+	}
+
+	/** Record a check outcome against this agent's pages. */
+	recordCheck(outcome: CheckOutcome, hashes: Record<string, string>, official: boolean): void {
+		const pages = { ...this.current.pages };
+		for (const file of this.current.ownedFiles) {
+			const page = outcome.pages[file];
+			const previous = pages[file];
+			pages[file] = page.passed
+				? { passedRound: outcome.round, sha256: hashes[file] ?? null, verified: true, failures: [] }
+				: {
+						passedRound:
+							previous.passedRound !== null && previous.passedRound < outcome.round
+								? previous.passedRound
+								: null,
+						sha256: hashes[file] ?? null,
+						verified: false,
+						failures: page.failures.slice(0, 20),
+					};
+		}
+		const check: LedgerCheck = {
+			round: outcome.round,
+			official,
+			passed: outcome.passed,
+			checksPassed: outcome.checksPassed,
+			checksTotal: outcome.checksTotal,
+			ownedPassed: this.current.ownedFiles.every((file) => outcome.pages[file].passed),
+			atUnix: Date.now() / 1000,
+		};
+		this.current = { ...this.current, pages, checks: [...this.current.checks, check].slice(-MAX_CHECKS) };
+		this.refreshVerification();
+		this.save();
+	}
+
+	/** Count a compaction of this agent's session. */
+	recordCompaction(): void {
+		this.current = { ...this.current, compactions: this.current.compactions + 1 };
+		this.save();
+	}
+
+	/** Remember which Pi session file holds this agent's transcript. */
+	setSessionFile(sessionFile: string | undefined): void {
+		this.current = { ...this.current, sessionFile: sessionFile ?? null };
+		this.save();
+	}
+
+	/** Pages whose checks all passed in the current round. */
+	completedPages(): string[] {
+		this.refreshVerification();
+		return this.current.ownedFiles.filter((file) => {
+			const page = this.current.pages[file];
+			return page.verified && page.passedRound === this.current.round;
+		});
+	}
+
+	/** Model-facing summary used by the enhanced mode after compaction and on resume. */
+	render(): string {
+		this.refreshVerification();
+		const lines = [`Progress ledger for ${this.current.agentId} (authoritative, maintained by the FleetPi runner):`];
+		lines.push(`Current round: ${this.current.round}. Owned files: ${this.current.ownedFiles.join(", ")}.`);
+		for (const file of this.current.ownedFiles) {
+			const page = this.current.pages[file];
+			const status =
+				page.verified && page.passedRound === this.current.round
+					? "all checks pass this round"
+					: "not verified for current bytes this round; recheck";
+			lines.push(
+				`- ${file}: ${status}${page.failures.length ? `; last failures: ${page.failures.slice(0, 6).join(" | ")}` : ""}`,
+			);
+		}
+		const last = this.current.checks.at(-1);
+		if (last)
+			lines.push(`Last check: round ${last.round}, ${last.checksPassed}/${last.checksTotal} site checks passed.`);
+		if (this.current.pendingTask) {
+			lines.push(`Pending task (${this.current.pendingTask.kind}, round ${this.current.pendingTask.round}):`);
+			lines.push(this.current.pendingTask.prompt);
+		} else {
+			lines.push("No pending task.");
+		}
+		return lines.join("\n");
+	}
+
+	private refreshVerification(): void {
+		if (!this.workspace) return;
+		let changed = false;
+		const pages = { ...this.current.pages };
+		for (const file of this.current.ownedFiles) {
+			const page = pages[file];
+			if (!page.verified) continue;
+			const path = join(this.workspace, file);
+			if (!existsSync(path) || sha256(readFileSync(path)) !== page.sha256) {
+				pages[file] = { ...page, verified: false };
+				changed = true;
+			}
+		}
+		if (changed) {
+			this.current = { ...this.current, pages };
+			this.save();
+		}
+	}
+
+	/** Atomically write the ledger file. */
+	save(): void {
+		writeJsonAtomic(this.path, this.current);
+	}
+}
+
+/** Mirror the ledger into the Pi session file as a context-invisible custom entry. */
+export function appendLedgerEntry(sessionManager: SessionManager, ledger: ProgressLedger): void {
+	sessionManager.appendCustomEntry(LEDGER_ENTRY_TYPE, ledger.state);
+}
+
+/** The latest ledger snapshot stored in a session file, used when the ledger file is lost. */
+export function latestLedgerEntry(sessionManager: SessionManager): LedgerState | undefined {
+	const entry = sessionManager
+		.getEntries()
+		.findLast((candidate) => candidate.type === "custom" && candidate.customType === LEDGER_ENTRY_TYPE);
+	return entry?.type === "custom" ? (entry.data as LedgerState) : undefined;
+}
