+// Configuration regressions only: no process or model is started.
+import { mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, describe, expect, it } from "vitest";
+import { vllmServerSpec } from "../src/engine/engine-supervisor.ts";
+
+const cleanup: string[] = [];
+afterEach(() => {
+	for (const dir of cleanup.splice(0)) rmSync(dir, { recursive: true, force: true });
+});
+function spec(command: string[], port?: number) {
+	const root = mkdtempSync(join(tmpdir(), "fleetpi-spec-"));
+	cleanup.push(root);
+	const configPath = join(root, "config.json");
+	writeFileSync(configPath, JSON.stringify({ command, base: "http://127.0.0.1:8090/v1" }));
+	return vllmServerSpec({ repoRoot: root, configPath, logPath: join(root, "engine.log"), port });
+}
+describe("vLLM local server address", () => {
+	it("keeps an explicit CLI port consistent with the health/API address", () => {
+		const result = spec(["vllm", "serve", "model", "--port", "8090"], 9091);
+		expect(result.args.slice(result.args.indexOf("--port"), result.args.indexOf("--port") + 2)).toEqual([
+			"--port",
+			"9091",
+		]);
+		expect(result.baseUrl).toBe("http://127.0.0.1:9091/v1");
+	});
+	it("adds a missing port and retains required model compatibility flags", () => {
+		const result = spec(["vllm", "serve", "model"], 9092);
+		expect(result.args).toContain("9092");
+		expect(result.args).toContain("--tool-call-parser");
+		expect(result.baseUrl).toBe("http://127.0.0.1:9092/v1");
+	});
+	it("rejects an invalid port before starting any process", () => {
+		for (const port of [-1, 0, 65536, NaN, 8090.5])
+			expect(() => spec(["vllm", "serve", "model"], port)).toThrow(/port/);
+	});
+});
diff --git a/packages/fleetpi/test/festival-runner.test.ts b/packages/fleetpi/test/festival-runner.test.ts
new file mode 100644
index 0000000..086b9fb
--- /dev/null
+++ b/packages/fleetpi/test/festival-runner.test.ts
@@ -0,0 +1,146 @@
+import { existsSync, readdirSync, readFileSync } from "node:fs";
+import { join, relative } from "node:path";
+import { type AssistantMessage, getCurrentSystemPrompt, type TranscriptContext } from "@earendil-works/pi-ai";
+import { fauxAssistantMessage, fauxToolCall } from "@earendil-works/pi-ai/compat";
+import { afterEach, describe, expect, it } from "vitest";
+import type { CheckCommand } from "../src/checker/checker-service.ts";
+import { FleetTelemetry } from "../src/fleet/fleet-telemetry.ts";
+import { runFestival } from "../src/run/festival-runner.ts";
+import { loadFestivalTask } from "../src/task/festival-task.ts";
+import type { FleetEvent } from "../src/types.ts";
+import { createFaux, rawCheckResult, TASK_DIR, tempDir, textOf, toolTurn } from "./support.ts";
+
+const task = loadFestivalTask(TASK_DIR);
+
+function lastUserText(context: TranscriptContext): string {
+	const user = context.messages.findLast((message) => message.role === "user");
+	return user && "content" in user ? textOf(user.content) : "";
+}
+
+function isSummary(context: TranscriptContext): boolean {
+	return getCurrentSystemPrompt(context.messages).includes("context summarization assistant");
+}
+
+// Round-2 checks fail on pages/home.html until its content contains "fixed".
+const homeFailsInRoundTwo: CheckCommand = async ({ workspace, round }) => {
+	const home = readFileSync(join(workspace, "pages/home.html"), "utf8");
+	return rawCheckResult(task, round, round === 2 && !home.includes("fixed") ? ["pages/home.html"] : []);
+};
+
+const noTelemetry = (baseUrl: string) =>
+	new FleetTelemetry(baseUrl, 50, async () => new Response("not implemented", { status: 404 }));
+
+describe("runFestival (model-free)", () => {
+	const cleanups: Array<() => void> = [];
+	afterEach(() => {
+		while (cleanups.length > 0) cleanups.pop()?.();
+	});
+
+	async function run(mode: "fleet8" | "vllm1", factory: (context: TranscriptContext) => AssistantMessage) {
+		const { dir, cleanup } = tempDir(`runner-${mode}`);
+		cleanups.push(cleanup);
+		const faux = await createFaux(`runner-${mode}`, dir);
+		cleanups.push(faux.cleanup);
+		faux.faux.setResponses(Array.from({ length: 200 }, () => (context: TranscriptContext) => factory(context)));
+		const events: FleetEvent[] = [];
+		const outputDir = join(dir, "run");
+		const result = await runFestival({
+			mode,
+			taskDir: TASK_DIR,
+			outputDir,
+			baseUrl: "http://127.0.0.1:1/v1",
+			model: "faux-glimmer",
+			onEvent: (event) => events.push(event),
+			modelRuntime: faux.runtime,
+			piModel: faux.model,
+			checkCommand: homeFailsInRoundTwo,
+			telemetry: noTelemetry("http://127.0.0.1:1/v1"),
+		});
+		return { result, events, outputDir };
+	}
+
+	it("single-agent baseline: ordinary context in the first user message, barrier repair, durable outputs", async () => {
+		const systemPrompts: string[] = [];
+		const firstUsers: string[] = [];
+		let repaired = false;
+		let wroteRound1 = false;
+		const { result, events, outputDir } = await run("vllm1", (context) => {
+			if (isSummary(context)) return fauxAssistantMessage("## Goal\nsummary");
+			systemPrompts.push(getCurrentSystemPrompt(context.messages));
+			const user = lastUserText(context);
+			if (firstUsers.length === 0) firstUsers.push(user);
+			if (user.startsWith("# ") && !wroteRound1) {
+				wroteRound1 = true;
+				return toolTurn(
+					fauxToolCall("write", {
+						path: "pages/home.html",
+						content: '<article id="page-home"><h1>Lantern Commons Arts Weekend</h1></article>',
+					}),
+				);
+			}
+			if (user.includes("still fail") && !repaired) {
+				repaired = true;
+				return toolTurn(
+					fauxToolCall("write", { path: "pages/home.html", content: '<article id="page-home">fixed</article>' }),
+				);
+			}
+			return fauxAssistantMessage("Done.");
+		});
+		expect(result.passed).toBe(true);
+		expect(result.rounds.map((round) => [round.round, round.passed, round.checksPassed])).toEqual([
+			[1, true, 17],
+			[2, true, 17],
+			[3, true, 17],
+		]);
+		expect(repaired).toBe(true);
+		expect(firstUsers[0]).toContain("## brief.md");
+		expect(systemPrompts.every((prompt) => !prompt.includes("## brief.md"))).toBe(true);
+		const names = events.map((event) => event.event);
+		expect(names.filter((name) => name === "round_start")).toHaveLength(3);
+		expect(names.filter((name) => name === "round_complete")).toHaveLength(3);
+		const writes = events.filter((event) => event.event === "file_write");
+		expect(writes.map((event) => [event.round, event.path])).toEqual([
+			[1, "pages/home.html"],
+			[2, "pages/home.html"],
+		]);
+		expect(events.some((event) => event.event === "admission")).toBe(false);
+		const lines = readFileSync(join(outputDir, "events.jsonl"), "utf8").trim().split("\n");
+		expect(lines.length).toBe(events.length);
+		const sessions = readdirSync(join(outputDir, "sessions", "site"));
+		expect(sessions.some((name) => name.endsWith(".jsonl"))).toBe(true);
+		expect(relative(join(outputDir, "workspace"), join(outputDir, "sessions")).startsWith("..")).toBe(true);
+		expect(existsSync(join(outputDir, "summary.json"))).toBe(true);
+		expect(JSON.parse(readFileSync(join(outputDir, "state.json"), "utf8")).finished).toBe(true);
+		expect(readFileSync(join(outputDir, "calls.jsonl"), "utf8").trim().split("\n").length).toBe(result.totals.calls);
+	});
+
+	it("enhanced fleet8: stable shared prefix in the system prompt, admission, ready repair of the failing owner", async () => {
+		const systemPrompts = new Set<string>();
+		const repairedBy: string[] = [];
+		const { result, events } = await run("fleet8", (context) => {
+			if (isSummary(context)) return fauxAssistantMessage("## Goal\nsummary");
+			const system = getCurrentSystemPrompt(context.messages);
+			systemPrompts.add(system);
+			const user = lastUserText(context);
+			const last = context.messages.at(-1);
+			if (user.includes("still fail") && last?.role === "user") {
+				repairedBy.push(user.includes("home/390px") ? "home" : "other");
+				return toolTurn(
+					fauxToolCall("write", { path: "pages/home.html", content: '<article id="page-home">fixed</article>' }),
+				);
+			}
+			return fauxAssistantMessage("Done.");
+		});
+		expect(result.passed).toBe(true);
+		expect(repairedBy).toEqual(["home"]);
+		// One byte-identical system prompt for all eight agents, carrying the brief.
+		expect(systemPrompts.size).toBe(1);
+		expect([...systemPrompts][0]).toContain("## brief.md");
+		const grants = events.filter((event) => event.event === "admission" && event.action === "grant");
+		expect(grants.length).toBeGreaterThanOrEqual(24);
+		const readyChecks = events.filter((event) => event.event === "check" && event.official === false);
+		expect(readyChecks.length).toBeGreaterThanOrEqual(24);
+		const officialRound2 = events.find((event) => event.event === "round_complete" && event.round === 2);
+		expect(officialRound2).toMatchObject({ passed: true });
+	});
+});
diff --git a/packages/fleetpi/test/festival-task.test.ts b/packages/fleetpi/test/festival-task.test.ts
new file mode 100644
index 0000000..b003a0d
--- /dev/null
+++ b/packages/fleetpi/test/festival-task.test.ts
@@ -0,0 +1,79 @@
+import { join } from "node:path";
+import { describe, expect, it } from "vitest";
+import { adaptInstruction, loadFestivalTask, planAgents } from "../src/task/festival-task.ts";
+import {
+	firstUserPromptWithContext,
+	PI_TOOL_SENTENCE,
+	roundPrompt,
+	sharedProjectContext,
+} from "../src/task/prompts.ts";
+import { TASK_DIR } from "./support.ts";
+
+describe("festival task manifest", () => {
+	const task = loadFestivalTask(TASK_DIR);
+
+	it("loads eight editable pages and three cumulative rounds", () => {
+		expect(task.editableFiles).toHaveLength(8);
+		expect(task.rounds.map((round) => round.id)).toEqual([1, 2, 3]);
+		expect(task.fixtureDir).toBe(join(TASK_DIR, "fixture"));
+	});
+
+	it("removes every toy JSON protocol sentence from every instruction", () => {
+		const texts = task.rounds.flatMap((round) => [round.instructions, ...Object.values(round.workerInstructions)]);
+		for (const text of texts) {
+			expect(text).not.toMatch(/JSON tools|done action|write action/i);
+		}
+		expect(task.rounds[2].instructions).toContain("The focused appearance must differ");
+	});
+
+	it("fails closed when toy wording would survive", () => {
+		expect(() => adaptInstruction("Return a done action now.")).toThrow(/toy JSON protocol/);
+	});
+});
+
+describe("fair decomposition", () => {
+	const task = loadFestivalTask(TASK_DIR);
+
+	it("gives eight disjoint single-page owners in the parallel modes", () => {
+		for (const mode of ["fleet8", "vllm8"] as const) {
+			const agents = planAgents(task, mode);
+			expect(agents).toHaveLength(8);
+			const owned = agents.flatMap((agent) => agent.ownedFiles);
+			expect(new Set(owned).size).toBe(8);
+			expect(owned.sort()).toEqual([...task.editableFiles].sort());
+		}
+	});
+
+	it("gives the single agent all eight pages", () => {
+		const [agent] = planAgents(task, "vllm1");
+		expect(agent.ownedFiles.sort()).toEqual([...task.editableFiles].sort());
+	});
+});
+
+describe("prompts", () => {
+	const task = loadFestivalTask(TASK_DIR);
+	const workspace = task.fixtureDir;
+	const [home, lineup] = planAgents(task, "vllm8");
+
+	it("keeps shared project context byte-identical across agents", () => {
+		const context = sharedProjectContext(task, workspace);
+		expect(context).toContain("content.json");
+		expect(firstUserPromptWithContext(context, task.rounds[0], home).startsWith(context)).toBe(true);
+		expect(firstUserPromptWithContext(context, task.rounds[0], lineup).startsWith(context)).toBe(true);
+	});
+
+	it("releases only the current round's stakeholder changes", () => {
+		const first = roundPrompt(task.rounds[0], home);
+		expect(first).toContain("Round 1");
+		expect(first).not.toContain("#087f7a");
+		expect(first).not.toContain("data-help-strip");
+		expect(roundPrompt(task.rounds[1], home)).toContain("#087f7a");
+		expect(first).toContain(PI_TOOL_SENTENCE);
+	});
+
+	it("lists every assignment for the single agent", () => {
+		const [single] = planAgents(task, "vllm1");
+		const prompt = roundPrompt(task.rounds[0], single);
+		for (const file of task.editableFiles) expect(prompt).toContain(`Assignment for ${file}:`);
+	});
+});
diff --git a/packages/fleetpi/test/integration-fixes.test.ts b/packages/fleetpi/test/integration-fixes.test.ts
new file mode 100644
index 0000000..09f7032
--- /dev/null
+++ b/packages/fleetpi/test/integration-fixes.test.ts
@@ -0,0 +1,159 @@
+import { existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import type { AssistantMessage, AssistantMessageEvent } from "@earendil-works/pi-ai";
+import { fauxAssistantMessage } from "@earendil-works/pi-ai/compat";
+import { afterEach, describe, expect, it } from "vitest";
+import type { CheckCommand } from "../src/checker/checker-service.ts";
+import { FleetTelemetry } from "../src/fleet/fleet-telemetry.ts";
+import { localModelsJson } from "../src/model/local-model.ts";
+import { runFestival } from "../src/run/festival-runner.ts";
+import { isNonEmptyDelta } from "../src/run/session-observer.ts";
+import { loadFestivalTask } from "../src/task/festival-task.ts";
+import { DEFAULT_LIMITS } from "../src/types.ts";
+import { sha256 } from "../src/workspace/workspace.ts";
+import { createFaux, createRunFixture, fakeChecker, rawCheckResult, TASK_DIR, tempDir } from "./support.ts";
+
+const task = loadFestivalTask(TASK_DIR);
+
+describe("common profile", () => {
+	it("uses 4096 output tokens and a 96000-token context for every mode", () => {
+		expect(DEFAULT_LIMITS.maxOutputTokens).toBe(4096);
+		expect(DEFAULT_LIMITS.contextWindow).toBe(96000);
+		const model = localModelsJson("http://127.0.0.1:1/v1", "glimmer-mlx4", DEFAULT_LIMITS).providers["fleetpi-local"]
+			.models[0];
+		expect([model.maxTokens, model.contextWindow]).toEqual([4096, 96000]);
+	});
+});
+
+describe("first streamed delta", () => {
+	const partial = fauxAssistantMessage("") as AssistantMessage;
+	it("counts only non-empty content, reasoning or tool-argument deltas", () => {
+		const event = (type: string, delta?: string) =>
+			({ type, contentIndex: 0, delta, partial }) as AssistantMessageEvent;
+		expect(isNonEmptyDelta(event("start"))).toBe(false);
+		expect(isNonEmptyDelta(event("text_delta", ""))).toBe(false);
+		expect(isNonEmptyDelta(event("toolcall_start"))).toBe(false);
+		expect(isNonEmptyDelta(event("text_delta", "a"))).toBe(true);
+		expect(isNonEmptyDelta(event("thinking_delta", "x"))).toBe(true);
+		expect(isNonEmptyDelta(event("toolcall_delta", "{"))).toBe(true);
+	});
+});
+
+describe("checker snapshot consistency", () => {
+	const cleanups: Array<() => void> = [];
+	afterEach(() => {
+		while (cleanups.length > 0) cleanups.pop()?.();
+	});
+
+	it("memoizes and reports hashes of the exact bytes checked, even if the workspace changes during the check", async () => {
+		let workspace = "";
+		const seen: string[] = [];
+		const command: CheckCommand = async ({ workspace: snapshot, round }) => {
+			seen.push(readFileSync(join(snapshot, "pages/home.html"), "utf8"));
+			// An agent writes while the checker runs; the snapshot must be unaffected.
+			writeFileSync(join(workspace, "pages/home.html"), '<article id="page-home">late write</article>');
+			return rawCheckResult(task, round);
+		};
+		const fixture = createRunFixture("snapshot", "vllm8", command);
+		cleanups.push(fixture.cleanup);
+		workspace = fixture.workspace;
+		const original = readFileSync(join(workspace, "pages/home.html"), "utf8");
+		const outcome = await fixture.checker.check(1, "a");
+		expect(seen).toEqual([original]);
+		expect(outcome.pageHashes["pages/home.html"]).toBe(sha256(original));
+		// The late write is new content: it must be re-checked, not served from the memo.
+		const again = await fixture.checker.check(1, "b");
+		expect(again.memoized).toBe(false);
+		expect(again.pageHashes["pages/home.html"]).toBe(sha256('<article id="page-home">late write</article>'));
+	});
+
+	it("memo hits keep the original snapshot hashes", async () => {
+		const checker = fakeChecker((round) => rawCheckResult(task, round));
+		const fixture = createRunFixture("snapshot-memo", "vllm8", checker.command);
+		cleanups.push(fixture.cleanup);
+		const first = await fixture.checker.check(1, "a");
+		const second = await fixture.checker.check(1, "b");
+		expect(second.memoized).toBe(true);
+		expect(second.pageHashes).toEqual(first.pageHashes);
+		expect(checker.calls()).toBe(1);
+	});
+});
+
+describe("runFestival setup for a supervising caller", () => {
+	const cleanups: Array<() => void> = [];
+	afterEach(() => {
+		while (cleanups.length > 0) cleanups.pop()?.();
+	});
+
+	it("accepts a pre-created logs/ dir, awaits beforeRun before any model call, and excludes it from task wall", async () => {
+		const { dir, cleanup } = tempDir("before-run");
+		cleanups.push(cleanup);
+		const faux = await createFaux("before-run", dir);
+		cleanups.push(faux.cleanup);
+		let calls = 0;
+		faux.faux.setResponses(
+			Array.from({ length: 50 }, () => () => {
+				calls++;
+				return fauxAssistantMessage("Done.");
+			}),
+		);
+		const outputDir = join(dir, "run");
+		mkdirSync(join(outputDir, "logs"), { recursive: true });
+		writeFileSync(join(outputDir, "logs", "engine.log"), "server started\n");
+		const hookSeen: Array<{ calls: number; workspaceReady: boolean; events: boolean }> = [];
+		const hookMs = 300;
+		const result = await runFestival({
+			mode: "vllm1",
+			taskDir: TASK_DIR,
+			outputDir,
+			baseUrl: "http://127.0.0.1:1/v1",
+			model: "faux-glimmer",
+			modelRuntime: faux.runtime,
+			piModel: faux.model,
+			checkCommand: async ({ round }) => rawCheckResult(task, round),
+			telemetry: new FleetTelemetry("http://127.0.0.1:1/v1", 50, async () => new Response("", { status: 404 })),
+			beforeRun: async ({ workspace, outputDir: out }) => {
+				hookSeen.push({
+					calls,
+					workspaceReady: existsSync(join(workspace, "pages/home.html")) && out === outputDir,
+					events:
+						existsSync(join(out, "events.jsonl")) &&
+						readFileSync(join(out, "events.jsonl"), "utf8").includes("run_start"),
+				});
+				await new Promise((resolve) => setTimeout(resolve, hookMs));
+			},
+		});
+		expect(hookSeen).toEqual([{ calls: 0, workspaceReady: true, events: false }]);
+		expect(calls).toBeGreaterThan(0);
+		expect(result.passed).toBe(true);
+		expect(readFileSync(join(outputDir, "logs", "engine.log"), "utf8")).toBe("server started\n");
+		// The task clock starts after the hook: the first event is not delayed by hookMs.
+		const first = JSON.parse(
+			readFileSync(join(outputDir, "events.jsonl"), "utf8")
+				.split("\n")
+				.find((line) => line.includes("run_start")) as string,
+		);
+		expect(first.elapsed).toBeLessThan(hookMs / 1000);
+		expect(result.totals.wallSeconds).toBeGreaterThan(0);
+		expect(result.totals.workflowOutputTokensPerSecond).toBeCloseTo(
+			result.totals.outputTokens / result.totals.wallSeconds,
+			6,
+		);
+	});
+
+	it("still refuses an output directory with anything besides setup logs", async () => {
+		const { dir, cleanup } = tempDir("not-empty");
+		cleanups.push(cleanup);
+		mkdirSync(join(dir, "logs"));
+		writeFileSync(join(dir, "stale.json"), "{}");
+		await expect(
+			runFestival({
+				mode: "vllm1",
+				taskDir: TASK_DIR,
+				outputDir: dir,
+				baseUrl: "http://127.0.0.1:1/v1",
+				model: "m",
+			}),
+		).rejects.toThrow(/not empty \(stale\.json\)/);
+	});
+});
diff --git a/packages/fleetpi/test/ledger-compaction.test.ts b/packages/fleetpi/test/ledger-compaction.test.ts
new file mode 100644
index 0000000..a57f882
--- /dev/null
+++ b/packages/fleetpi/test/ledger-compaction.test.ts
@@ -0,0 +1,125 @@
+import { existsSync, rmSync } from "node:fs";
+import { join } from "node:path";
+import { fauxAssistantMessage, fauxToolCall } from "@earendil-works/pi-ai/compat";
+import { SessionManager } from "@earendil-works/pi-coding-agent";
+import { afterEach, describe, expect, it } from "vitest";
+import { LEDGER_ENTRY_TYPE, LEDGER_MESSAGE_TYPE, type PendingTask } from "../src/ledger/progress-ledger.ts";
+import type { SessionSettings } from "../src/session/open-session.ts";
+import {
+	agentContext,
+	createFaux,
+	createRunFixture,
+	fakeChecker,
+	HOME,
+	openAgent,
+	rawCheckResult,
+	scriptTurns,
+	textOf,
+	toolTurn,
+} from "./support.ts";
+
+// keepRecentTokens 1 makes Pi's real compaction summarize everything before the newest turn.
+const SMALL_COMPACTION: SessionSettings = {
+	cacheWarming: "off",
+	compaction: { enabled: true, reserveTokens: 16384, keepRecentTokens: 1 },
+};
+
+const PENDING: PendingTask = {
+	round: 3,
+	kind: "round",
+	prompt: "Round 3: add the help strip to pages/home.html.",
+	issuedAtUnix: 1,
+};
+
+describe("durable progress through two compactions and a restart", () => {
+	const cleanups: Array<() => void> = [];
+	afterEach(() => {
+		while (cleanups.length > 0) cleanups.pop()?.();
+	});
+
+	async function firstLife(name: string, enhanced: boolean) {
+		const checker = fakeChecker((round) => rawCheckResult(fixture.task, round));
+		const fixture = createRunFixture(name, enhanced ? "fleet8" : "vllm8", checker.command);
+		cleanups.push(fixture.cleanup);
+		const faux = await createFaux(name, fixture.outputDir);
+		cleanups.push(faux.cleanup);
+		const context = agentContext(fixture, faux, { enhanced, sessionSettings: SMALL_COMPACTION });
+		const agent = await openAgent(HOME, context);
+		const script = scriptTurns(faux, [
+			toolTurn(fauxToolCall("check_site", {})),
+			fauxAssistantMessage("Round 1 done."),
+			fauxAssistantMessage("Round 2 partial work."),
+		]);
+		await agent.runTask({ round: 1, kind: "round", prompt: "Round 1: build the home page.", issuedAtUnix: 0 });
+		await agent.piSession.compact();
+		await agent.runTask({ round: 2, kind: "round", prompt: "Round 2: add the family notice.", issuedAtUnix: 0 });
+		await agent.piSession.compact();
+		expect(script.remaining()).toBe(0);
+		expect(script.summaries()).toBeGreaterThanOrEqual(2);
+		// Simulate the process dying right after round 3 was released to this agent.
+		agent.ledger.setPending(PENDING);
+		const sessionFile = agent.piSession.sessionFile as string;
+		agent.dispose();
+		return { fixture, faux, context, sessionFile };
+	}
+
+	function entriesOf(sessionFile: string) {
+		return SessionManager.open(sessionFile).getEntries();
+	}
+
+	it("keeps completed pages, checks and the pending task across restart (enhanced re-injects the ledger)", async () => {
+		const { faux, context, sessionFile } = await firstLife("ledger-fleet", true);
+		const entries = entriesOf(sessionFile);
+		expect(entries.filter((entry) => entry.type === "compaction")).toHaveLength(2);
+		const injected = entries.filter(
+			(entry) => entry.type === "custom_message" && entry.customType === LEDGER_MESSAGE_TYPE,
+		);
+		expect(injected).toHaveLength(2);
+		expect(entries.some((entry) => entry.type === "custom" && entry.customType === LEDGER_ENTRY_TYPE)).toBe(true);
+
+		const restarted = await openAgent(HOME, context, true);
+		cleanups.push(() => restarted.dispose());
+		expect(restarted.piSession.sessionFile).toBe(sessionFile);
+		const ledger = restarted.ledger.state;
+		expect(ledger.compactions).toBe(2);
+		expect(ledger.pendingTask).toEqual(PENDING);
+		expect(ledger.pages["pages/home.html"].passedRound).toBe(1);
+		expect(ledger.checks.map((check) => check.round)).toEqual([1]);
+		// The newest injected ledger survives in the rebuilt model context after the second compaction.
+		const contextTexts = restarted.piSession.messages.map((message) =>
+			"content" in message ? textOf(message.content) : "",
+		);
+		expect(contextTexts.some((text) => text.includes("Progress ledger for home"))).toBe(true);
+
+		scriptTurns(faux, [fauxAssistantMessage("Help strip added.")]);
+		const outcome = await restarted.runTask(PENDING);
+		expect(outcome).toBe("settled");
+		expect(restarted.ledger.state.pendingTask).toBeNull();
+	});
+
+	it("restores the ledger from the session-file mirror when the ledger file is lost", async () => {
+		const { context, fixture } = await firstLife("ledger-mirror", true);
+		const ledgerFile = join(fixture.outputDir, "ledger", "home.json");
+		// The pending task was written to the file only; drop the file and recover from the mirror,
+		// which holds the last state appended at the end of the round 2 task.
+		rmSync(ledgerFile);
+		const restarted = await openAgent(HOME, context, true);
+		cleanups.push(() => restarted.dispose());
+		expect(existsSync(ledgerFile)).toBe(true);
+		expect(restarted.ledger.state.pages["pages/home.html"].passedRound).toBe(1);
+		expect(restarted.ledger.state.round).toBe(2);
+	});
+
+	it("baselines persist the same ledger but keep ordinary Pi context (no injection)", async () => {
+		const { context, sessionFile } = await firstLife("ledger-baseline", false);
+		const entries = entriesOf(sessionFile);
+		expect(entries.filter((entry) => entry.type === "compaction")).toHaveLength(2);
+		expect(entries.some((entry) => entry.type === "custom_message" && entry.customType === LEDGER_MESSAGE_TYPE)).toBe(
+			false,
+		);
+		const restarted = await openAgent(HOME, context, true);
+		cleanups.push(() => restarted.dispose());
+		expect(restarted.ledger.state.compactions).toBe(2);
+		expect(restarted.ledger.state.pendingTask).toEqual(PENDING);
+	});
+});
diff --git a/packages/fleetpi/test/path-guard.test.ts b/packages/fleetpi/test/path-guard.test.ts
new file mode 100644
index 0000000..4329cd4
--- /dev/null
+++ b/packages/fleetpi/test/path-guard.test.ts
@@ -0,0 +1,94 @@
+import { readFileSync, symlinkSync, writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { afterEach, describe, expect, it } from "vitest";
+import { loadFestivalTask, planAgents } from "../src/task/festival-task.ts";
+import { type GuardDenial, PathGuard, PathGuardError } from "../src/workspace/path-guard.ts";
+import { prepareWorkspace } from "../src/workspace/workspace.ts";
+import { TASK_DIR, tempDir } from "./support.ts";
+
+describe("PathGuard", () => {
+	const cleanups: Array<() => void> = [];
+	afterEach(() => {
+		while (cleanups.length > 0) cleanups.pop()?.();
+	});
+
+	function setup(owned: string[]) {
+		const { dir, cleanup } = tempDir("guard");
+		cleanups.push(cleanup);
+		const task = loadFestivalTask(TASK_DIR);
+		const workspace = join(dir, "workspace");
+		prepareWorkspace(task, workspace);
+		const denials: GuardDenial[] = [];
+		const writes: string[] = [];
+		const guard = new PathGuard(workspace, owned, {
+			onDenied: (denial) => denials.push(denial),
+			onWrite: (path) => writes.push(path),
+		});
+		return { dir, workspace, guard, denials, writes };
+	}
+
+	it("writes and edits only owned files", async () => {
+		const { workspace, guard, writes } = setup(["pages/home.html"]);
+		await guard.writeOperations().writeFile(join(workspace, "pages/home.html"), '<article id="page-home"></article>');
+		expect(writes).toEqual(["pages/home.html"]);
+		await expect(guard.writeOperations().writeFile(join(workspace, "pages/lineup.html"), "x")).rejects.toBeInstanceOf(
+			PathGuardError,
+		);
+		await expect(guard.editOperations().readFile(join(workspace, "pages/lineup.html"))).rejects.toBeInstanceOf(
+			PathGuardError,
+		);
+		await expect(guard.editOperations().access(join(workspace, "pages/faq.html"))).rejects.toThrow(
+			/read-only for you/,
+		);
+	});
+
+	it("protects the brief, content and anything outside the workspace", async () => {
+		const { dir, workspace, guard, denials } = setup(["pages/home.html"]);
+		const write = guard.writeOperations().writeFile;
+		await expect(write(join(workspace, "brief.md"), "x")).rejects.toThrow(/read-only/);
+		await expect(write(join(workspace, "content.json"), "{}")).rejects.toThrow(/read-only/);
+		await expect(write(join(workspace, "../escape.html"), "x")).rejects.toThrow(/outside the project workspace/);
+		await expect(write("/tmp/fleetpi-escape.html", "x")).rejects.toThrow(/outside/);
+		await expect(guard.readOperations().readFile(join(dir, "outside.txt"))).rejects.toThrow(/outside/);
+		expect(denials.map((denial) => denial.kind)).toEqual([
+			"not-writable",
+			"not-writable",
+			"outside-workspace",
+			"outside-workspace",
+			"outside-workspace",
+		]);
+		expect(readFileSync(join(workspace, "content.json"), "utf8")).not.toBe("{}");
+	});
+
+	it("refuses symlink escapes for reads and symlinked owned files for writes", async () => {
+		const { dir, workspace, guard } = setup(["pages/home.html"]);
+		writeFileSync(join(dir, "secret.txt"), "secret");
+		symlinkSync(join(dir, "secret.txt"), join(workspace, "pages/link.txt"));
+		await expect(guard.readOperations().readFile(join(workspace, "pages/link.txt"))).rejects.toThrow(/outside/);
+		// An "owned" name that is really a symlink to another agent's page is still refused.
+		symlinkSync(join(workspace, "pages/faq.html"), join(workspace, "pages/alias.html"));
+		const aliasGuard = new PathGuard(workspace, ["pages/alias.html"]);
+		await expect(aliasGuard.writeOperations().writeFile(join(workspace, "pages/alias.html"), "x")).rejects.toThrow(
+			/read-only|symbolic/,
+		);
+		expect(readFileSync(join(workspace, "pages/faq.html"), "utf8")).not.toBe("x");
+	});
+
+	it("reads and lists everything inside the workspace", async () => {
+		const { workspace, guard } = setup(["pages/home.html"]);
+		const brief = await guard.readOperations().readFile(join(workspace, "brief.md"));
+		expect(brief.length).toBeGreaterThan(0);
+		expect(await guard.lsOperations().readdir(join(workspace, "pages"))).toContain("faq.html");
+		await expect(guard.lsOperations().readdir("/")).rejects.toThrow(/outside/);
+	});
+
+	it("is the same policy in every mode: writable equals the owned files", () => {
+		const task = loadFestivalTask(TASK_DIR);
+		const { workspace } = setup([]);
+		for (const mode of ["fleet8", "vllm8", "vllm1"] as const) {
+			for (const agent of planAgents(task, mode)) {
+				expect(new PathGuard(workspace, agent.ownedFiles).writable).toEqual(agent.ownedFiles);
+			}
+		}
+	});
+});
