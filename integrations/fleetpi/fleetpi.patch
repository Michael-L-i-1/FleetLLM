+import { writeFileSync } from "node:fs";
+import { join } from "node:path";
+import { afterEach, describe, expect, it } from "vitest";
+import { summarize } from "../src/checker/checker-service.ts";
+import { loadFestivalTask } from "../src/task/festival-task.ts";
+import { ProtectedFileError } from "../src/workspace/workspace.ts";
+import { createRunFixture, fakeChecker, rawCheckResult, TASK_DIR } from "./support.ts";
+
+describe("checker result grouping", () => {
+	const task = loadFestivalTask(TASK_DIR);
+
+	it("attributes checks to pages by name prefix and keeps site-wide checks global", () => {
+		const outcome = summarize(task, 2, rawCheckResult(task, 2, ["pages/faq.html"]));
+		expect(outcome.passed).toBe(false);
+		expect(outcome.checksTotal).toBe(17);
+		expect(outcome.pages["pages/faq.html"]).toMatchObject({ passed: false, checksPassed: 1, checksTotal: 2 });
+		expect(outcome.pages["pages/home.html"].passed).toBe(true);
+		expect(outcome.pages["pages/faq.html"].failures).toEqual(["faq/390px: primary action: requirement not met"]);
+		expect(outcome.globalFailures).toEqual([]);
+	});
+
+	it("treats output without checks as an infrastructure failure", () => {
+		const outcome = summarize(task, 1, { passed: false, failures: ["Browser check did not return JSON"] });
+		expect(outcome.infrastructureError).toBe("checker returned no checks");
+	});
+});
+
+describe("CheckerService", () => {
+	const cleanups: Array<() => void> = [];
+	afterEach(() => {
+		while (cleanups.length > 0) cleanups.pop()?.();
+	});
+
+	it("memoizes identical workspace content per round, and re-checks after a write", async () => {
+		const checker = fakeChecker((round) => rawCheckResult(fixture.task, round));
+		const fixture = createRunFixture("memo", "vllm8", checker.command);
+		cleanups.push(fixture.cleanup);
+		const first = await fixture.checker.check(1, "a");
+		const second = await fixture.checker.check(1, "b");
+		expect(first.memoized).toBe(false);
+		expect(second.memoized).toBe(true);
+		expect(checker.calls()).toBe(1);
+		await fixture.checker.check(2, "c");
+		expect(checker.calls()).toBe(2);
+		writeFileSync(join(fixture.workspace, "pages/home.html"), '<article id="page-home"><h1>Changed</h1></article>');
+		await fixture.checker.check(1, "d");
+		expect(checker.calls()).toBe(3);
+	});
+
+	it("refuses to score when a protected workspace file changed", async () => {
+		const checker = fakeChecker((round) => rawCheckResult(fixture.task, round));
+		const fixture = createRunFixture("tamper", "vllm8", checker.command);
+		cleanups.push(fixture.cleanup);
+		writeFileSync(join(fixture.workspace, "content.json"), "{}");
+		await expect(fixture.checker.check(1, "x")).rejects.toBeInstanceOf(ProtectedFileError);
+		expect(checker.calls()).toBe(0);
+	});
+
+	it("does not memoize infrastructure failures", async () => {
+		let fail = true;
+		const checker = fakeChecker((round) => {
+			if (fail) throw new Error("chromium missing");
+			return rawCheckResult(fixture.task, round);
+		});
+		const fixture = createRunFixture("infra", "vllm8", checker.command);
+		cleanups.push(fixture.cleanup);
+		const broken = await fixture.checker.check(1, "x");
+		expect(broken.infrastructureError).toBe("chromium missing");
+		fail = false;
+		const fixed = await fixture.checker.check(1, "y");
+		expect(fixed.memoized).toBe(false);
+		expect(fixed.passed).toBe(true);
+	});
+});
