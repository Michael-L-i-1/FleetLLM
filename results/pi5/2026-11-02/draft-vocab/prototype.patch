index 904a990..02b865a 100644
--- a/src/cpu.c
+++ b/src/cpu.c
@@ -54,0 +55 @@ typedef struct { double energy; int block; } prune_score;
+typedef struct { float score; int tile; } draft_candidate;
@@ -64,0 +66,2 @@ typedef struct cpu_state {
+    int draft_vocab_limit, *draft_tiles, n_draft_tiles;
+    draft_candidate *draft_candidates; size_t draft_candidate_cap;
@@ -447,0 +451,94 @@ static void argmax_rows(const float *logits, int rows, int vocab, int32_t *out)
+// Experimental draft-only shortlist: full target logits rank four-token
+// weight tiles. All target rows still use the full vocabulary. A missed draft
+// proposal changes acceptance/performance, never the verified greedy answer.
+static int draft_candidate_cmp(const void *a, const void *b) {
+    const draft_candidate *x = a, *y = b;
+    return x->score > y->score ? -1 : x->score < y->score ? 1 : (x->tile > y->tile) - (x->tile < y->tile);
+}
+static int draft_tile_cmp(const void *a, const void *b) {
+    int x = *(const int *)a, y = *(const int *)b;
+    return (x > y) - (x < y);
+}
+static void draft_shortlist(cpu_state *s, const float *logits, int n, int vocab) {
+    int count = (vocab + 3) / 4;
+    if ((size_t)count > s->draft_candidate_cap) {
+        s->draft_candidate_cap = count;
+        s->draft_candidates = realloc(s->draft_candidates, count * sizeof(draft_candidate));
+    }
+    float *maxima = malloc(n * sizeof(float));
+    for (int row = 0; row < n; row++) {
+        maxima[row] = -INFINITY;
+        for (int j = 0; j < vocab; j++)
+            if (logits[(size_t)row * vocab + j] > maxima[row]) maxima[row] = logits[(size_t)row * vocab + j];
+    }
+    for (int i = 0; i < count; i++) {
+        float score = -INFINITY;
+        for (int row = 0; row < n; row++)
+            for (int j = i * 4; j < (i + 1) * 4 && j < vocab; j++)
+                if (logits[(size_t)row * vocab + j] - maxima[row] > score)
+                    score = logits[(size_t)row * vocab + j] - maxima[row];
+        s->draft_candidates[i] = (draft_candidate){ score, i };
+    }
+    free(maxima);
+    int keep = (s->draft_vocab_limit + 3) / 4;
+    if (keep > count) keep = count;
+    // Partition only the top tiles; sorting all ~50k vocabulary tiles at every
+    // target step costs more than selecting them. Total ordering breaks ties.
+    int lo = 0, hi = count - 1;
+    while (lo < hi && keep < count) {
+        draft_candidate pivot = s->draft_candidates[(lo + hi) / 2];
+        int i = lo, j = hi;
+        while (i <= j) {
+            while (draft_candidate_cmp(&s->draft_candidates[i], &pivot) < 0) i++;
+            while (draft_candidate_cmp(&s->draft_candidates[j], &pivot) > 0) j--;
+            if (i <= j) {
+                draft_candidate tmp = s->draft_candidates[i];
+                s->draft_candidates[i++] = s->draft_candidates[j];
+                s->draft_candidates[j--] = tmp;
+            }
+        }
+        if (keep - 1 <= j) hi = j;
+        else if (keep - 1 >= i) lo = i;
+        else break;
+    }
+    s->draft_tiles = realloc(s->draft_tiles, keep * sizeof(int));
+    s->n_draft_tiles = keep;
+    for (int i = 0; i < keep; i++) s->draft_tiles[i] = s->draft_candidates[i].tile;
+    qsort(s->draft_tiles, keep, sizeof(int), draft_tile_cmp);
+}
+typedef struct {
+    cpu_state *s;
+    const qmat *w;
+    const int *tiles;
+    float *logits;
+} draft_head_job;
+static void draft_head_tiles(void *ctx, int begin, int end) {
+    draft_head_job *j = ctx;
+    for (int i = begin; i < end;) {
+        int first = j->tiles[i] * 4, last = first + 4;
+        while (++i < end && j->tiles[i] * 4 == last) last += 4;
+        if (last > j->w->rows) last = j->w->rows;
+        if (j->w->gpu) cq_matmul_rows(j->w->gpu, &j->s->act, j->logits, j->w->rows, first, last);
+        else {
+            mm_job job = { j->w, j->s->in, j->logits, j->s->in_n, j->w->rows };
+            mm_rows(&job, first, last);
+        }
+    }
+}
+static void draft_short_head(cpu_state *s, const qmat *w, const int *tiles, int count, float *logits, int32_t *out) {
+    if (w->gpu && !s->act_ok) {
+        cq_quantize_group(&s->act, s->in, s->in_n, s->in_cols, s->activation_group);
+        s->act_ok = true;
+    }
+    draft_head_job job = { s, w, tiles, logits };
+    parallel_for(count, 16, draft_head_tiles, &job);
+    for (int t = 0; t < s->in_n; t++) {
+        int best = tiles[0] * 4;
+        const float *row = logits + (size_t)t * w->rows;
+        for (int i = 0; i < count; i++)
+            for (int r = tiles[i] * 4; r < tiles[i] * 4 + 4 && r < w->rows; r++)
+                if (row[r] > row[best]) best = r;
+        out[t] = best;
+    }
+}
+
