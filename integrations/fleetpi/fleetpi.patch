@@ -0,0 +1,128 @@
+// Loads the protected festival task manifest and derives agent assignments for each mode.
+
+import { readFileSync } from "node:fs";
+import { join, resolve } from "node:path";
+import type { FestivalMode } from "../types.ts";
+
+/** One stakeholder round as released to agents. */
+export interface FestivalRound {
+	id: number;
+	title: string;
+	instructions: string;
+	workerInstructions: Record<string, string>;
+}
+
+/** One page role from the manifest. */
+export interface FestivalRole {
+	name: string;
+	file: string;
+}
+
+/** The parsed task manifest with Pi-adapted instruction text. */
+export interface FestivalTask {
+	taskDir: string;
+	fixtureDir: string;
+	id: string;
+	title: string;
+	briefFile: string;
+	editableFiles: string[];
+	readOnlyFiles: string[];
+	roles: FestivalRole[];
+	rounds: FestivalRound[];
+}
+
+/** Who owns which files in one mode. */
+export interface AgentAssignment {
+	agentId: string;
+	name: string;
+	ownedFiles: string[];
+}
+
+interface RawTask {
+	id: string;
+	title: string;
+	fixture: string;
+	brief_file: string;
+	editable_files: string[];
+	read_only_files: string[];
+	workers: Array<{ name: string; file: string }>;
+	rounds: Array<{ id: number; title: string; instructions: string; worker_instructions: Record<string, string> }>;
+}
+
+/** Parse task.json and adapt every instruction for Pi's native tools. */
+export function loadFestivalTask(taskDir: string): FestivalTask {
+	const dir = resolve(taskDir);
+	const raw = parseRawTask(readFileSync(join(dir, "task.json"), "utf8"));
+	return {
+		taskDir: dir,
+		fixtureDir: join(dir, raw.fixture),
+		id: raw.id,
+		title: raw.title,
+		briefFile: raw.brief_file,
+		editableFiles: [...raw.editable_files],
+		readOnlyFiles: [...raw.read_only_files],
+		roles: raw.workers.map((worker) => ({ name: worker.name, file: worker.file })),
+		rounds: raw.rounds.map((round) => ({
+			id: round.id,
+			title: round.title,
+			instructions: adaptInstruction(round.instructions),
+			workerInstructions: Object.fromEntries(
+				Object.entries(round.worker_instructions).map(([file, text]) => [file, adaptInstruction(text)]),
+			),
+		})),
+	};
+}
+
+// task.json is a trust boundary: the runner must not start with a malformed manifest.
+function parseRawTask(text: string): RawTask {
+	const value = JSON.parse(text) as RawTask;
+	const editable = new Set(value.editable_files);
+	if (editable.size !== 8) throw new Error("festival task must declare exactly eight editable files");
+	if (value.workers.length !== 8 || value.workers.some((worker) => !editable.has(worker.file))) {
+		throw new Error("festival task workers must own the eight editable files");
+	}
+	if (value.rounds.length !== 3) throw new Error("festival task must declare three rounds");
+	for (const round of value.rounds) {
+		for (const file of editable) {
+			if (typeof round.worker_instructions[file] !== "string") {
+				throw new Error(`round ${round.id} lacks instructions for ${file}`);
+			}
+		}
+	}
+	return value;
+}
+
+// These two sentences describe the retired toy JSON harness. Pi uses its own
+// native tool protocol, so they are removed for every mode alike.
+const TOY_PROTOCOL_SENTENCES = [
+	"Use the harness JSON tools: put HTML/CSS source in the write action content field, never return raw HTML as your response.",
+	"Finish with the done action when your assigned work is complete.",
+];
+
+const TOY_PROTOCOL_WORDING = /harness JSON|done action|write action|JSON tools/i;
+
+/** Remove toy-harness protocol sentences; fail closed if any toy wording remains. */
+export function adaptInstruction(text: string): string {
+	let adapted = text;
+	for (const sentence of TOY_PROTOCOL_SENTENCES) adapted = adapted.split(sentence).join("");
+	adapted = adapted.replace(/[ \t]{2,}/g, " ").trim();
+	if (TOY_PROTOCOL_WORDING.test(adapted)) {
+		throw new Error(`task text still references the toy JSON protocol: ${adapted.slice(0, 160)}`);
+	}
+	return adapted;
+}
+
+/** Page name used by the browser checker for an editable file, e.g. pages/home.html -> home. */
+export function pageNameOf(file: string): string {
+	const match = /^pages\/([a-z]+)\.html$/.exec(file);
+	if (!match) throw new Error(`not a festival page fragment: ${file}`);
+	return match[1];
+}
+
+/** Disjoint ownership: eight single-page roles, or one agent owning all eight pages. */
+export function planAgents(task: FestivalTask, mode: FestivalMode): AgentAssignment[] {
+	if (mode === "vllm1") {
+		return [{ agentId: "site", name: "Site designer", ownedFiles: [...task.editableFiles] }];
+	}
+	return task.roles.map((role) => ({ agentId: pageNameOf(role.file), name: role.name, ownedFiles: [role.file] }));
+}
diff --git a/packages/fleetpi/src/task/prompts.ts b/packages/fleetpi/src/task/prompts.ts
new file mode 100644
index 0000000..f51aa32
--- /dev/null
+++ b/packages/fleetpi/src/task/prompts.ts
@@ -0,0 +1,59 @@
+// Builds the exact prompt text every mode sends; modes differ only in where shared context sits.
+
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import type { AgentAssignment, FestivalRound, FestivalTask } from "./festival-task.ts";
+
+/** The one Pi-native tool sentence that replaces the toy JSON protocol in every mode. */
+export const PI_TOOL_SENTENCE =
+	"Change only your owned page files with the read, edit and write tools, run check_site to test them against the real cumulative browser checks for this round, and when your assigned work is complete reply with a short plain-text summary (never raw HTML).";
+
+/** Byte-stable shared project context: the brief and the supplied content, identical for every agent. */
+export function sharedProjectContext(task: FestivalTask, workspace: string): string {
+	const brief = readFileSync(join(workspace, task.briefFile), "utf8").trimEnd();
+	const files = task.readOnlyFiles.filter((file) => file !== task.briefFile);
+	const supplied = files.map((file) => `## ${file}\n\n${readFileSync(join(workspace, file), "utf8").trimEnd()}`);
+	return [
+		`# ${task.title}`,
+		"Shared project context for every page agent. The files below are read-only workspace files.",
+		`Editable page fragments (each owned by exactly one agent): ${task.editableFiles.join(", ")}.`,
+		`## ${task.briefFile}\n\n${brief}`,
+		...supplied,
+	].join("\n\n");
+}
+
+/** The prompt that releases one round to one agent. */
+export function roundPrompt(round: FestivalRound, assignment: AgentAssignment): string {
+	const assignments = assignment.ownedFiles.map((file) => `Assignment for ${file}: ${round.workerInstructions[file]}`);
+	return [
+		`Round ${round.id}: ${round.title}`,
+		round.instructions,
+		`Your role: ${assignment.name}. You own ${assignment.ownedFiles.join(", ")}. Other files are read-only for you.`,
+		...assignments,
+		PI_TOOL_SENTENCE,
+	].join("\n\n");
+}
+
+/** Baseline round-1 prompt: ordinary Pi puts the shared context in the first user message. */
+export function firstUserPromptWithContext(context: string, round: FestivalRound, assignment: AgentAssignment): string {
+	return `${context}\n\n---\n\n${roundPrompt(round, assignment)}`;
+}
+
+/** Runner-issued follow-up when official checks still fail on an agent's pages (all modes alike). */
+export function repairPrompt(round: FestivalRound, failures: readonly string[]): string {
+	const listed = failures.slice(0, 40).map((failure) => `- ${failure}`);
+	const more = failures.length > listed.length ? [`- ... and ${failures.length - listed.length} more`] : [];
+	return [
+		`Round ${round.id} browser checks still fail on your pages:`,
+		[...listed, ...more].join("\n"),
+		"Fix these with read/edit/write on your owned files, run check_site, then reply with a short plain-text summary.",
+	].join("\n\n");
+}
+
+/** Prompt used after a restart to continue the persisted pending task. */
+export function resumePrompt(pendingTask: string, ledgerText: string | undefined): string {
+	const parts = ["The run was restarted. Continue your pending task."];
+	if (ledgerText) parts.push(ledgerText);
+	parts.push(`Pending task:\n\n${pendingTask}`);
+	return parts.join("\n\n");
+}
diff --git a/packages/fleetpi/src/tools/common-tools.ts b/packages/fleetpi/src/tools/common-tools.ts
