@@ -0,0 +1,296 @@
+#!/usr/bin/env node
+// fleetpi command line: interactive Pi on Fleet, and the festival demo / three-way comparison.
+
+import { mkdirSync, writeFileSync } from "node:fs";
+import { dirname, join, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { parseArgs } from "node:util";
+import { EngineSupervisor, fleetServerSpec, type ServerSpec, vllmServerSpec } from "./engine/engine-supervisor.ts";
+import { currentHost, MAC_M5PRO_48GB_GLIMMER, selectProfile } from "./engine/hardware-profile.ts";
+import { runInteractive } from "./interactive.ts";
+import { type FestivalResult, runFestival } from "./run/festival-runner.ts";
+import type { FestivalMode, FleetEvent } from "./types.ts";
+import { Dashboard } from "./ui/dashboard.ts";
+
+const USAGE = `Usage:
+  fleetpi [pi arguments...]            start Fleet and open Pi interactively
+  fleetpi demo festival [options]      run the Lantern Commons festival demo
+
+Festival options:
+  --mode fleet8|vllm8|vllm1   mode to run (default fleet8)
+  --compare                   run fleet8, vllm8 and vllm1 sequentially (one server at a time)
+  --output DIR                output directory (default results/fleetpi/runs/<timestamp>)
+  --task-dir DIR              festival task (default demos/agent-task-bench/tasks/festival-site)
+  --base-url URL --model ID   use an already running server instead of starting one
+  --port N                    server port (default 8090)
+  --fleet-bin PATH            Fleet server binary (default build/fleet-serve)
+  --model-path PATH           Glimmer snapshot directory
+  --vllm-config PATH          vLLM config (default integrations/fleetpi/configs/vllm-default.local.json)
+  --resume                    continue a cancelled run in --output
+  --json                      print events.jsonl lines and the final result as JSON
+  --repo-root DIR             repository root (default: derived from this package)
+`;
+
+const MODES: readonly FestivalMode[] = ["fleet8", "vllm8", "vllm1"];
+
+async function cli(argv: string[]): Promise<number> {
+	if (argv[0] === "--help" || argv[0] === "help") {
+		process.stdout.write(USAGE);
+		return 0;
+	}
+	if (argv[0] === "demo") {
+		if (argv[1] !== "festival") {
+			process.stderr.write(`unknown demo: ${argv[1] ?? "(none)"}\n${USAGE}`);
+			return 2;
+		}
+		return demoFestival(argv.slice(2));
+	}
+	await runInteractive({ repoRoot: defaultRepoRoot(), port: 8090, piArgs: argv });
+	return 0;
+}
+
+interface DemoOptions {
+	modes: FestivalMode[];
+	output: string;
+	taskDir: string;
+	repoRoot: string;
+	port: number;
+	baseUrl?: string;
+	model?: string;
+	fleetBin?: string;
+	modelPath?: string;
+	vllmConfig: string;
+	resume: boolean;
+	json: boolean;
+}
+
+async function demoFestival(args: string[]): Promise<number> {
+	const options = parseDemoOptions(args);
+	if ("error" in options) {
+		process.stderr.write(`${options.error}\n${USAGE}`);
+		return 2;
+	}
+	if (options.modes.includes("fleet8") && !options.baseUrl) {
+		const selection = selectProfile(currentHost());
+		if ("error" in selection) {
+			process.stderr.write(`${selection.error}\n`);
+			return 2;
+		}
+	}
+	const controller = new AbortController();
+	let supervisor: EngineSupervisor | undefined;
+	let interrupts = 0;
+	const onSignal = () => {
+		interrupts++;
+		if (interrupts === 1) {
+			process.stderr.write(
+				"\nfleetpi: cancelling; saving sessions and stopping the engine (Ctrl-C again to kill)\n",
+			);
+			controller.abort();
+			return;
+		}
+		supervisor?.signalSync("SIGKILL");
+		process.exit(130);
+	};
+	process.on("SIGINT", onSignal);
+	process.on("SIGTERM", onSignal);
+	const results = new Map<FestivalMode, FestivalResult>();
+	try {
+		for (const mode of options.modes) {
+			if (controller.signal.aborted) break;
+			const outputDir = options.modes.length > 1 ? join(options.output, mode) : options.output;
+			mkdirSync(join(outputDir, "logs"), { recursive: true });
+			const ui = createUi(options.json, `FleetPi festival · ${mode}`);
+			try {
+				const server = options.baseUrl ? undefined : serverFor(mode, options, outputDir);
+				supervisor = server
+					? new EngineSupervisor(server, (state, detail) => ui.event({ event: "engine", state, ...detail }))
+					: undefined;
+				await supervisor?.start(controller.signal);
+				const result = await runFestival({
+					mode,
+					taskDir: options.taskDir,
+					outputDir,
+					baseUrl: server?.baseUrl ?? (options.baseUrl as string),
+					model: options.model ?? MAC_M5PRO_48GB_GLIMMER.modelId,
+					resume: options.resume,
+					signal: controller.signal,
+					onEvent: (event) => ui.event(event),
+				});
+				results.set(mode, result);
+			} finally {
+				await supervisor?.stop();
+				supervisor = undefined;
+				ui.close();
+			}
+		}
+	} catch (error) {
+		process.stderr.write(`fleetpi: ${error instanceof Error ? error.message : String(error)}\n`);
+		return 1;
+	} finally {
+		process.off("SIGINT", onSignal);
+		process.off("SIGTERM", onSignal);
+	}
+	if (options.modes.length > 1) writeComparison(options.output, results);
+	printResults(results, options.json);
+	const all = [...results.values()];
+	return all.length === options.modes.length && all.every((result) => !result.infrastructureError && !result.cancelled)
+		? 0
+		: 1;
+}
+
+function parseDemoOptions(args: string[]): DemoOptions | { error: string } {
+	const { values } = parseArgs({
+		args,
+		options: {
+			mode: { type: "string" },
+			compare: { type: "boolean" },
+			output: { type: "string" },
+			"task-dir": { type: "string" },
+			"base-url": { type: "string" },
+			model: { type: "string" },
+			port: { type: "string" },
+			"fleet-bin": { type: "string" },
+			"model-path": { type: "string" },
+			"vllm-config": { type: "string" },
+			resume: { type: "boolean" },
+			json: { type: "boolean" },
+			"repo-root": { type: "string" },
+		},
+		strict: true,
+	});
+	const mode = (values.mode ?? "fleet8") as FestivalMode;
+	if (!MODES.includes(mode)) return { error: `unknown mode ${values.mode}` };
+	if (values.compare && values.mode) return { error: "--compare runs all three modes; omit --mode" };
+	if (values.compare && values.resume)
+		return {
+			error: "Resume the interrupted case with --mode fleet8|vllm8|vllm1 --resume --output <case-directory>; completed comparison cases stay preserved",
+		};
+	if (values.compare && values["base-url"]) return { error: "--compare owns its servers; omit --base-url" };
+	if (values["base-url"] && !values.model) return { error: "--base-url requires --model" };
+	if (values.resume && !values.output) return { error: "--resume requires --output" };
+	const port = Number(values.port ?? 8090);
+	if (!Number.isInteger(port) || port < 1 || port > 65535)
+		return { error: "--port must be an integer from 1 to 65535" };
+	const repoRoot = resolve(values["repo-root"] ?? defaultRepoRoot());
+	const stamp = new Date().toISOString().replace(/[:.]/g, "-");
+	return {
+		modes: values.compare ? [...MODES] : [mode],
+		output: resolve(values.output ?? join(repoRoot, "results/fleetpi/runs", stamp)),
+		taskDir: resolve(values["task-dir"] ?? join(repoRoot, "demos/agent-task-bench/tasks/festival-site")),
+		repoRoot,
+		port,
+		baseUrl: values["base-url"],
+		model: values.model,
+		fleetBin: values["fleet-bin"],
+		modelPath: values["model-path"],
+		vllmConfig: resolve(
+			values["vllm-config"] ?? join(repoRoot, "integrations/fleetpi/configs/vllm-default.local.json"),
+		),
+		resume: values.resume === true,
+		json: values.json === true,
+	};
+}
+
+function serverFor(mode: FestivalMode, options: DemoOptions, outputDir: string): ServerSpec {
+	const logPath = join(outputDir, "logs", "engine.log");
+	if (mode === "fleet8") {
+		return fleetServerSpec({
+			repoRoot: options.repoRoot,
+			profile: MAC_M5PRO_48GB_GLIMMER,
+			port: options.port,
+			logPath,
+			fleetBin: options.fleetBin,
+			modelPath: options.modelPath,
+		});
+	}
+	return vllmServerSpec({ repoRoot: options.repoRoot, configPath: options.vllmConfig, logPath, port: options.port });
+}
+
+interface Ui {
+	event(event: Partial<FleetEvent> & { event: string }): void;
+	close(): void;
+}
+
+// Clean terminal by default: a dashboard on a TTY, short lines otherwise, raw events with --json.
+function createUi(json: boolean, title: string): Ui {
+	if (json) {
+		return { event: (event) => process.stdout.write(`${JSON.stringify(event)}\n`), close: () => {} };
+	}
+	if (process.stdout.isTTY) {
+		const dashboard = new Dashboard(process.stdout, title);
+		dashboard.start();
+		return {
+			event: (event) => {
+				if (event.t_unix === undefined) dashboard.note(`engine ${String(event.state)}`);
+				else dashboard.handle(event as FleetEvent);
+			},
+			close: () => dashboard.stop(),
+		};
+	}
+	const shown = new Set(["engine", "round_start", "round_complete", "run_end", "infrastructure_error"]);
+	return {
+		event: (event) => {
+			if (shown.has(event.event))
+				process.stdout.write(`${title}: ${event.event} ${JSON.stringify({ ...event, event: undefined })}\n`);
+		},
+		close: () => {},
+	};
+}
+
+function writeComparison(output: string, results: ReadonlyMap<FestivalMode, FestivalResult>): void {
+	const rows = Object.fromEntries(
+		[...results].map(([mode, result]) => [
+			mode,
+			{
+				passed: result.passed,
+				finalPassed: result.finalPassed,
+				totalsScope: result.totalsScope,
+				attemptId: result.attemptId,
+				runTotals: result.runTotals,
+				accountingComplete: result.accountingComplete,
+				unknownWallInterval: result.unknownWallInterval,
+				wallSeconds: result.totals.wallSeconds,
+				outputTokens: result.totals.outputTokens,
+				promptTokens: result.totals.promptTokens,
+				cachedTokens: result.totals.cachedTokens,
+				workflowOutputTokensPerSecond: result.totals.workflowOutputTokensPerSecond,
+				streamTokensPerSecond: result.totals.streamTokensPerSecond,
+				compactions: result.totals.compactions,
+				rounds: result.quality,
+				infrastructureError: result.infrastructureError ?? null,
+			},
+		]),
+	);
+	writeFileSync(join(output, "comparison.json"), `${JSON.stringify({ modes: rows }, null, 2)}\n`);
+}
+
+function printResults(results: ReadonlyMap<FestivalMode, FestivalResult>, json: boolean): void {
+	if (json) {
+		process.stdout.write(`${JSON.stringify({ event: "result", results: Object.fromEntries(results) })}\n`);
+		return;
+	}
+	for (const [mode, result] of results) {
+		const rounds = result.quality
+			.map((round) => `r${round.round} ${round.checksPassed}/${round.checksTotal}`)
+			.join("  ");
+		process.stdout.write(
+			`${mode.padEnd(7)} ${result.passed ? "PASSED" : "not passed"}  ${result.totals.wallSeconds.toFixed(0)}s this attempt  ${rounds}  ${result.totals.workflowOutputTokensPerSecond.toFixed(1)} workflow output tok/s  ${result.outputDir}\n`,
+		);
+	}
+}
+
+// dist/cli.js -> packages/fleetpi -> packages -> pi -> vendor -> fleetpi -> integrations -> repo
+function defaultRepoRoot(): string {
+	return process.env.FLEETPI_REPO_ROOT ?? resolve(dirname(fileURLToPath(import.meta.url)), "../../../../../../..");
+}
+
+cli(process.argv.slice(2)).then(
+	(code) => {
+		process.exitCode = code;
+	},
+	(error) => {
+		process.stderr.write(`fleetpi: ${error instanceof Error ? error.stack : String(error)}\n`);
+		process.exitCode = 1;
+	},
+);
