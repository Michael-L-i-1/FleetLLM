@@ -0,0 +1,106 @@
+// The one supported hardware/model profile and the exact Fleet command line it implies.
+
+import { cpus, homedir, totalmem } from "node:os";
+import { join } from "node:path";
+
+/** A validated engine configuration for specific hardware and weights. */
+export interface EngineProfile {
+	id: string;
+	description: string;
+	modelId: string;
+	modelPath: string;
+	maxActive: number;
+	budgetGb: number;
+	kvGb: number;
+	maxTokens: number;
+	contextWindow: number;
+}
+
+/** Host facts used for profile selection (injectable for tests). */
+export interface HostFacts {
+	platform: NodeJS.Platform;
+	arch: string;
+	totalMemoryBytes: number;
+	cpuModel: string;
+}
+
+/** Snapshot of the HuggingFace cache used by every mode (weights never change). */
+export const GLIMMER_SNAPSHOT = join(
+	homedir(),
+	".cache/huggingface/hub/models--mlx-community--Muse-Glimmer-30B-4bit/snapshots/3e7677d7a40d348a3daba263a2b1c0aa41910710",
+);
+
+/** Mac M5 Pro 48 GB running Muse Glimmer 30B MLX affine 4-bit. */
+export const MAC_M5PRO_48GB_GLIMMER: EngineProfile = {
+	id: "mac-m5pro-48gb-glimmer30b-4bit",
+	description: "Apple silicon, 48 GB unified memory, Muse Glimmer 30B 4-bit on Metal",
+	modelId: "glimmer-mlx4",
+	modelPath: GLIMMER_SNAPSHOT,
+	maxActive: 8,
+	budgetGb: 28,
+	kvGb: 4,
+	// Same common limits as DEFAULT_LIMITS for every mode.
+	maxTokens: 4096,
+	contextWindow: 96000,
+};
+
+const MIN_MEMORY_BYTES = 44 * 1024 ** 3;
+
+/** Current host facts. */
+export function currentHost(): HostFacts {
+	return {
+		platform: process.platform,
+		arch: process.arch,
+		totalMemoryBytes: totalmem(),
+		cpuModel: cpus()[0]?.model ?? "unknown",
+	};
+}
+
+/** Select the safe profile for this host, or explain why none is safe. */
+export function selectProfile(host: HostFacts): { profile: EngineProfile } | { error: string } {
+	if (host.platform !== "darwin" || host.arch !== "arm64") {
+		return {
+			error: `no safe FleetPi profile for ${host.platform}/${host.arch}; the demo requires Apple silicon (Metal)`,
+		};
+	}
+	if (host.totalMemoryBytes < MIN_MEMORY_BYTES) {
+		const gb = (host.totalMemoryBytes / 1024 ** 3).toFixed(1);
+		return {
+			error: `${gb} GiB unified memory is below the 48 GB profile's safe minimum (28 GB weights budget + 4 GB KV + OS)`,
+		};
+	}
+	return { profile: MAC_M5PRO_48GB_GLIMMER };
+}
+
+/** Fleet command-line arguments for a profile; no learned drafter, no approximate SPAN. */
+export function fleetArguments(profile: EngineProfile, port: number, modelPath = profile.modelPath): string[] {
+	return [
+		"--model",
+		modelPath,
+		"--device",
+		"metal",
+		"--name",
+		profile.modelId,
+		"--budget-gb",
+		String(profile.budgetGb),
+		"--kv-gb",
+		String(profile.kvGb),
+		"--max-active",
+		String(profile.maxActive),
+		"--admit",
+		"--row-budget",
+		"128",
+		"--ngram",
+		"--reasoning",
+		"low",
+		"--max-tokens",
+		String(profile.maxTokens),
+		"--port",
+		String(port),
+		"--spec-k",
+		"15",
+		"--spec-rows",
+		"128",
+		"--shared-prefix-coalescing",
+	];
+}
