diff --git a/src/q2lut_impl.h b/src/q2lut_impl.h
new file mode 100644
index 0000000..2d4390d
--- /dev/null
+++ b/src/q2lut_impl.h
@@ -0,0 +1,315 @@
+// T-MAC-inspired four-activation subset-sum tables for Glimmer's actual Q2_K.
+// This prototype is independent code, not an integration of Microsoft's T-MAC.
+// Exact int16 LUTs retain Fleet's quantized activation arithmetic. Optional
+// int8 LUTs round table entries; both retain Q2_K's 16-value scale/min layout.
+// cc -O3 -mcpu=native -Isrc bench/experimental/q2_lut.c build/libfleetllm.a
+// -lpthread -lm -o build/q2-lut
+#include "cpuq.h"
+#include "quant.h"
+#include "threadpool.h"
+#if defined(__aarch64__)
+#include <arm_neon.h>
+#endif
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+typedef struct {
+  const cq_mat *w;
+  uint8_t *codes;
+} lut_mat;
+typedef struct {
+  const cq_act *a;
+  uint8_t *lo, *hi;
+  int8_t *q8;
+  float *scale;
+} lut_act;
+
+static double now(void) {
+  struct timespec ts;
+  clock_gettime(CLOCK_MONOTONIC, &ts);
+  return ts.tv_sec + ts.tv_nsec * 1e-9;
+}
+static lut_mat repack(const cq_mat *w) {
+  lut_mat m = {w, calloc((size_t)((w->rows + 3) & ~3) * (w->cols / 32), 8)};
+  int G = w->cols / 32;
+  for (int r = 0; r < w->rows; r++)
+    for (int g = 0; g < G; g++) {
+      const uint8_t *c = w->codes + ((size_t)(r / 4) * G + g) * 32;
+      uint8_t *out = m.codes + ((size_t)(r / 4) * G + g) * 32;
+      for (int s = 0; s < 8; s++) {
+        int planes[2] = {0, 0};
+        for (int k = 0; k < 4; k++) {
+          int j = s * 4 + k, b = j % 8;
+          int code =
+              (c[(b / 4) * 16 + (r % 4) * 4 + b % 4] >> (2 * (j / 8))) & 3;
+          for (int bit = 0; bit < 2; bit++)
+            planes[bit] |= ((code >> bit) & 1) << k;
+        }
+        out[s * 4 + r % 4] = planes[0] | planes[1] << 4;
+      }
+    }
+  return m;
+}
+// Sixteen output rows per lookup: every activation table serves all NEON lanes.
+static lut_mat repack16(const cq_mat *w) {
+  lut_mat m = {w, calloc((size_t)((w->rows + 15) & ~15) * (w->cols / 32), 8)};
+  int G = w->cols / 32;
+  for (int r = 0; r < w->rows; r++)
+    for (int g = 0; g < G; g++) {
+      const uint8_t *c = w->codes + ((size_t)(r / 4) * G + g) * 32;
+      uint8_t *out = m.codes + ((size_t)(r / 16) * G + g) * 128;
+      for (int sub = 0; sub < 8; sub++) {
+        int planes[2] = {0, 0};
+        for (int k = 0; k < 4; k++) {
+          int j = sub * 4 + k, b = j % 8;
+          int code =
+              (c[(b / 4) * 16 + (r % 4) * 4 + b % 4] >> (2 * (j / 8))) & 3;
+          for (int bit = 0; bit < 2; bit++)
+            planes[bit] |= ((code >> bit) & 1) << k;
+        }
+        out[sub * 16 + r % 16] = planes[0] | planes[1] << 4;
+      }
+    }
+  return m;
+}
+static lut_act tables(const cq_act *a) {
+  size_t nb = (size_t)a->n * a->cols / 32;
+  lut_act t = {a, malloc(nb * 128), malloc(nb * 128), malloc(nb * 128),
+               malloc(nb * sizeof(float))};
+  for (size_t b = 0; b < nb; b++) {
+    int sums[128], mx = 0;
+    for (int g = 0; g < 8; g++)
+      for (int idx = 0; idx < 16; idx++) {
+        int sum = 0;
+        for (int k = 0; k < 4; k++)
+          if (idx & (1 << k))
+            sum += a->q[b * 32 + g * 4 + k];
+        sums[g * 16 + idx] = sum;
+        mx = mx > abs(sum) ? mx : abs(sum);
+      }
+    float scale = mx > 0 ? (float)mx / 127.f : 1;
+    t.scale[b] = scale;
+    for (int i = 0; i < 128; i++) {
+      t.lo[b * 128 + i] = (uint8_t)sums[i];
+      t.hi[b * 128 + i] = (uint8_t)(sums[i] >> 8);
+      t.q8[b * 128 + i] = (int8_t)lrintf(sums[i] / scale);
+    }
+  }
+  return t;
+}
+#if defined(__aarch64__)
+static inline int16x8_t join(uint8x8_t lo, uint8x8_t hi) {
+  return vreinterpretq_s16_u16(vorrq_u16(vmovl_u8(lo), vshll_n_u8(hi, 8)));
+}
+static inline int32x4_t dot16(const uint8_t *lo, const uint8_t *hi,
+                              uint8x16_t codes) {
+  static const uint8_t off[16] = {0,  0,  0,  0,  16, 16, 16, 16,
+                                  32, 32, 32, 32, 48, 48, 48, 48};
+  uint8x16_t offset = vld1q_u8(off);
+  uint8x16_t ix0 = vorrq_u8(vandq_u8(codes, vdupq_n_u8(15)), offset);
+  uint8x16_t ix1 = vorrq_u8(vshrq_n_u8(codes, 4), offset);
+  uint8x16x4_t tl = vld1q_u8_x4(lo), th = vld1q_u8_x4(hi);
+  uint8x16_t l0 = vqtbl4q_u8(tl, ix0), h0 = vqtbl4q_u8(th, ix0);
+  uint8x16_t l1 = vqtbl4q_u8(tl, ix1), h1 = vqtbl4q_u8(th, ix1);
+  int16x8_t s0 =
+      vaddq_s16(join(vget_low_u8(l0), vget_low_u8(h0)),
+                vshlq_n_s16(join(vget_low_u8(l1), vget_low_u8(h1)), 1));
+  int16x8_t s1 =
+      vaddq_s16(join(vget_high_u8(l0), vget_high_u8(h0)),
+                vshlq_n_s16(join(vget_high_u8(l1), vget_high_u8(h1)), 1));
+  int16x8_t s = vaddq_s16(s0, s1);
+  return vmovl_s16(vadd_s16(vget_low_s16(s), vget_high_s16(s)));
+}
+static inline int32x4_t dot8(const int8_t *q, uint8x16_t codes) {
+  static const uint8_t off[16] = {0,  0,  0,  0,  16, 16, 16, 16,
+                                  32, 32, 32, 32, 48, 48, 48, 48};
+  uint8x16_t offset = vld1q_u8(off);
+  uint8x16_t ix0 = vorrq_u8(vandq_u8(codes, vdupq_n_u8(15)), offset);
+  uint8x16_t ix1 = vorrq_u8(vshrq_n_u8(codes, 4), offset);
+  uint8x16x4_t table = vld1q_u8_x4((const uint8_t *)q);
+  int8x16_t v0 = vreinterpretq_s8_u8(vqtbl4q_u8(table, ix0)),
+            v1 = vreinterpretq_s8_u8(vqtbl4q_u8(table, ix1));
+  int16x8_t s0 =
+      vaddq_s16(vmovl_s8(vget_low_s8(v0)), vshll_n_s8(vget_low_s8(v1), 1));
+  int16x8_t s1 =
+      vaddq_s16(vmovl_s8(vget_high_s8(v0)), vshll_n_s8(vget_high_s8(v1), 1));
+  int16x8_t s = vaddq_s16(s0, s1);
+  return vmovl_s16(vadd_s16(vget_low_s16(s), vget_high_s16(s)));
+}
+typedef struct {
+  const cq_mat *w;
+  const cq_act *a;
+  const lut_mat *m;
+  const lut_act *lut;
+  float *out;
+  int mode;
+} job;
+static inline __attribute__((always_inline)) void
+lut_run(job *j, int r0, int r1, const int mode) {
+  const cq_mat *w = j->w;
+  const cq_act *a = j->a;
+  const lut_act *lut = j->lut;
+  int G = w->cols / 32;
+  for (int rg = r0 / 4; rg * 4 < r1; rg++)
+    for (int t = 0; t < a->n; t++) {
+      float32x4_t acc = vdupq_n_f32(0), d = acc, dm = acc;
+      for (int g = 0; g < G; g++) {
+        if (!(g & 7)) {
+          const uint16_t *s = w->super + ((size_t)rg * (G / 8) + g / 8) * 8;
+          d = vcvt_f32_f16(vreinterpret_f16_u16(vld1_u16(s)));
+          dm = vnegq_f32(vcvt_f32_f16(vreinterpret_f16_u16(vld1_u16(s + 4))));
+        }
+        const uint8_t *sub = w->sub + ((size_t)rg * G + g) * 8;
+        uint8x8_t sc = vld1_u8(sub);
+        float32x4_t sl =
+            vmulq_f32(d, vcvtq_f32_u32(vmovl_u16(vget_low_u16(
+                             vmovl_u8(vand_u8(sc, vdup_n_u8(15)))))));
+        float32x4_t sh =
+            vmulq_f32(d, vcvtq_f32_u32(vmovl_u16(vget_high_u16(
+                             vmovl_u8(vand_u8(sc, vdup_n_u8(15)))))));
+        float32x4_t bl = vmulq_f32(
+            dm,
+            vcvtq_f32_u32(vmovl_u16(vget_low_u16(vmovl_u8(vshr_n_u8(sc, 4))))));
+        float32x4_t bh = vmulq_f32(dm, vcvtq_f32_u32(vmovl_u16(vget_high_u16(
+                                           vmovl_u8(vshr_n_u8(sc, 4))))));
+        size_t b = (size_t)t * G + g;
+        const uint8_t *c = j->m->codes + ((size_t)rg * G + g) * 32;
+        int32x4_t dl, dh;
+        float scale = a->s[b];
+        if (mode == 16) {
+          dl = dot16(lut->lo + b * 128, lut->hi + b * 128, vld1q_u8(c));
+          dh = dot16(lut->lo + b * 128 + 64, lut->hi + b * 128 + 64,
+                     vld1q_u8(c + 16));
+        } else {
+          dl = dot8(lut->q8 + b * 128, vld1q_u8(c));
+          dh = dot8(lut->q8 + b * 128 + 64, vld1q_u8(c + 16));
+          scale *= lut->scale[b];
+        }
+        acc = vfmaq_n_f32(
+            acc,
+            vfmaq_f32(vmulq_f32(vcvtq_f32_s32(dl), sl), vcvtq_f32_s32(dh), sh),
+            scale);
+        acc = vfmaq_n_f32(acc, bl, a->s16[b * 2]);
+        acc = vfmaq_n_f32(acc, bh, a->s16[b * 2 + 1]);
+      }
+      float z[4];
+      vst1q_f32(z, acc);
+      for (int k = 0; k < 4 && rg * 4 + k < r1; k++)
+        j->out[(size_t)t * w->rows + rg * 4 + k] = z[k];
+    }
+}
+// Exact 16-row lookup, with four-row metadata vectors preserving float order.
+static inline __attribute__((always_inline)) void
+lut_run16(job *j, int r0, int r1, const int mode) {
+  const cq_mat *w = j->w;
+  const cq_act *a = j->a;
+  const lut_act *lut = j->lut;
+  int G = w->cols / 32;
+  for (int rg = r0 / 16; rg * 16 < r1; rg++)
+    for (int t = 0; t < a->n; t++) {
+      float32x4_t acc[4], d[4], dm[4];
+      for (int v = 0; v < 4; v++)
+        acc[v] = d[v] = dm[v] = vdupq_n_f32(0);
+      for (int g = 0; g < G; g++) {
+        size_t b = (size_t)t * G + g;
+        const uint8_t *c = j->m->codes + ((size_t)rg * G + g) * 128;
+        int32x4_t dots[2][4];
+        for (int half = 0; half < 2; half++) {
+          int16x8_t sum0 = vdupq_n_s16(0), sum1 = sum0;
+          for (int k = 0; k < 4; k++) {
+            int sub = half * 4 + k;
+            uint8x16_t codes = vld1q_u8(c + sub * 16);
+            uint8x16_t ix0 = vandq_u8(codes, vdupq_n_u8(15)),
+                       ix1 = vshrq_n_u8(codes, 4);
+            int16x8_t s0, s1;
+            if (mode == 16) {
+              uint8x16_t lo = vld1q_u8(lut->lo + b * 128 + sub * 16),
+                         hi = vld1q_u8(lut->hi + b * 128 + sub * 16);
+              uint8x16_t l0 = vqtbl1q_u8(lo, ix0), h0 = vqtbl1q_u8(hi, ix0);
+              uint8x16_t l1 = vqtbl1q_u8(lo, ix1), h1 = vqtbl1q_u8(hi, ix1);
+              s0 = vaddq_s16(
+                  join(vget_low_u8(l0), vget_low_u8(h0)),
+                  vshlq_n_s16(join(vget_low_u8(l1), vget_low_u8(h1)), 1));
+              s1 = vaddq_s16(
+                  join(vget_high_u8(l0), vget_high_u8(h0)),
+                  vshlq_n_s16(join(vget_high_u8(l1), vget_high_u8(h1)), 1));
+            } else {
+              uint8x16_t table =
+                  vld1q_u8((const uint8_t *)lut->q8 + b * 128 + sub * 16);
+              int8x16_t v0 = vreinterpretq_s8_u8(vqtbl1q_u8(table, ix0)),
+                        v1 = vreinterpretq_s8_u8(vqtbl1q_u8(table, ix1));
+              s0 = vaddq_s16(vmovl_s8(vget_low_s8(v0)),
+                             vshll_n_s8(vget_low_s8(v1), 1));
+              s1 = vaddq_s16(vmovl_s8(vget_high_s8(v0)),
+                             vshll_n_s8(vget_high_s8(v1), 1));
+            }
+            sum0 = vaddq_s16(sum0, s0);
+            sum1 = vaddq_s16(sum1, s1);
+          }
+          dots[half][0] = vmovl_s16(vget_low_s16(sum0));
+          dots[half][1] = vmovl_s16(vget_high_s16(sum0));
+          dots[half][2] = vmovl_s16(vget_low_s16(sum1));
+          dots[half][3] = vmovl_s16(vget_high_s16(sum1));
+        }
+        for (int v = 0; v < 4; v++) {
+          int oldrg = rg * 4 + v;
+          if (oldrg * 4 >= w->rows)
+            break;
+          if (!(g & 7)) {
+            const uint16_t *s =
+                w->super + ((size_t)oldrg * (G / 8) + g / 8) * 8;
+            d[v] = vcvt_f32_f16(vreinterpret_f16_u16(vld1_u16(s)));
+            dm[v] =
+                vnegq_f32(vcvt_f32_f16(vreinterpret_f16_u16(vld1_u16(s + 4))));
+          }
+          const uint8_t *sub = w->sub + ((size_t)oldrg * G + g) * 8;
+          uint8x8_t sc = vld1_u8(sub);
+          float32x4_t sl =
+              vmulq_f32(d[v], vcvtq_f32_u32(vmovl_u16(vget_low_u16(
+                                  vmovl_u8(vand_u8(sc, vdup_n_u8(15)))))));
+          float32x4_t sh =
+              vmulq_f32(d[v], vcvtq_f32_u32(vmovl_u16(vget_high_u16(
+                                  vmovl_u8(vand_u8(sc, vdup_n_u8(15)))))));
+          float32x4_t bl =
+              vmulq_f32(dm[v], vcvtq_f32_u32(vmovl_u16(
+                                   vget_low_u16(vmovl_u8(vshr_n_u8(sc, 4))))));
+          float32x4_t bh =
+              vmulq_f32(dm[v], vcvtq_f32_u32(vmovl_u16(
+                                   vget_high_u16(vmovl_u8(vshr_n_u8(sc, 4))))));
+          float scale = a->s[b] * (mode == 8 ? lut->scale[b] : 1);
+          acc[v] =
+              vfmaq_n_f32(acc[v],
+                          vfmaq_f32(vmulq_f32(vcvtq_f32_s32(dots[0][v]), sl),
+                                    vcvtq_f32_s32(dots[1][v]), sh),
+                          scale);
+          acc[v] = vfmaq_n_f32(acc[v], bl, a->s16[b * 2]);
+          acc[v] = vfmaq_n_f32(acc[v], bh, a->s16[b * 2 + 1]);
+        }
+      }
+      for (int v = 0; v < 4; v++) {
+        float z[4];
+        vst1q_f32(z, acc[v]);
+        for (int k = 0; k < 4 && rg * 16 + v * 4 + k < r1; k++)
+          if (rg * 16 + v * 4 + k >= r0)
+            j->out[(size_t)t * w->rows + rg * 16 + v * 4 + k] = z[k];
+      }
+    }
+}
+static void run(void *v, int r0, int r1) {
+  job *j = v;
+  if (!j->mode)
+    cq_matmul_rows(j->w, j->a, j->out, j->w->rows, r0, r1);
+  else if (j->mode == 116)
+    lut_run16(j, r0, r1, 16);
+  else if (j->mode == 108)
+    lut_run16(j, r0, r1, 8);
+  else if (j->mode == 16)
+    lut_run(j, r0, r1, 16);
+  else
+    lut_run(j, r0, r1, 8);
+}
