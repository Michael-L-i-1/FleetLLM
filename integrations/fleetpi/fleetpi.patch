index 0000000..38b4c4d
--- /dev/null
+++ b/packages/fleetpi/src/fleet/fleet-telemetry.ts
@@ -0,0 +1,140 @@
+// Reads Fleet's /v1/fleet/capabilities and /v1/fleet/stats; absent fields are reported as unknown.
+
+import type { PressureSample } from "./admission-queue.ts";
+
+/** Parsed capability document. */
+export interface FleetCapabilities {
+	engine: string | null;
+	model: string | null;
+	maxActive: number | null;
+	contextWindow: number | null;
+	features: Record<string, unknown>;
+}
+
+/** Parsed stats sample. */
+export interface FleetStats {
+	atUnix: number;
+	active: number | null;
+	queued: number | null;
+	kvTotalBytes: number | null;
+	kvFreeBytes: number | null;
+	kvFull: boolean;
+	prefillTokens: number | null;
+	generatedTokens: number | null;
+	sharedPrefixTokens: number | null;
+}
+
+/** KV free fraction below which new requests wait while one of ours is streaming. */
+export const KV_PRESSURE_FRACTION = 0.08;
+
+/** Polls Fleet telemetry for admission and the dashboard. */
+export class FleetTelemetry {
+	readonly origin: string;
+	private readonly pollMs: number;
+	private readonly fetchImpl: typeof fetch;
+	private timer: ReturnType<typeof setInterval> | undefined;
+	private sample: FleetStats | undefined;
+
+	constructor(baseUrl: string, pollMs = 500, fetchImpl: typeof fetch = fetch) {
+		this.origin = baseUrl.replace(/\/+$/, "").replace(/\/v1$/, "");
+		this.pollMs = pollMs;
+		this.fetchImpl = fetchImpl;
+	}
+
+	/** Fetch the capability document, or undefined if the endpoint is not implemented. */
+	async capabilities(): Promise<FleetCapabilities | undefined> {
+		const json = await this.getJson("/v1/fleet/capabilities");
+		return json === undefined ? undefined : parseCapabilities(json);
+	}
+
+	/** Fetch one stats sample, or undefined if unavailable. */
+	async stats(): Promise<FleetStats | undefined> {
+		const json = await this.getJson("/v1/fleet/stats");
+		return json === undefined ? undefined : parseStats(json);
+	}
+
+	/** Start background polling; onSample runs after each successful sample. */
+	start(onSample: (stats: FleetStats) => void): void {
+		if (this.timer) return;
+		const poll = async () => {
+			const next = await this.stats();
+			if (!next) return;
+			this.sample = next;
+			onSample(next);
+		};
+		void poll();
+		this.timer = setInterval(() => void poll(), this.pollMs);
+		this.timer.unref?.();
+	}
+
+	/** Stop polling. */
+	stop(): void {
+		if (this.timer) clearInterval(this.timer);
+		this.timer = undefined;
+	}
+
+	/** The most recent sample. */
+	latest(): FleetStats | undefined {
+		return this.sample;
+	}
+
+	/** Memory pressure derived from the latest sample; unknown telemetry never blocks. */
+	pressure(): PressureSample | undefined {
+		const stats = this.sample;
+		if (!stats) return undefined;
+		const fraction = stats.kvTotalBytes && stats.kvFreeBytes !== null ? stats.kvFreeBytes / stats.kvTotalBytes : null;
+		return {
+			blocked: stats.kvFull || (fraction !== null && fraction < KV_PRESSURE_FRACTION),
+			kvFreeFraction: fraction,
+		};
+	}
+
+	private async getJson(path: string): Promise<unknown> {
+		try {
+			const response = await this.fetchImpl(`${this.origin}${path}`, { signal: AbortSignal.timeout(2000) });
+			if (!response.ok) return undefined;
+			return await response.json();
+		} catch {
+			return undefined;
+		}
+	}
+}
+
+// Wire input from the engine: read only fields with the expected types.
+function num(value: unknown): number | null {
+	return typeof value === "number" && Number.isFinite(value) ? value : null;
+}
+
+function obj(value: unknown): Record<string, unknown> {
+	return value !== null && typeof value === "object" ? (value as Record<string, unknown>) : {};
+}
+
+/** Parse the capability document (wire input). */
+export function parseCapabilities(json: unknown): FleetCapabilities {
+	const value = obj(json);
+	return {
+		engine: typeof value.engine === "string" ? value.engine : null,
+		model: typeof value.model === "string" ? value.model : null,
+		maxActive: num(value.max_active),
+		contextWindow: num(value.context_window),
+		features: obj(value.features),
+	};
+}
+
+/** Parse one stats sample (wire input). */
+export function parseStats(json: unknown): FleetStats {
+	const value = obj(json);
+	const kv = obj(value.kv);
+	const tokens = obj(value.tokens);
+	return {
+		atUnix: Date.now() / 1000,
+		active: num(value.active),
+		queued: num(value.queued),
+		kvTotalBytes: num(kv.total_bytes),
+		kvFreeBytes: num(kv.free_bytes),
+		kvFull: kv.full === true,
+		prefillTokens: num(tokens.prefill),
+		generatedTokens: num(tokens.generated),
+		sharedPrefixTokens: num(tokens.shared_prefix),
+	};
+}
