diff --git a/bench/experimental/q2_lut.c b/bench/experimental/q2_lut.c
new file mode 100644
index 0000000..d883930
--- /dev/null
+++ b/bench/experimental/q2_lut.c
@@ -0,0 +1,95 @@
+// Real-Q2_K microbenchmark of experimental activation subset-sum LUT kernels.
+#include "q2lut_impl.h"
+int main(int argc, char **argv) {
+  if (argc < 2)
+    return 1;
+  tp_init(4);
+  gguf_ctx *g = gguf_open(argv[1]);
+  if (!g)
+    return 1;
+  if (argc > 2 && !strcmp(argv[2], "--list")) {
+    for (size_t i = 0; i < g->n_tensors; i++) {
+      const gguf_tensor *t = &g->tensors[i];
+      if (t->type == GGML_Q2_K && t->n_dims == 2)
+        printf("%s,%llu,%llu,%zu\n", t->name, (unsigned long long)t->dims[1],
+               (unsigned long long)t->dims[0], t->nbytes);
+    }
+    return 0;
+  }
+  const gguf_tensor *tensor = NULL;
+  for (size_t i = 0; i < g->n_tensors; i++) {
+    const gguf_tensor *t = &g->tensors[i];
+    if (t->type == GGML_Q2_K && t->n_dims == 2 &&
+        (argc > 3 ? strstr(t->name, argv[3]) != NULL
+                  : strstr(t->name, "token_embd") == NULL &&
+                        strstr(t->name, "output") == NULL) &&
+        (!tensor || t->nbytes > tensor->nbytes))
+      tensor = t;
+  }
+  if (!tensor)
+    return 2;
+  qmat src = {.type = tensor->type,
+              .rows = tensor->dims[1],
+              .cols = tensor->dims[0],
+              .row_bytes = tensor->dims[0] / 256 * 84,
+              .data = tensor->data};
+  cq_mat *w = cq_from_qmat(&src);
+  lut_mat m = repack(w), m16 = repack16(w);
+  float *x = malloc((size_t)4 * w->cols * sizeof(float)),
+        *out = malloc((size_t)4 * w->rows * sizeof(float)),
+        *ref = malloc((size_t)4 * w->rows * sizeof(float));
+  for (int i = 0; i < 4 * w->cols; i++)
+    x[i] = sinf(i * .13f) + cosf(i * .019f) * .2f;
+  puts("tensor,rows,cols,batch,mode,round,milliseconds,max_error,relative_"
+       "error,bitwise_equal,lut_prep_ms");
+  int reps = argc > 2 ? atoi(argv[2]) : 10;
+  if (reps < 1)
+    return 2;
+  for (int n = 1; n <= 4; n *= 2) {
+    cq_act a = {0};
+    cq_quantize(&a, x, n, w->cols);
+    double start = now();
+    lut_act lut = tables(&a);
+    double prep = (now() - start) * 1000;
+    job j = {w, &a, &m, &lut, out, 0};
+    parallel_for(w->rows, 64, run, &j);
+    memcpy(ref, out, (size_t)n * w->rows * sizeof(float));
+    for (int round = 0; round < 3; round++)
+      for (int k = 0; k < 5; k++) {
+        int modes[5] = {0, 16, 8, 116, 108};
+        j.mode = modes[(round + k) % 5];
+        j.m = j.mode > 100 ? &m16 : &m;
+        parallel_for(w->rows, 64, run, &j);
+        start = now();
+        for (int rep = 0; rep < reps; rep++)
+          parallel_for(w->rows, 64, run, &j);
+        double ms = (now() - start) * 1000 / reps;
+        double err = 0, mx = 0;
+        int same = 1;
+        for (size_t i = 0; i < (size_t)n * w->rows; i++) {
+          err = fmax(err, fabs(out[i] - ref[i]));
+          mx = fmax(mx, fabs(ref[i]));
+          same &= memcmp(out + i, ref + i, 4) == 0;
+        }
+        printf("%s,%d,%d,%d,%d,%d,%.6f,%.8g,%.8g,%d,%.6f\n", tensor->name,
+               w->rows, w->cols, n, j.mode, round, ms, err, mx ? err / mx : 0,
+               same, prep);
+        fflush(stdout);
+        if ((j.mode == 16 || j.mode == 116) && !same) {
+          fprintf(stderr, "exact LUT mismatch\n");
+          return 3;
+        }
+      }
+    free(lut.lo);
+    free(lut.hi);
+    free(lut.q8);
+    free(lut.scale);
+    free(a.q);
+    free(a.s);
+    free(a.sq);
+    free(a.s16);
+    free(a.is16);
+    free(a.nz);
+  }
+  return 0;
+}
diff --git a/bench/experimental/q2_lut_check.c b/bench/experimental/q2_lut_check.c
new file mode 100644
index 0000000..98f92f4
--- /dev/null
+++ b/bench/experimental/q2_lut_check.c
@@ -0,0 +1,58 @@
+// Small exactness/safety checks for the isolated Q2_K lookup prototype.
+#include "cpuq.h"
+#include "gguf.h"
+#include "q2lut.h"
+#include "quant.h"
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+int main(void) {
+  enum { R = 7, K = 768, N = 17, RB = K / 256 * 84 };
+  uint8_t packed[R * RB];
+  float x[N * K], ref[N * R], y[N * R];
+  for (int i = 0; i < R * RB; i++)
+    packed[i] = (uint8_t)(rand() % 256);
+  for (int b = 0; b < R * K / 256; b++) {
+    uint16_t d = f32_to_fp16((b % 7) * .013f),
+             mn = f32_to_fp16((b % 5) * .007f);
+    memcpy(packed + b * 84 + 80, &d, 2);
+    memcpy(packed + b * 84 + 82, &mn, 2);
+  }
+  qmat src = {
+      .type = GGML_Q2_K, .rows = R, .cols = K, .row_bytes = RB, .data = packed};
+  cq_mat *normal = cq_from_qmat(&src);
+  cq_act a = {0};
+  const int modes[] = {16, 116};
+  for (int mode = 0; mode < 2; mode++) {
+    cq_mat *w = cq_from_qmat(&src);
+    q2lut_repack(w, modes[mode]);
+    for (int rep = 0; rep < 4; rep++)
+      for (int n = 1; n <= N; n++) {
+        for (int i = 0; i < N * K; i++)
+          x[i] = rep ? ldexpf(sinf(i * .19f), rep * 4 - 8) : 0;
+        cq_quantize(&a, x, n, K);
+        cq_matmul_rows(normal, &a, ref, R, 0, R);
+        q2lut_prepare(&a);
+        cq_matmul_rows(w, &a, y, R, 0, 4);
+        cq_matmul_rows(w, &a, y, R, 4, R);
+        if (memcmp(ref, y, (size_t)n * R * sizeof(float))) {
+          fprintf(stderr, "mismatch rep%d n%d\n", rep, n);
+          return 1;
+        }
+      }
+    cq_free(w);
+  }
+  q2lut_reset(&a);
+  free(a.q);
+  free(a.s);
+  free(a.sq);
+  free(a.s16);
+  free(a.is16);
+  free(a.nz);
+  cq_free(normal);
+  puts("Q2 LUT exact16, four-/sixteen-row tiles: padded rows, partitions, "
+       "batches1..17, zero/scaled "
+       "activations PASS");
+  return 0;
+}
diff --git a/bench/experimental/q2_lut_model.py b/bench/experimental/q2_lut_model.py
new file mode 100644
index 0000000..9886738
--- /dev/null
+++ b/bench/experimental/q2_lut_model.py
@@ -0,0 +1,125 @@
+"""Short exact-LUT negative/positive proof on Glimmer, isolated from deployment."""
+
+import fcntl
+import json
+import os
+from pathlib import Path
+import signal
+import subprocess
+import time
+
+root = Path(__file__).resolve().parents[2]
+out = root / "results-tmac"
+out.mkdir(exist_ok=True)
+tasks = out / "probe.jsonl"
+tasks.write_text(
+    json.dumps(
+        {
+            "id": "rainbow",
+            "prompt": "Explain why rainbows have different colors, in two sentences.",
+            "max_tokens": 24,
+        }
+    )
+    + "\n"
+)
+lockpath = Path.home() / ".cache/fleetllm-bench.lock"
+lockpath.parent.mkdir(exist_ok=True)
+metadata = {}
+
+
+def memory():
+    d = {
+        s.split(":")[0]: int(s.split()[1]) * 1024
+        for s in Path("/proc/meminfo").read_text().splitlines()
+    }
+    return d["MemAvailable"], d["SwapTotal"] - d["SwapFree"]
+
+
+with lockpath.open("w") as lock:
+    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+    for name, build, lut in [
+        ("baseline", "build-baseline", None),
+        ("exact16", "build", "116"),
+    ]:
+        cmd = [
+            str(root / build / "fleet"),
+            "eval",
+            "--model",
+            str(Path.home() / "models/Muse-Glimmer-30B-Q2_K.gguf"),
+            "--backend",
+            "cpu",
+            "--threads",
+            "4",
+            "--budget-gb",
+            "14.8",
+            "--kv-gb",
+            ".25",
+            "--row-budget",
+            "64",
+            "--no-pin",
+            "--tasks",
+            str(tasks),
+        ]
+        env = dict(os.environ)
+        env.pop("FLEET_Q2_LUT", None)
+        if lut:
+            env["FLEET_Q2_LUT"] = lut
+        start = time.monotonic()
+        _, swap0 = memory()
+        peak = 0
+        minimum = 10**20
+        swapgrowth = 0
+        reason = None
+        with (
+            (out / (name + ".jsonl")).open("w") as stdout,
+            (out / (name + ".log")).open("w") as stderr,
+        ):
+            p = subprocess.Popen(
+                cmd, env=env, stdout=stdout, stderr=stderr, start_new_session=True
+            )
+            while p.poll() is None:
+                try:
+                    lines = Path(f"/proc/{p.pid}/status").read_text().splitlines()
+                    rss = next(
+                        int(s.split()[1]) * 1024
+                        for s in lines
+                        if s.startswith("VmRSS:")
+                    )
+                    peak = max(peak, rss)
+                except (FileNotFoundError, StopIteration, ProcessLookupError):
+                    pass
+                available, swap = memory()
+                minimum = min(minimum, available)
+                swapgrowth = max(swapgrowth, swap - swap0)
+                if (
+                    available < 400 * 1024**2
+                    or swapgrowth > 128 * 1024**2
+                    or time.monotonic() - start > 900
+                ):
+                    reason = "memory/swap/time guard"
+                    os.killpg(p.pid, signal.SIGTERM)
+                    break
+                time.sleep(0.5)
+            try:
+                status = p.wait(timeout=15)
+            except subprocess.TimeoutExpired:
+                os.killpg(p.pid, signal.SIGKILL)
+                status = p.wait()
+        metadata[name] = dict(
+            command=cmd,
+            environment={"FLEET_Q2_LUT": lut},
+            returncode=status,
+            stopped=reason,
+            seconds=time.monotonic() - start,
+            peak_rss_bytes=peak,
+            minimum_available_bytes=minimum,
+            peak_swap_delta_bytes=swapgrowth,
+        )
+        (out / "model-run.json").write_text(json.dumps(metadata, indent=2) + "\n")
+        if status or reason:
+            raise RuntimeError(f"{name}: {status} {reason}")
+        print(name, (out / (name + ".jsonl")).read_text(), flush=True)
+    baseline = json.loads((out / "baseline.jsonl").read_text())
+    lut = json.loads((out / "exact16.jsonl").read_text())
+    assert baseline["tokens"] == lut["tokens"], "exact LUT changed greedy output"
+    print("Exact16 full-model tokens identical PASS", flush=True)
