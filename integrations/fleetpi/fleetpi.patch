@@ -0,0 +1,78 @@
+// Creates one real Pi SDK session per agent with isolated resources and a persistent session file.
+
+import type { ThinkingLevel } from "@earendil-works/pi-agent-core";
+import type { Api, Model } from "@earendil-works/pi-ai";
+import {
+	type AgentSession,
+	createAgentSession,
+	DefaultResourceLoader,
+	type InlineExtension,
+	type ModelRuntime,
+	SessionManager,
+	SettingsManager,
+} from "@earendil-works/pi-coding-agent";
+import { FESTIVAL_TOOL_NAMES } from "../tools/common-tools.ts";
+
+/** Settings accepted by SettingsManager.inMemory. */
+export type SessionSettings = NonNullable<Parameters<typeof SettingsManager.inMemory>[0]>;
+
+/** Everything needed to open or reopen one agent's Pi session. */
+export interface OpenSessionSpec {
+	cwd: string;
+	agentDir: string;
+	sessionDir: string;
+	/** Existing session file to continue (restart); omitted for a new session. */
+	sessionFile?: string;
+	modelRuntime: ModelRuntime;
+	model: Model<Api>;
+	extensions: InlineExtension[];
+	/** Text added to the system prompt ahead of cwd (enhanced mode: the stable shared project context). */
+	appendSystemPrompt?: string[];
+	/** Overrides merged over the common defaults (tests use small compaction budgets). */
+	settings?: SessionSettings;
+	thinkingLevel?: ThinkingLevel;
+	tools?: readonly string[];
+}
+
+/** Common settings: Pi's default token compaction and default auto-retry, no cache-warming requests. */
+export const COMMON_SESSION_SETTINGS: SessionSettings = {
+	cacheWarming: "off",
+	compaction: { enabled: true, reserveTokens: 16384, keepRecentTokens: 20000 },
+};
+
+/** Open a Pi session; the SessionManager file is the authoritative transcript. */
+export async function openSession(spec: OpenSessionSpec): Promise<AgentSession> {
+	const settingsManager = SettingsManager.inMemory({ ...COMMON_SESSION_SETTINGS, ...spec.settings });
+	// No skills, templates, themes, context files or discovered extensions: every mode sees
+	// exactly the same resources, and nothing from the user's ~/.pi leaks into a benchmark.
+	const resourceLoader = new DefaultResourceLoader({
+		cwd: spec.cwd,
+		agentDir: spec.agentDir,
+		settingsManager,
+		extensionFactories: spec.extensions,
+		// An explicit (possibly empty) list also disables APPEND_SYSTEM.md discovery.
+		appendSystemPrompt: spec.appendSystemPrompt ?? [],
+		noExtensions: true,
+		noSkills: true,
+		noPromptTemplates: true,
+		noThemes: true,
+		noContextFiles: true,
+	});
+	await resourceLoader.reload();
+	const sessionManager = spec.sessionFile
+		? SessionManager.open(spec.sessionFile, spec.sessionDir)
+		: SessionManager.create(spec.cwd, spec.sessionDir);
+	const { session } = await createAgentSession({
+		cwd: spec.cwd,
+		agentDir: spec.agentDir,
+		modelRuntime: spec.modelRuntime,
+		model: spec.model,
+		thinkingLevel: spec.thinkingLevel ?? "low",
+		tools: [...(spec.tools ?? FESTIVAL_TOOL_NAMES)],
+		resourceLoader,
+		sessionManager,
+		settingsManager,
+	});
+	await session.bindExtensions({ mode: "print" });
+	return session;
+}
