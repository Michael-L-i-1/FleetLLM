@@ -0,0 +1,78 @@
+// Resumable run state (state.json): configuration, protected hashes and completed rounds.
+
+import { existsSync, readFileSync } from "node:fs";
+import type { SessionSettings } from "../session/open-session.ts";
+import type { FestivalMode, RunLimits, Totals } from "../types.ts";
+import type { ProtectedSnapshot } from "../workspace/workspace.ts";
+import type { TaskOutcome } from "./agent-runtime.ts";
+import { writeJsonAtomic } from "./atomic-json.ts";
+
+/** Result of one released round. */
+export interface RoundResult {
+	round: number;
+	title: string;
+	wallSeconds: number;
+	passed: boolean;
+	checksPassed: number;
+	checksTotal: number;
+	failures: string[];
+	pagesPassed: Record<string, boolean>;
+	agentOutcomes: Record<string, TaskOutcome[]>;
+	timedOut: boolean;
+	totals: Totals;
+	officialResultPath: string;
+	infrastructureError?: string;
+}
+
+/** Persisted run state. */
+export interface RunState {
+	version: 2;
+	mode: FestivalMode;
+	taskDir: string;
+	baseUrl: string;
+	model: string;
+	startTimeUnix: number;
+	limits: RunLimits;
+	protectedSnapshot: ProtectedSnapshot;
+	rounds: RoundResult[];
+	finished: boolean;
+	sessionSettings: SessionSettings | null;
+	attempts: RunAttempt[];
+	/** Active time and counters from completed attempts or the last interrupted checkpoint. */
+	roundProgress: Record<number, { wallSeconds: number; totals: Totals }>;
+	activeRound: number | null;
+}
+
+/** An execution of the runner; missing totals explicitly mark an unclean interruption. */
+export interface RunAttempt {
+	id: string;
+	startedAtUnix: number;
+	totals: Totals | null;
+	/** Active time debited at clean shutdown or the last checkpoint; never includes downtime. */
+	wallBudgetSeconds: number;
+}
+
+/** Atomic JSON persistence for RunState. */
+export class RunStateStore {
+	readonly path: string;
+
+	constructor(path: string) {
+		this.path = path;
+	}
+
+	/** Load state; throws if absent (resume requires a previous run). */
+	load(): RunState {
+		if (!existsSync(this.path)) throw new Error(`cannot resume: ${this.path} does not exist`);
+		const state = JSON.parse(readFileSync(this.path, "utf8")) as RunState;
+		if (state.version !== 2)
+			throw new Error(
+				`unsupported run state version in ${this.path}; frozen version-1 trials must remain immutable`,
+			);
+		return state;
+	}
+
+	/** Write state atomically. */
+	save(state: RunState): void {
+		writeJsonAtomic(this.path, state);
+	}
+}
diff --git a/packages/fleetpi/src/run/session-observer.ts b/packages/fleetpi/src/run/session-observer.ts
