+++ b/packages/fleetpi/src/ui/dashboard.ts
@@ -0,0 +1,216 @@
+// In-place terminal dashboard driven only by FleetEvents (the same events written to events.jsonl).
+
+import type { FleetEvent } from "../types.ts";
+
+interface AgentRow {
+	agent: string;
+	state: string;
+	since: number;
+	queued: boolean;
+	calls: number;
+	output: number;
+	prompt: number;
+	cached: number;
+	tokPerSec: number | null;
+	ownedChecks: string;
+	lastWrite: string;
+	compactions: number;
+}
+
+interface EngineRow {
+	active: number | null;
+	queued: number | null;
+	kvFree: number | null;
+	sharedPrefix: number | null;
+}
+
+const RENDER_MS = 250;
+type DashboardOutput = Pick<NodeJS.WriteStream, "write" | "columns">;
+
+/** Renders agent states, throughput, cache reuse and check progress; logs go to files, not here. */
+export class Dashboard {
+	private readonly out: DashboardOutput;
+	private readonly title: string;
+	private readonly rows = new Map<string, AgentRow>();
+	private readonly roundResults: string[] = [];
+	private engine: EngineRow = { active: null, queued: null, kvFree: null, sharedPrefix: null };
+	private header = "starting";
+	private elapsed = 0;
+	private startUnix = Date.now() / 1000;
+	private attemptStartUnix: number | undefined;
+	private lastLines = 0;
+	private timer: ReturnType<typeof setInterval> | undefined;
+	private notes: string[] = [];
+
+	constructor(out: DashboardOutput, title: string) {
+		this.out = out;
+		this.title = title;
+	}
+
+	/** Begin periodic redraws. */
+	start(): void {
+		this.out.write("\x1b[?25l");
+		this.timer = setInterval(() => this.render(), RENDER_MS);
+		this.timer.unref?.();
+	}
+
+	/** Final redraw and restore the cursor. */
+	stop(): void {
+		if (this.timer) clearInterval(this.timer);
+		this.timer = undefined;
+		this.render();
+		this.out.write("\x1b[?25h\n");
+		this.lastLines = 0;
+	}
+
+	/** Add a one-line note under the table (engine lifecycle, mode switches). */
+	note(text: string): void {
+		this.notes = [...this.notes, text].slice(-4);
+	}
+
+	/** Fold one event into the view. */
+	handle(event: FleetEvent): void {
+		if (event.event === "run_start" || event.event === "run_resume") this.attemptStartUnix = event.t_unix;
+		this.startUnix = this.attemptStartUnix ?? event.t_unix - event.elapsed;
+		this.elapsed = Math.max(0, event.t_unix - this.startUnix);
+		const agent = typeof event.agent === "string" ? this.row(event.agent) : undefined;
+		switch (event.event) {
+			case "run_start":
+			case "run_resume":
+				this.rows.clear();
+				this.roundResults.length = 0;
+				for (const entry of (event.agents as Array<{ agent: string }>) ?? []) this.row(entry.agent);
+				if (event.event === "run_resume") this.note("Resumed: timer and agent counters cover this attempt.");
+				break;
+			case "round_start":
+			case "phase":
+				this.header = `round ${event.round ?? "-"}: ${event.round_title ?? ""} · ${event.phase ?? ""}`;
+				break;
+			case "agent_state":
+				if (agent) {
+					agent.state = String(event.state);
+					agent.since = event.t_unix;
+					if (agent.state !== "streaming") agent.queued = false;
+				}
+				break;
+			case "admission":
+				if (agent) agent.queued = event.action === "wait";
+				break;
+			case "call_end":
+				if (agent) {
+					agent.calls++;
+					agent.output += Number(event.output ?? 0);
+					agent.prompt += Number(event.prompt ?? 0);
+					agent.cached += Number(event.cached ?? 0);
+					agent.tokPerSec = typeof event.requestTokPerSec === "number" ? event.requestTokPerSec : null;
+				}
+				break;
+			case "check":
+				if (agent)
+					agent.ownedChecks = `${event.ownedChecksPassed}/${event.ownedChecksTotal}${event.official ? " (official)" : ""}`;
+				break;
+			case "file_write":
+				if (agent) agent.lastWrite = `${String(event.path).replace(/^pages\//, "")} @${formatClock(this.elapsed)}`;
+				break;
+			case "compaction":
+				if (agent && !event.aborted && event.tokensBefore !== null) agent.compactions++;
+				break;
+			case "engine_stats":
+				this.engine = {
+					active: event.active as number | null,
+					queued: event.queued as number | null,
+					kvFree: event.kvFreeFraction as number | null,
+					sharedPrefix: event.sharedPrefixTokens as number | null,
+				};
+				break;
+			case "round_complete":
+				this.roundResults.push(
+					`round ${event.round}: ${event.passed ? "PASS" : "fail"} ${event.checksPassed}/${event.checksTotal} at ${formatClock(this.elapsed)}${event.timedOut ? " (wall limit)" : ""}`,
+				);
+				break;
+			case "no_tool_calls":
+				this.note(`warning: ${String(event.agent)} finished a ${String(event.kind)} task without any tool call`);
+				break;
+			case "guard_block":
+				this.note(
+					`guard: ${String(event.agent)} ${String(event.tool)} ${String(event.path)} refused (${String(event.kind)})`,
+				);
+				break;
+			case "infrastructure_error":
+				this.note(`infrastructure error: ${String(event.error)}`);
+				break;
+			case "run_end":
+				this.header = `finished: ${event.passed ? "PASSED" : "not passed"}${event.cancelled ? " (cancelled)" : ""}`;
+				break;
+			default:
+				break;
+		}
+	}
+
+	private row(agent: string): AgentRow {
+		let row = this.rows.get(agent);
+		if (!row) {
+			row = {
+				agent,
+				state: "idle",
+				since: Date.now() / 1000,
+				queued: false,
+				calls: 0,
+				output: 0,
+				prompt: 0,
+				cached: 0,
+				tokPerSec: null,
+				ownedChecks: "-",
+				lastWrite: "-",
+				compactions: 0,
+			};
+			this.rows.set(agent, row);
+		}
+		return row;
+	}
+
+	private render(): void {
+		const now = Date.now() / 1000;
+		const elapsed = Math.max(this.elapsed, now - this.startUnix);
+		const totals = [...this.rows.values()].reduce(
+			(sum, row) => ({
+				output: sum.output + row.output,
+				prompt: sum.prompt + row.prompt,
+				cached: sum.cached + row.cached,
+			}),
+			{ output: 0, prompt: 0, cached: 0 },
+		);
+		const reuse = totals.prompt > 0 ? `${((100 * totals.cached) / totals.prompt).toFixed(0)}%` : "-";
+		const engine = this.engine;
+		const lines = [
+			`${this.title}  ·  ${formatClock(elapsed)}  ·  ${this.header}`,
+			`engine: active ${engine.active ?? "n/a"} queued ${engine.queued ?? "n/a"} KV free ${engine.kvFree === null ? "n/a" : `${(engine.kvFree * 100).toFixed(0)}%`} shared-prefix ${engine.sharedPrefix ?? "n/a"}  ·  prompt cache reuse ${reuse}  ·  output ${totals.output} tok`,
+			"",
+			"call t/s = output / full observed call time; includes queue and prefill",
+			`${pad("agent", 14)}${pad("state", 12)}${pad("for", 7)}${pad("calls", 6)}${pad("call t/s", 9)}${pad("out", 8)}${pad("cache", 7)}${pad("checks", 16)}${pad("cmp", 4)}last write`,
+		];
+		for (const row of this.rows.values()) {
+			const state = row.queued ? "queued" : row.state;
+			const cache = row.prompt > 0 ? `${((100 * row.cached) / row.prompt).toFixed(0)}%` : "-";
+			lines.push(
+				`${pad(row.agent, 14)}${pad(state, 12)}${pad(formatClock(now - row.since), 7)}${pad(String(row.calls), 6)}${pad(row.tokPerSec === null ? "-" : row.tokPerSec.toFixed(1), 9)}${pad(String(row.output), 8)}${pad(cache, 7)}${pad(row.ownedChecks, 16)}${pad(String(row.compactions), 4)}${row.lastWrite}`,
+			);
+		}
+		if (this.roundResults.length > 0) lines.push("", ...this.roundResults);
+		if (this.notes.length > 0) lines.push("", ...this.notes);
+		const width = this.out.columns ?? 120;
+		const clipped = lines.map((line) => (line.length > width ? `${line.slice(0, width - 1)}…` : line));
+		const rewind = this.lastLines > 0 ? `\x1b[${this.lastLines}F` : "";
+		this.out.write(`${rewind}\x1b[J${clipped.join("\n")}\n`);
+		this.lastLines = clipped.length;
+	}
+}
+
+function pad(text: string, width: number): string {
+	return text.length >= width ? `${text.slice(0, width - 1)} ` : text.padEnd(width);
+}
+
+function formatClock(seconds: unknown): string {
+	const total = Math.max(0, Math.floor(Number(seconds) || 0));
+	return `${Math.floor(total / 60)}:${String(total % 60).padStart(2, "0")}`;
+}
diff --git a/packages/fleetpi/src/workspace/path-guard.ts b/packages/fleetpi/src/workspace/path-guard.ts
new file mode 100644
index 0000000..e690c88
--- /dev/null
+++ b/packages/fleetpi/src/workspace/path-guard.ts
@@ -0,0 +1,158 @@
+// Filesystem guard applied beneath Pi's real built-in read/edit/write/ls tools, identically in every mode.
+
+import { constants, realpathSync } from "node:fs";
+import { access, lstat, mkdir, readdir, readFile, realpath, stat, writeFile } from "node:fs/promises";
+import { basename, dirname, isAbsolute, join, relative, sep } from "node:path";
+import type { EditOperations, LsOperations, ReadOperations, WriteOperations } from "@earendil-works/pi-coding-agent";
+
+/** Why an access was refused. */
+export type GuardDenial =
+	| { kind: "outside-workspace"; path: string }
+	| { kind: "not-writable"; path: string; writable: readonly string[] }
+	| { kind: "symlink"; path: string };
+
+/** Notification for every refused access and every completed write. */
+export interface PathGuardHooks {
+	onDenied?: (denial: GuardDenial, operation: string) => void;
+	onWrite?: (relativePath: string, content: string, operation: string) => void;
+}
+
+/** Error surfaced to the model as a failed tool result. */
+export class PathGuardError extends Error {
+	readonly denial: GuardDenial;
+
+	constructor(denial: GuardDenial) {
+		super(describeDenial(denial));
+		this.name = "PathGuardError";
+		this.denial = denial;
+	}
+}
+
+/** Confines one agent to its workspace: reads anywhere inside it, writes only to owned files. */
+export class PathGuard {
+	readonly root: string;
+	readonly writable: readonly string[];
+	private readonly writableSet: ReadonlySet<string>;
+	private readonly hooks: PathGuardHooks;
+
+	constructor(root: string, writableFiles: readonly string[], hooks: PathGuardHooks = {}) {
+		// The root is canonicalized once so /var vs /private/var aliases cannot bypass checks.
+		this.root = realpathSync(root);
+		this.writable = [...writableFiles];
+		this.writableSet = new Set(writableFiles);
+		this.hooks = hooks;
+	}
+
+	/** Workspace-relative POSIX path of a canonical location, or undefined when outside. */
+	relativeOf(canonicalPath: string): string | undefined {
+		const rel = relative(this.root, canonicalPath);
+		if (rel === "") return ".";
+		if (rel.startsWith("..") || isAbsolute(rel)) return undefined;
+		return rel.split(sep).join("/");
+	}
+
+	/** Resolve symlinks of an existing path, or of the parent of a path that does not exist yet. */
+	async canonical(absolutePath: string): Promise<string> {
+		try {
+			return await realpath(absolutePath);
+		} catch {
+			// A missing parent cannot be canonicalized; the lexical path then fails the
+			// containment or ownership check, which keeps the guard closed.
+			const parent = await realpath(dirname(absolutePath)).catch(() => dirname(absolutePath));
+			return join(parent, basename(absolutePath));
+		}
+	}
+
+	/** Refuse reads that resolve outside the workspace. */
+	async assertReadable(absolutePath: string, operation: string): Promise<string> {
+		const canonicalPath = await this.canonical(absolutePath);
+		if (this.relativeOf(canonicalPath) === undefined)
+			this.deny({ kind: "outside-workspace", path: absolutePath }, operation);
+		return canonicalPath;
+	}
+
+	/** Refuse writes to anything except the exact owned files, including symlinked aliases. */
+	async assertWritable(absolutePath: string, operation: string): Promise<string> {
+		const canonicalPath = await this.canonical(absolutePath);
+		const rel = this.relativeOf(canonicalPath);
+		if (rel === undefined) this.deny({ kind: "outside-workspace", path: absolutePath }, operation);
+		if (!this.writableSet.has(rel as string)) {
+			this.deny({ kind: "not-writable", path: rel as string, writable: this.writable }, operation);
+		}
+		const info = await lstat(absolutePath).catch(() => undefined);
+		if (info?.isSymbolicLink()) this.deny({ kind: "symlink", path: rel as string }, operation);
+		return canonicalPath;
+	}
+
+	/** Operations for Pi's read tool. */
+	readOperations(): ReadOperations {
+		return {
+			readFile: async (path) => readFile(await this.assertReadable(path, "read")),
+			access: async (path) => access(await this.assertReadable(path, "read"), constants.R_OK),
+		};
+	}
+
+	/** Operations for Pi's edit tool: the edited file must be owned. */
+	editOperations(): EditOperations {
+		return {
+			readFile: async (path) => readFile(await this.assertWritable(path, "edit")),
+			access: async (path) => access(await this.assertWritable(path, "edit"), constants.R_OK | constants.W_OK),
+			writeFile: async (path, content) => this.guardedWrite(path, content, "edit"),
+		};
+	}
+
+	/** Operations for Pi's write tool. */
+	writeOperations(): WriteOperations {
+		return {
+			writeFile: async (path, content) => this.guardedWrite(path, content, "write"),
+			// Owned files live in existing directories; creating new directories is never needed.
+			mkdir: async (dir) => {
+				const canonicalDir = await this.assertReadable(dir, "write");
+				const ownsChild = this.writable.some((file) => join(this.root, dirname(file)) === canonicalDir);
+				if (!ownsChild)
+					this.deny(
+						{ kind: "not-writable", path: this.relativeOf(canonicalDir) ?? dir, writable: this.writable },
+						"write",
+					);
+				await mkdir(canonicalDir, { recursive: true });
+			},
+		};
+	}
+
+	/** Operations for Pi's ls tool. */
+	lsOperations(): LsOperations {
+		return {
+			exists: async (path) => {
+				const canonicalPath = await this.assertReadable(path, "ls");
+				return access(canonicalPath).then(
+					() => true,
+					() => false,
+				);
+			},
+			stat: async (path) => stat(await this.assertReadable(path, "ls")),
+			readdir: async (path) => readdir(await this.assertReadable(path, "ls")),
+		};
+	}
+
+	private async guardedWrite(path: string, content: string, operation: string): Promise<void> {
+		const canonicalPath = await this.assertWritable(path, operation);
+		await writeFile(canonicalPath, content, "utf-8");
+		this.hooks.onWrite?.(this.relativeOf(canonicalPath) as string, content, operation);
+	}
+
+	private deny(denial: GuardDenial, operation: string): never {
+		this.hooks.onDenied?.(denial, operation);
+		throw new PathGuardError(denial);
+	}
+}
+
+function describeDenial(denial: GuardDenial): string {
+	switch (denial.kind) {
+		case "outside-workspace":
+			return `Access denied: ${denial.path} is outside the project workspace.`;
+		case "not-writable":
+			return `Access denied: ${denial.path} is read-only for you. You may modify only: ${denial.writable.join(", ")}.`;
+		case "symlink":
+			return `Access denied: ${denial.path} is a symbolic link.`;
+	}
+}
diff --git a/packages/fleetpi/src/workspace/workspace.ts b/packages/fleetpi/src/workspace/workspace.ts
new file mode 100644
index 0000000..1d0d8c0
--- /dev/null
+++ b/packages/fleetpi/src/workspace/workspace.ts
@@ -0,0 +1,71 @@
+// Prepares the agent-editable workspace and proves that protected task files stay unchanged.
+
+import { createHash } from "node:crypto";
+import { cpSync, existsSync, readdirSync, readFileSync, statSync } from "node:fs";
+import { join, relative, sep } from "node:path";
+import type { FestivalTask } from "../task/festival-task.ts";
+
+/** SHA-256 of a byte string, hex encoded. */
+export function sha256(data: string | Uint8Array): string {
+	return createHash("sha256").update(data).digest("hex");
+}
+
+/** Copy the fixture into a fresh workspace directory (refuses to overwrite an existing one). */
+export function prepareWorkspace(task: FestivalTask, workspace: string): void {
+	if (existsSync(workspace)) throw new Error(`workspace already exists: ${workspace}`);
+	cpSync(task.fixtureDir, workspace, { recursive: true, errorOnExist: true, force: false });
+	for (const file of [...task.editableFiles, ...task.readOnlyFiles]) {
+		if (!existsSync(join(workspace, file))) throw new Error(`fixture is missing ${file}`);
+	}
+}
+
+/** Hashes of every editable page, keyed by workspace-relative path. */
+export function pageHashes(task: FestivalTask, workspace: string): Record<string, string> {
+	return Object.fromEntries(task.editableFiles.map((file) => [file, sha256(readFileSync(join(workspace, file)))]));
+}
+
+/** A recorded hash snapshot of files agents must never change. */
+export interface ProtectedSnapshot {
+	files: Record<string, string>;
+}
+
+/** Thrown when a protected file changed; the run cannot be scored. */
+export class ProtectedFileError extends Error {
+	readonly changed: string[];
+
+	constructor(changed: string[]) {
+		super(`protected files changed: ${changed.join(", ")}`);
+		this.name = "ProtectedFileError";
+		this.changed = changed;
+	}
+}
+
+/** Hash the checker, renderer, manifest, fixture and the workspace's read-only files. */
+export function snapshotProtectedFiles(task: FestivalTask, workspace: string): ProtectedSnapshot {
+	const files: Record<string, string> = {};
+	for (const path of listFiles(task.taskDir)) {
+		const rel = relative(task.taskDir, path).split(sep).join("/");
+		if (rel.startsWith("__pycache__/") || rel.includes("/__pycache__/")) continue;
+		files[`task:${rel}`] = sha256(readFileSync(path));
+	}
+	for (const file of task.readOnlyFiles) files[`workspace:${file}`] = sha256(readFileSync(join(workspace, file)));
+	return { files };
+}
+
+/** Recompute the snapshot and throw ProtectedFileError on any difference. */
+export function verifyProtectedFiles(task: FestivalTask, workspace: string, expected: ProtectedSnapshot): void {
+	const current = snapshotProtectedFiles(task, workspace).files;
+	const names = new Set([...Object.keys(expected.files), ...Object.keys(current)]);
+	const changed = [...names].filter((name) => expected.files[name] !== current[name]).sort();
+	if (changed.length > 0) throw new ProtectedFileError(changed);
+}
+
+function listFiles(dir: string): string[] {
+	const out: string[] = [];
+	for (const name of readdirSync(dir)) {
+		const path = join(dir, name);
+		if (statSync(path).isDirectory()) out.push(...listFiles(path));
+		else out.push(path);
+	}
+	return out.sort();
+}
diff --git a/packages/fleetpi/test/admission-queue.test.ts b/packages/fleetpi/test/admission-queue.test.ts
new file mode 100644
index 0000000..d108452
--- /dev/null
+++ b/packages/fleetpi/test/admission-queue.test.ts
@@ -0,0 +1,230 @@
+import { fauxAssistantMessage, fauxToolCall } from "@earendil-works/pi-ai/compat";
+import { afterEach, describe, expect, it } from "vitest";
+import { AdmissionQueue, type Permit, type PressureSample } from "../src/fleet/admission-queue.ts";
+import type { AgentAssignment } from "../src/task/festival-task.ts";
+import {
+	agentContext,
+	createFaux,
+	createRunFixture,
+	fakeChecker,
+	HOME,
+	openAgent,
+	rawCheckResult,
+	scriptTurns,
+	toolTurn,
+} from "./support.ts";
+
+function clockQueue(permits: number, pressure?: () => PressureSample | undefined) {
+	let now = 0;
+	const queue = new AdmissionQueue({ permits, agingMs: 1000, pressurePollMs: 5, pressure, now: () => now });
+	return {
+		queue,
+		advance: (ms: number) => {
+			now += ms;
+			return now;
+		},
+	};
+}
+
+describe("AdmissionQueue permits", () => {
+	it("grants up to the permit count and hands released slots to waiters", async () => {
+		const { queue } = clockQueue(2);
+		const a = await queue.acquire("a", "fresh");
+		const b = await queue.acquire("b", "fresh");
+		let cGranted: Permit | undefined;
+		const c = queue.acquire("c", "fresh").then((permit) => {
+			cGranted = permit;
+		});
+		await Promise.resolve();
+		expect(queue.free).toBe(0);
+		expect(cGranted).toBeUndefined();
+		a?.release();
+		await c;
+		expect(cGranted?.agentId).toBe("c");
+		b?.release();
+		cGranted?.release();
+		expect(queue.free).toBe(2);
+	});
+
+	it("releases exactly once even when release is called repeatedly", async () => {
+		const { queue } = clockQueue(1);
+		const permit = await queue.acquire("a", "fresh");
+		permit?.release();
+		permit?.release();
+		expect(queue.free).toBe(1);
+	});
+
+	it("an aborted waiter never takes or leaks a slot", async () => {
+		const { queue } = clockQueue(1);
+		const held = await queue.acquire("a", "fresh");
+		const controller = new AbortController();
+		const waiting = queue.acquire("b", "fresh", controller.signal);
+		expect(queue.waiting).toBe(1);
+		controller.abort();
+		expect(await waiting).toBeUndefined();
+		expect(queue.waiting).toBe(0);
+		held?.release();
+		expect(queue.free).toBe(1);
+		expect(await queue.acquire("c", "fresh", AbortSignal.abort())).toBeUndefined();
+		expect(queue.free).toBe(1);
+	});
+
+	it("a failed request releases its slot through finally", async () => {
+		const { queue } = clockQueue(1);
+		const failing = async () => {
+			const permit = await queue.acquire("a", "fresh");
+			try {
+				throw new Error("provider failed");
+			} finally {
+				permit?.release();
+			}
+		};
+		await expect(failing()).rejects.toThrow("provider failed");
+		expect(queue.free).toBe(1);
+		const next = await queue.acquire("b", "fresh");
+		expect(next?.agentId).toBe("b");
+	});
+});
+
+describe("AdmissionQueue priority and aging", () => {
+	it("prefers repairs over fresh work that arrived at about the same time", async () => {
+		const { queue, advance } = clockQueue(1);
+		const held = await queue.acquire("holder", "fresh");
+		const order: string[] = [];
+		const fresh = queue.acquire("fresh", "fresh").then((p) => order.push(p?.agentId ?? "none"));
+		advance(10);
+		const repair = queue.acquire("repair", "repair").then((p) => {
+			order.push(p?.agentId ?? "none");
+			p?.release();
+		});
+		held?.release();
+		await repair;
+		await fresh;
+		expect(order).toEqual(["repair", "fresh"]);
+	});
+
+	it("ages a long-waiting fresh request ahead of a new repair (no starvation)", async () => {
+		const { queue, advance } = clockQueue(1);
+		const held = await queue.acquire("holder", "fresh");
+		const order: string[] = [];
+		const fresh = queue.acquire("old-fresh", "fresh").then((p) => {
+			order.push(p?.agentId ?? "none");
+			p?.release();
+		});
+		advance(1500);
+		const repair = queue.acquire("new-repair", "repair").then((p) => order.push(p?.agentId ?? "none"));
+		held?.release();
+		await fresh;
+		await repair;
+		expect(order).toEqual(["old-fresh", "new-repair"]);
+	});
+});
+
+describe("AdmissionQueue memory pressure", () => {
+	it("holds new work while KV is full and one of ours is running, then admits", async () => {
+		let blocked = true;
+		const { queue } = clockQueue(4, () => ({ blocked, kvFreeFraction: blocked ? 0.01 : 0.5 }));
+		const first = await queue.acquire("a", "fresh");
+		let second: Permit | undefined;
+		const waiting = queue.acquire("b", "fresh").then((permit) => {
+			second = permit;
+		});
+		await new Promise((resolve) => setTimeout(resolve, 20));
+		expect(second).toBeUndefined();
+		blocked = false;
+		queue.pump();
+		await waiting;
+		expect(second?.agentId).toBe("b");
+		first?.release();
+		second?.release();
+		queue.dispose();
+	});
+
+	it("never blocks when nothing of ours is running", async () => {
+		const { queue } = clockQueue(2, () => ({ blocked: true, kvFreeFraction: 0 }));
+		const permit = await queue.acquire("a", "fresh");
+		expect(permit?.agentId).toBe("a");
+		permit?.release();
+		queue.dispose();
+	});
+});
+
+describe("fleet extension admission around real Pi requests", () => {
+	const cleanups: Array<() => void> = [];
+	afterEach(() => {
+		while (cleanups.length > 0) cleanups.pop()?.();
+	});
+
+	it("frees the decode slot during a tool wait so another agent can stream", async () => {
+		let releaseChecker: () => void = () => {};
+		const checkerGate = new Promise<void>((resolve) => {
+			releaseChecker = resolve;
+		});
+		let checkerStarted: () => void = () => {};
+		const checkerRunning = new Promise<void>((resolve) => {
+			checkerStarted = resolve;
+		});
+		const checker = fakeChecker(async (round) => {
+			checkerStarted();
+			await checkerGate;
+			return rawCheckResult(fixture.task, round);
+		});
+		const fixture = createRunFixture("admission", "fleet8", checker.command);
+		cleanups.push(fixture.cleanup);
+		const queue = new AdmissionQueue({
+			permits: 1,
+			agingMs: 20000,
+			pressurePollMs: 50,
+			listener: (event) => fixture.log.emit("admission", { ...event }),
+		});
+		const homeFaux = await createFaux("admission-home", fixture.outputDir);
+		const lineupFaux = await createFaux("admission-lineup", fixture.outputDir);
+		cleanups.push(homeFaux.cleanup, lineupFaux.cleanup);
+		const lineup: AgentAssignment = {
+			agentId: "lineup",
+			name: "Lineup page designer",
+			ownedFiles: ["pages/lineup.html"],
+		};
+		const home = await openAgent(HOME, agentContext(fixture, homeFaux, { enhanced: true, queue }));
+		const other = await openAgent(lineup, agentContext(fixture, lineupFaux, { enhanced: true, queue }));
+		cleanups.push(
+			() => home.dispose(),
+			() => other.dispose(),
+		);
+		scriptTurns(homeFaux, [toolTurn(fauxToolCall("check_site", {})), fauxAssistantMessage("home done")]);
+		scriptTurns(lineupFaux, [fauxAssistantMessage("lineup done")]);
+
+		const homeTask = home.runTask({ round: 1, kind: "round", prompt: "home", issuedAtUnix: 0 });
+		await checkerRunning;
+		// home holds no slot while its check_site tool runs, so lineup streams to completion.
+		const lineupOutcome = await other.runTask({ round: 1, kind: "round", prompt: "lineup", issuedAtUnix: 0 });
+		expect(lineupOutcome).toBe("settled");
+		releaseChecker();
+		expect(await homeTask).toBe("settled");
+		expect(queue.free).toBe(1);
+		const grants = fixture.events.filter((event) => event.event === "admission" && event.action === "grant");
+		expect(grants.map((event) => event.agentId)).toEqual(["home", "lineup", "home"]);
+	});
+
+	it("an aborted task releases its slot", async () => {
+		const checker = fakeChecker((round) => rawCheckResult(fixture.task, round));
+		const fixture = createRunFixture("admission-abort", "fleet8", checker.command);
+		cleanups.push(fixture.cleanup);
+		const queue = new AdmissionQueue({ permits: 1, agingMs: 20000, pressurePollMs: 50 });
+		const faux = await createFaux("admission-abort", fixture.outputDir);
+		cleanups.push(faux.cleanup);
+		const blocker = await queue.acquire("someone-else", "fresh");
+		const agent = await openAgent(HOME, agentContext(fixture, faux, { enhanced: true, queue }));
+		cleanups.push(() => agent.dispose());
+		scriptTurns(faux, [fauxAssistantMessage("never reached")]);
+		const task = agent.runTask({ round: 1, kind: "round", prompt: "wait for a slot", issuedAtUnix: 0 });
+		await new Promise((resolve) => setTimeout(resolve, 50));
+		expect(queue.waiting).toBe(1);
+		await agent.abort();
+		await task;
+		expect(queue.waiting).toBe(0);
+		blocker?.release();
+		expect(queue.free).toBe(1);
+		expect(agent.ledger.state.pendingTask?.prompt).toBe("wait for a slot");
+	});
+});
