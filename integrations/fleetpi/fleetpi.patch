+// Bounded ready queue for engine decode slots: priorities with aging, KV-pressure gating, abort-safe permits.
+
+/** Why an agent wants a slot; repairs of failing checks go first unless others have aged. */
+export type AdmissionPriority = "repair" | "continue" | "fresh";
+
+/** Engine memory pressure sample; blocked means new work should not be admitted yet. */
+export interface PressureSample {
+	blocked: boolean;
+	kvFreeFraction: number | null;
+}
+
+/** A granted decode slot. Releasing twice is a no-op. */
+export interface Permit {
+	readonly agentId: string;
+	readonly waitedMs: number;
+	release(): void;
+}
+
+/** Observability hook for grants, waits and releases. */
+export type AdmissionListener = (event: {
+	action: "wait" | "grant" | "release" | "abort";
+	agentId: string;
+	waitMs: number;
+	permitsFree: number;
+	waiting: number;
+	kvFreeFraction: number | null;
+}) => void;
+
+/** Construction options. */
+export interface AdmissionQueueOptions {
+	permits: number;
+	/** A waiter older than this outranks any newer waiter regardless of priority. */
+	agingMs: number;
+	/** How often a pressure-blocked queue re-samples. */
+	pressurePollMs: number;
+	pressure?: () => PressureSample | undefined;
+	listener?: AdmissionListener;
+	now?: () => number;
+}
+
+interface Waiter {
+	agentId: string;
+	priority: AdmissionPriority;
+	enqueuedAt: number;
+	resolve: (permit: Permit | undefined) => void;
+	detach: () => void;
+}
+
+const PRIORITY_RANK: Record<AdmissionPriority, number> = { repair: 0, continue: 1, fresh: 2 };
+
+/** FIFO-with-priority admission controller with aging. */
+export class AdmissionQueue {
+	private permits: number;
+	private held = 0;
+	private readonly waiters: Waiter[] = [];
+	private readonly options: AdmissionQueueOptions;
+	private readonly now: () => number;
+	private pollTimer: ReturnType<typeof setTimeout> | undefined;
+
+	constructor(options: AdmissionQueueOptions) {
+		if (options.permits < 1) throw new Error("admission needs at least one permit");
+		this.options = options;
+		this.permits = options.permits;
+		this.now = options.now ?? (() => performance.now());
+	}
+
+	/** Free slots right now. */
+	get free(): number {
+		return this.permits - this.held;
+	}
+
+	/** Number of waiting agents. */
+	get waiting(): number {
+		return this.waiters.length;
+	}
+
+	/** Change the slot count (e.g. after reading engine capabilities). */
+	setPermits(permits: number): void {
+		if (permits < 1) throw new Error("admission needs at least one permit");
+		this.permits = permits;
+		this.pump();
+	}
+
+	/** Wait for a slot. Resolves undefined if the signal aborts first; never leaks a slot. */
+	acquire(agentId: string, priority: AdmissionPriority, signal?: AbortSignal): Promise<Permit | undefined> {
+		if (signal?.aborted) return Promise.resolve(undefined);
+		return new Promise((resolve) => {
+			const waiter: Waiter = {
+				agentId,
+				priority,
+				enqueuedAt: this.now(),
+				resolve,
+				detach: () => {},
+			};
+			if (signal) {
+				const onAbort = () => {
+					const index = this.waiters.indexOf(waiter);
+					if (index < 0) return;
+					this.waiters.splice(index, 1);
+					this.emit("abort", agentId, this.now() - waiter.enqueuedAt);
+					resolve(undefined);
+					this.pump();
+				};
+				signal.addEventListener("abort", onAbort, { once: true });
+				waiter.detach = () => signal.removeEventListener("abort", onAbort);
+			}
+			this.waiters.push(waiter);
+			this.pump();
+			if (this.waiters.includes(waiter)) this.emit("wait", agentId, 0);
+		});
+	}
+
+	/** Re-evaluate waiters, e.g. after a fresh engine stats sample. Returns true if anything was granted. */
+	pump(): boolean {
+		let granted = false;
+		while (this.waiters.length > 0 && this.held < this.permits) {
+			const pressure = this.options.pressure?.();
+			// Never block when nothing of ours is running: that would wait forever.
+			if (pressure?.blocked && this.held > 0) {
+				this.schedulePoll();
+				break;
+			}
+			const waiter = this.next();
+			this.waiters.splice(this.waiters.indexOf(waiter), 1);
+			waiter.detach();
+			this.held++;
+			const waitedMs = this.now() - waiter.enqueuedAt;
+			this.emit("grant", waiter.agentId, waitedMs);
+			waiter.resolve(this.makePermit(waiter.agentId, waitedMs));
+			granted = true;
+		}
+		return granted;
+	}
+
+	/** Stop any pending pressure poll timer. */
+	dispose(): void {
+		if (this.pollTimer) clearTimeout(this.pollTimer);
+		this.pollTimer = undefined;
+	}
+
+	// Lowest key wins: enqueue time plus a priority offset of up to one aging period,
+	// so a fresh waiter that has waited agingMs outranks a repair that just arrived.
+	private next(): Waiter {
+		const half = this.options.agingMs / 2;
+		let best = this.waiters[0];
+		let bestKey = best.enqueuedAt + PRIORITY_RANK[best.priority] * half;
+		for (const waiter of this.waiters.slice(1)) {
+			const key = waiter.enqueuedAt + PRIORITY_RANK[waiter.priority] * half;
+			if (key < bestKey) {
+				best = waiter;
+				bestKey = key;
+			}
+		}
+		return best;
+	}
+
+	private makePermit(agentId: string, waitedMs: number): Permit {
+		let released = false;
+		return {
+			agentId,
+			waitedMs,
+			release: () => {
+				if (released) return;
+				released = true;
+				this.held--;
+				this.emit("release", agentId, 0);
+				this.pump();
+			},
+		};
+	}
+
+	private schedulePoll(): void {
+		if (this.pollTimer) return;
+		this.pollTimer = setTimeout(() => {
+			this.pollTimer = undefined;
+			this.pump();
+		}, this.options.pressurePollMs);
+		this.pollTimer.unref?.();
+	}
+
+	private emit(action: "wait" | "grant" | "release" | "abort", agentId: string, waitMs: number): void {
+		this.options.listener?.({
+			action,
+			agentId,
+			waitMs,
+			permitsFree: this.free,
+			waiting: this.waiters.length,
+			kvFreeFraction: this.options.pressure?.()?.kvFreeFraction ?? null,
+		});
+	}
+}
