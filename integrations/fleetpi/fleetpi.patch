+// Model-free test support: real festival manifest, faux Pi provider, and a fake protected checker.
+
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import {
+	type Api,
+	type AssistantMessage,
+	getCurrentSystemPrompt,
+	type Model,
+	type ToolCall,
+} from "@earendil-works/pi-ai";
+import {
+	type FauxProviderRegistration,
+	type FauxResponseFactory,
+	fauxAssistantMessage,
+	registerFauxProvider,
+} from "@earendil-works/pi-ai/compat";
+import { ModelRuntime } from "@earendil-works/pi-coding-agent";
+import { type CheckCommand, CheckerService } from "../src/checker/checker-service.ts";
+import { AdmissionQueue } from "../src/fleet/admission-queue.ts";
+import { type AgentContext, AgentRuntime } from "../src/run/agent-runtime.ts";
+import { EventLog } from "../src/run/event-log.ts";
+import type { SessionSettings } from "../src/session/open-session.ts";
+import { type AgentAssignment, type FestivalTask, loadFestivalTask, pageNameOf } from "../src/task/festival-task.ts";
+import { sharedProjectContext } from "../src/task/prompts.ts";
+import type { FestivalMode, FleetEvent } from "../src/types.ts";
+import { prepareWorkspace, snapshotProtectedFiles } from "../src/workspace/workspace.ts";
+
+// test/ -> fleetpi -> packages -> pi -> vendor -> fleetpi -> integrations -> repository root
+export const TASK_DIR =
+	process.env.FLEETPI_TASK_DIR ??
+	fileURLToPath(new URL("../../../../../../../demos/agent-task-bench/tasks/festival-site", import.meta.url));
+
+/** A fresh temporary directory removed by the returned cleanup. */
+export function tempDir(prefix: string): { dir: string; cleanup: () => void } {
+	const dir = mkdtempSync(join(tmpdir(), `fleetpi-${prefix}-`));
+	return { dir, cleanup: () => rmSync(dir, { recursive: true, force: true }) };
+}
+
+/** A faux provider wired into a real ModelRuntime, as Pi's own SDK tests do. */
+export interface FauxSetup {
+	faux: FauxProviderRegistration;
+	runtime: ModelRuntime;
+	model: Model<Api>;
+	cleanup: () => void;
+}
+
+/** Register a uniquely named faux provider and a ModelRuntime that resolves it. */
+export async function createFaux(name: string, dir: string, contextWindow = 96000): Promise<FauxSetup> {
+	const faux = registerFauxProvider({
+		api: `faux-${name}`,
+		provider: `faux-${name}`,
+		models: [{ id: "faux-glimmer", reasoning: true, contextWindow, maxTokens: 4096 }],
+	});
+	const runtime = await ModelRuntime.create({
+		authPath: join(dir, "auth.json"),
+		modelsPath: null,
+		allowModelNetwork: false,
+	});
+	const registered = faux.getModel();
+	runtime.registerProvider(registered.provider, {
+		baseUrl: registered.baseUrl,
+		apiKey: "faux-key",
+		api: faux.api,
+		models: faux.models.map((model) => ({
+			id: model.id,
+			name: model.name,
+			api: model.api,
+			reasoning: model.reasoning,
+			input: model.input,
+			cost: model.cost,
+			contextWindow: model.contextWindow,
+			maxTokens: model.maxTokens,
+		})),
+	});
+	const model = runtime.getModel(registered.provider, registered.id) ?? (registered as Model<Api>);
+	return { faux, runtime, model, cleanup: () => faux.unregister() };
+}
+
+/** Raw checker JSON shaped like browser-check.mjs output; listed pages fail one check each. */
+export function rawCheckResult(task: FestivalTask, round: number, failingFiles: readonly string[] = []) {
+	const checks: Array<{ name: string; passed: boolean }> = [];
+	const failures: string[] = [];
+	for (const file of task.editableFiles) {
+		const page = pageNameOf(file);
+		checks.push({ name: `${page}: custom CSS`, passed: true });
+		const failing = failingFiles.includes(file);
+		checks.push({ name: `${page}/390px: primary action`, passed: !failing });
+		if (failing) failures.push(`${page}/390px: primary action: requirement not met`);
+	}
+	checks.push({ name: "no browser errors or unexpected requests", passed: true });
+	return { passed: failures.length === 0, round, checks, failures, errors: [] };
+}
+
+/** A checker command that answers from a function and counts invocations. */
+export function fakeChecker(answer: (round: number) => unknown | Promise<unknown>): {
+	command: CheckCommand;
+	calls: () => number;
+} {
+	let calls = 0;
+	return {
+		command: async ({ round }) => {
+			calls++;
+			return answer(round);
+		},
+		calls: () => calls,
+	};
+}
+
+/** Everything needed to drive AgentRuntime instances against a prepared workspace. */
+export interface RunFixture {
+	task: FestivalTask;
+	outputDir: string;
+	workspace: string;
+	log: EventLog;
+	events: FleetEvent[];
+	checker: CheckerService;
+	cleanup: () => void;
+}
+
+/** Prepare a workspace copy of the real fixture plus an event log and checker. */
+export function createRunFixture(name: string, mode: FestivalMode, command: CheckCommand): RunFixture {
+	const { dir, cleanup } = tempDir(name);
+	const task = loadFestivalTask(TASK_DIR);
+	const workspace = join(dir, "workspace");
+	prepareWorkspace(task, workspace);
+	const log = new EventLog(join(dir, "events.jsonl"), mode, Date.now() / 1000);
+	const events: FleetEvent[] = [];
+	log.subscribe((event) => events.push(event));
+	log.setRound(1, task.rounds[0].title);
+	const checker = new CheckerService({
+		task,
+		workspace,
+		outputDir: dir,
+		protectedSnapshot: snapshotProtectedFiles(task, workspace),
+		concurrency: 2,
+		command,
+	});
+	return { task, outputDir: dir, workspace, log, events, checker, cleanup };
+}
+
+/** Build an AgentContext for a fixture; enhanced contexts get an admission queue. */
+export function agentContext(
+	fixture: RunFixture,
+	faux: FauxSetup,
+	options: { enhanced: boolean; queue?: AdmissionQueue; sessionSettings?: SessionSettings },
+): AgentContext {
+	const queue = options.enhanced
+		? (options.queue ?? new AdmissionQueue({ permits: 8, agingMs: 20000, pressurePollMs: 50 }))
+		: undefined;
+	return {
+		task: fixture.task,
+		workspace: fixture.workspace,
+		outputDir: fixture.outputDir,
+		agentDir: join(fixture.outputDir, "pi-agent"),
+		log: fixture.log,
+		checker: fixture.checker,
+		modelRuntime: faux.runtime,
+		model: faux.model,
+		maxTurnsPerRound: 40,
+		fleet: queue ? { queue, sharedContext: sharedProjectContext(fixture.task, fixture.workspace) } : undefined,
+		sessionSettings: options.sessionSettings,
+	};
+}
+
+/** The single-page assignment for pages/home.html. */
+export const HOME: AgentAssignment = { agentId: "home", name: "Home page designer", ownedFiles: ["pages/home.html"] };
+
+/** Open an AgentRuntime for an assignment. */
+export async function openAgent(
+	assignment: AgentAssignment,
+	context: AgentContext,
+	resume = false,
+): Promise<AgentRuntime> {
+	const agent = new AgentRuntime(assignment, context, resume);
+	await agent.open();
+	return agent;
+}
+
+/**
+ * Script agent turns in order, while answering Pi's compaction summarization requests (one or
+ * two per compaction, depending on split turns) independently of that order.
+ */
+export function scriptTurns(
+	setup: FauxSetup,
+	turns: AssistantMessage[],
+): { summaries: () => number; remaining: () => number } {
+	let next = 0;
+	let summaries = 0;
+	const factory: FauxResponseFactory = (context) => {
+		if (getCurrentSystemPrompt(context.messages).includes("context summarization assistant")) {
+			summaries++;
+			return fauxAssistantMessage(`## Goal\nBuild the festival page.\n\n## Progress\nsummary ${summaries}`);
+		}
+		const turn = turns[next++];
+		if (!turn) throw new Error("faux script exhausted");
+		return turn;
+	};
+	setup.faux.setResponses(Array.from({ length: turns.length + 16 }, () => factory));
+	return { summaries: () => summaries, remaining: () => turns.length - next };
+}
+
+/** A scripted assistant turn that calls tools (stopReason toolUse, as a real provider reports). */
+export function toolTurn(...calls: ToolCall[]): AssistantMessage {
+	return fauxAssistantMessage(calls, { stopReason: "toolUse" });
+}
+
+/** Text of a message content value. */
+export function textOf(content: unknown): string {
+	if (typeof content === "string") return content;
+	if (!Array.isArray(content)) return "";
+	return content
+		.filter((part): part is { type: "text"; text: string } => part?.type === "text")
+		.map((part) => part.text)
+		.join("\n");
+}
