@@ -0,0 +1,113 @@
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import type { ToolResultMessage } from "@earendil-works/pi-ai";
+import { fauxAssistantMessage, fauxToolCall } from "@earendil-works/pi-ai/compat";
+import { afterEach, describe, expect, it } from "vitest";
+import { FESTIVAL_TOOL_NAMES } from "../src/tools/common-tools.ts";
+import {
+	agentContext,
+	createFaux,
+	createRunFixture,
+	fakeChecker,
+	HOME,
+	openAgent,
+	rawCheckResult,
+	textOf,
+	toolTurn,
+} from "./support.ts";
+
+describe("real Pi built-in tools through the common guard", () => {
+	const cleanups: Array<() => void> = [];
+	afterEach(() => {
+		while (cleanups.length > 0) cleanups.pop()?.();
+	});
+
+	async function setup(name: string, enhanced: boolean) {
+		const checker = fakeChecker((round) => rawCheckResult(fixture.task, round, ["pages/home.html"]));
+		const fixture = createRunFixture(name, enhanced ? "fleet8" : "vllm8", checker.command);
+		cleanups.push(fixture.cleanup);
+		const faux = await createFaux(name, fixture.outputDir);
+		cleanups.push(faux.cleanup);
+		const agent = await openAgent(HOME, agentContext(fixture, faux, { enhanced }));
+		cleanups.push(() => agent.dispose());
+		return { fixture, faux, agent, checker };
+	}
+
+	function toolResults(agent: Awaited<ReturnType<typeof setup>>["agent"]): ToolResultMessage[] {
+		return agent.piSession.messages.filter((message): message is ToolResultMessage => message.role === "toolResult");
+	}
+
+	it("exposes exactly read, edit, write, ls and check_site (no bash)", async () => {
+		const { agent } = await setup("toolset", false);
+		expect(agent.piSession.getActiveToolNames().sort()).toEqual([...FESTIVAL_TOOL_NAMES].sort());
+		expect(agent.piSession.getActiveToolNames()).not.toContain("bash");
+	});
+
+	it("runs read -> edit -> read on the owned page with Pi's real tools", async () => {
+		const { fixture, faux, agent } = await setup("roundtrip", false);
+		const file = join(fixture.workspace, "pages/home.html");
+		faux.faux.setResponses([
+			toolTurn(fauxToolCall("read", { path: "pages/home.html" })),
+			toolTurn(
+				fauxToolCall("edit", {
+					path: "pages/home.html",
+					edits: [
+						{ oldText: "An arts weekend in the park.", newText: "Two days of lantern-lit art in Alder Park." },
+					],
+				}),
+			),
+			toolTurn(fauxToolCall("read", { path: "pages/home.html" })),
+			fauxAssistantMessage("Updated the home page hero copy."),
+		]);
+		const outcome = await agent.runTask({
+			round: 1,
+			kind: "round",
+			prompt: "Improve the home hero.",
+			issuedAtUnix: 0,
+		});
+		expect(outcome).toBe("settled");
+		expect(readFileSync(file, "utf8")).toContain("Two days of lantern-lit art in Alder Park.");
+		const results = toolResults(agent);
+		expect(results.map((result) => result.toolName)).toEqual(["read", "edit", "read"]);
+		expect(results.every((result) => !result.isError)).toBe(true);
+		expect(textOf(results[0].content)).toContain("An arts weekend in the park.");
+		expect(textOf(results[2].content)).toContain("Two days of lantern-lit art in Alder Park.");
+		const writes = fixture.events.filter((event) => event.event === "file_write");
+		expect(writes).toHaveLength(1);
+		expect(writes[0]).toMatchObject({ agent: "home", path: "pages/home.html", tool: "edit" });
+		expect(agent.ledger.state.pendingTask).toBeNull();
+	});
+
+	it("blocks another agent's page and the brief identically for the model", async () => {
+		const { fixture, faux, agent } = await setup("blocked", false);
+		const lineup = readFileSync(join(fixture.workspace, "pages/lineup.html"), "utf8");
+		faux.faux.setResponses([
+			toolTurn(
+				fauxToolCall("write", { path: "pages/lineup.html", content: "hijacked" }),
+				fauxToolCall("edit", { path: "brief.md", edits: [{ oldText: "a", newText: "b" }] }),
+			),
+			fauxAssistantMessage("I can only change my page."),
+		]);
+		await agent.runTask({ round: 1, kind: "round", prompt: "Try to edit lineup.", issuedAtUnix: 0 });
+		expect(readFileSync(join(fixture.workspace, "pages/lineup.html"), "utf8")).toBe(lineup);
+		const results = toolResults(agent);
+		expect(results.map((result) => result.isError)).toEqual([true, true]);
+		expect(textOf(results[0].content)).toMatch(/read-only for you/);
+		expect(fixture.events.filter((event) => event.event === "guard_block")).toHaveLength(2);
+		expect(fixture.events.some((event) => event.event === "file_write")).toBe(false);
+	});
+
+	it("check_site reports the owned page's real check failures and records them durably", async () => {
+		const { faux, agent, checker } = await setup("check", true);
+		faux.faux.setResponses([toolTurn(fauxToolCall("check_site", {})), fauxAssistantMessage("Checked.")]);
+		await agent.runTask({ round: 1, kind: "round", prompt: "Check your page.", issuedAtUnix: 0 });
+		const [result] = toolResults(agent);
+		expect(result.toolName).toBe("check_site");
+		expect(textOf(result.content)).toContain("pages/home.html: 1/2 failing");
+		expect(textOf(result.content)).toContain("home/390px: primary action: requirement not met");
+		expect(textOf(result.content)).not.toContain("lineup/390px");
+		expect(checker.calls()).toBe(1);
+		expect(agent.ledger.state.checks.at(-1)).toMatchObject({ round: 1, ownedPassed: false, official: false });
+		expect(agent.ledger.state.pages["pages/home.html"].failures[0]).toContain("primary action");
+	});
+});
